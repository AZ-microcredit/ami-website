---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  description?: string;
  /** Extra class on <main> for page-specific styling */
  mainClass?: string;
}
const {
  title,
  description = 'Arizona Microcredit Initiative is a 501(c)3 nonprofit providing business education, consulting and small loans.',
  mainClass = '',
} = Astro.props;
// build.format 'file' makes Astro.url.pathname end in .html; canonical uses the clean slug.
const canonicalPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const siteBase = Astro.site ?? new URL('https://www.azmicrocredit.org');
const canonical = new URL(canonicalPath, siteBase);
const siteName = 'Arizona Microcredit Initiative';
const ogImage = new URL('/media/og-image.png', siteBase);
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: siteName,
  alternateName: 'AMI',
  url: 'https://www.azmicrocredit.org/',
  logo: new URL('/media/760f7c_d1c7d1796b1d418982570c13b1747ef3.png', siteBase).href,
  description:
    'Arizona Microcredit Initiative is a student-run 501(c)(3) nonprofit providing low-interest microloans, free business consulting, and business education to Arizona entrepreneurs.',
  email: 'info@azmicrocredit.org',
  nonprofitStatus: 'Nonprofit501c3',
  areaServed: { '@type': 'State', name: 'Arizona' },
  sameAs: [
    'https://www.linkedin.com/company/arizona-microcredit-initiative/',
    'https://www.facebook.com/azmicrocredit/',
  ],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  alternateName: 'AMI',
  url: 'https://www.azmicrocredit.org/',
  publisher: { '@type': 'NGO', name: siteName },
};
const isHome = canonicalPath === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href="/fonts/arimo-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tinos-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/media/760f7c_d1c7d1796b1d418982570c13b1747ef3.png" />
    <link rel="apple-touch-icon" href="/media/760f7c_d1c7d1796b1d418982570c13b1747ef3.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Arizona Microcredit Initiative - Take the initiative." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
    <slot name="head" />
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to main content</a>
    <Header />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
