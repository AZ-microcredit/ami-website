---
/** Older CONSULTING page (green band header + "Our competencies" box). */
import Base from '../layouts/Base.astro';
import PlusBand from '../components/PlusBand.astro';

const left = ['Advertising', 'Management accounting', 'Financial modeling', 'Loans/funding', 'Web development', 'Social media', 'Database management'];
const right = ['Lean startup model', 'Business Model Canvas', 'Product development', 'Services marketing', 'Pricing strategy', 'Sales promotion', 'Start-up Finances'];
---

<Base
  title="Arizona Microcredit Initiative | CONSULTING"
  description="AMI offers free, one-on-one business consulting for local businesses in any phase, from startup to expansion."
>
  <PlusBand title="CONSULTING" subtitle="Pinpoint business-specific problems with our expertise" titleSize={55} subtitleWidth={568} indent={55} />

  <div class="photo-strip">
    <img src="/media/760f7c_17b819b385b54a92bba66470f139572b.png" alt="" loading="eager" />
  </div>

  <section class="grey">
    <div class="inner">
      <p class="intro">AMI offers free one-on-one business consulting for local businesses in any phase, from startup to expansion. Our staff members have specialized backgrounds in a variety of subjects.</p>

      <div class="box">
        <p class="box-title">Our competencies</p>
        <div class="cols">
          <ul>{left.map((c) => <li>{c}</li>)}</ul>
          <ul>{right.map((c) => <li>{c}</li>)}</ul>
        </div>
        <a class="pill" href="/schedule-a-consultation-1" aria-label="Schedule a consultation">Schedule a consultation</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .photo-strip { height: 354px; overflow: hidden; background: #ddd; }
  .photo-strip img { width: 100%; height: 100%; object-fit: cover; object-position: center 60%; }

  .grey { background: var(--grey-bg); }
  .inner { max-width: var(--content-width); margin: 0 auto; padding: 12px 20px 150px; }
  .intro { max-width: 900px; margin: 0 auto; text-align: center; font-family: var(--font-avenir-light); font-size: 21px; line-height: 1.5; }

  .box { position: relative; width: 720px; max-width: 100%; margin: 50px auto 0; border: 2px solid #000; padding: 52px 0 62px 85px; }
  .box-title { position: absolute; left: 50%; top: -24px; transform: translateX(-50%); padding: 0 12px; background: var(--grey-bg); font-family: var(--font-avenir-heavy); font-size: 30px; line-height: 1.5; color: var(--green); white-space: nowrap; }
  .cols { display: grid; grid-template-columns: 318px 319px; column-gap: 12px; }
  .cols ul { list-style: disc; padding-left: 20px; }
  .cols li { font-family: var(--font-avenir-light); font-size: 22px; line-height: 1.5; }
  .pill { position: absolute; left: 50%; bottom: -28px; transform: translateX(-50%); display: inline-flex; align-items: center; justify-content: center; width: 338px; height: 54px; border-radius: 5px; background: var(--green); color: var(--white); font-family: var(--font-avenir-light); font-size: 24px; text-decoration: none; transition: background-color .4s ease; }
  .pill:hover { background: var(--green-dark); }

  @media (max-width: 900px) {
    .photo-strip { height: 48vw; min-height: 200px; }
    .inner { padding-bottom: 90px; }
    .intro { font-size: 18px; }
    .box { padding: 40px 20px 50px; }
    .box-title { font-size: 24px; top: -20px; }
    .cols { grid-template-columns: 1fr 1fr; column-gap: 20px; }
    .cols li { font-size: 18px; }
    .pill { width: 280px; height: 48px; font-size: 20px; }
  }
  @media (max-width: 600px) {
    .cols { grid-template-columns: 1fr; }
    .box-title { font-size: 20px; top: -16px; }
    .pill { width: 240px; font-size: 17px; }
  }
</style>
