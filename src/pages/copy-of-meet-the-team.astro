---
import Base from '../layouts/Base.astro';

// Older (Fall 2025 draft) version of the Meet the Team page. Emails shown are the visible
// text on the live page; the live mailto targets are stale so we link the shown address.
const director = { name: 'AJ Gomez', title: 'Executive Director', email: 'agustin@azmicrocredit.org', image: '/media/760f7c_d88febcb55c64e0fb9f3257ce19008a5.png' };
const board = [
  { name: 'Sam Benavidez', title: 'Director of Finance', email: 'sam@azmicrocredit.org', image: '/media/760f7c_3d882051d1364ea5a0dbea24a4f82842.jpg' },
  { name: 'Catherine Jiang', title: 'Director of Education', email: 'catherine@azmicrocredit.org', image: '/media/760f7c_bdd69baa9266477b993de1a97449fae0.jpeg' },
  { name: 'Brendan Salisbury', title: 'Director of Consulting', email: 'brendan@azmicrocredit.org', image: '/media/760f7c_bc357ab1cf9547b0aa40c6577846e489.jpg' },
  { name: 'Faizan Yousuf', title: 'Director of Operations', email: 'faizan@azmicrocredit.org', image: '/media/760f7c_3c5cbdc349474b79b9fc75da9a8abef9.png' },
];

// Staff gallery (Wix pro-gallery: 5 columns of 191x167 tiles, captions on hover)
const staff = [
  ['Siddharth Mehta', 'Senior Associate', '760f7c_1337c4cc5ca743abbe0c24d8dc2b1877.jpg'],
  ['Nivedh Mudiam', 'Senior Associate', '760f7c_02d415c298944e7e8faacc7da8973c61.jpg'],
  ['Zuhayr Shams', 'Senior Associate', '760f7c_a38600a87e3346c19e25d45f9fc23bc5.jpg'],
  ['Ruby Xia', 'Associate', '760f7c_83599111c89c445792ed94844264b8d8.png'],
  ['Taylor Oddonetto', 'Associate', '760f7c_6c40856191a042b59dfcaa40f48f39f7.png'],
  ['Dax Knoll', 'Associate', '760f7c_d148e7b1aee645b0a6c1e9177a8942d5.png'],
  ['Medha Peddireddi', 'Associate', '760f7c_6ddc743e29c844d3ad3ff236dc7ee1c2.jpg'],
  ['Brigid Bernoski', 'Associate', '760f7c_72e573429fdd43dc8479799e87dc4378.png'],
  ['Ryan Meyer', 'Associate', '760f7c_8c0cb9fd3e7f41f58f2cc649670cda9d.png'],
  ['Anya Kannan', 'Associate', '760f7c_41c2bb0d8ef4467e88e72d8128ffdfdd.png'],
  ['Hannah Hughens', 'Associate', '760f7c_e0fe6be87c384c02b967260d804cec18.jpg'],
  ['Ignacy Sajek', 'Associate', '760f7c_8f01eaac340d438cad0372f64b9a642c.jpg'],
  ['Ronak Bhatia', 'Associate', '760f7c_78980234f8914fe6b2c26b94d38cecd3.jpg'],
  ['Colin Franklin', 'Head of Records and Technology', '760f7c_f3a8a6b022224cbaa4633438dc7acc63.jpg'],
  ['Aarav Dugar', 'Head of Internal Development', '760f7c_3d99dc6b1cd34c99af4b631f0f38c651.png'],
  ['Akhil Choda', 'Head of Brand Management', '760f7c_8a529d3191c0477f934d058a147a20bb.png'],
  ['Arya Tailor', 'Associate', '760f7c_193d04134ebc4392aa02751414c062f5.png'],
  ['Simoni Thakkar', 'Associate', '760f7c_eb35eba4cf534adaa3aab17d6d8e9ccd.png'],
  ['Zachary Speck', 'Associate', '760f7c_28e40b089bb5470cbf8cda54b061efe6.png'],
];
---

<Base title="Meet the Team | az-microcredit">
  <section class="team-hero">
    <img src="/media/760f7c_c36f909f83ae47c7bd6c1a72b841010b.png" alt="IMG_8019 (1).HEIC" loading="eager" />
    <div class="team-hero-inner">
      <h1 class="hero-title">MEET THE TEAM</h1>
    </div>
  </section>
  <div class="grey-strip"></div>

  <section class="exec">
    <h2 class="spaced-title">EXECUTIVE BOARD</h2>
    <div class="person-row single">
      <div class="person">
        <img src={director.image} alt={director.name} width="200" height="200" />
        <h3>{director.name}<br /><span class="role">{director.title}</span><br /><a href={`mailto:${director.email}`}>{director.email}</a></h3>
      </div>
    </div>
    <div class="person-row four">
      {board.map((p) => (
        <div class="person">
          <img src={p.image} alt={p.name} width="200" height="200" />
          <h3>{p.name}<br /><span class="role">{p.title}</span><br /><a href={`mailto:${p.email}`}>{p.email}</a></h3>
        </div>
      ))}
    </div>
  </section>

  <section class="staff">
    <h2 class="spaced-title">STAFF</h2>
    <div class="grey-line"></div>
    <ul class="gallery">
      {staff.map(([name, role, file]) => (
        <li>
          <figure>
            <img src={`/media/${file}`} alt={name} width="191" height="167" loading="lazy" />
            <figcaption><span class="name">{name}</span><span class="role">{role}</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .team-hero { position: relative; height: 486px; overflow: hidden; background: #ccc; }
  .team-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .team-hero-inner { position: relative; max-width: var(--content-width); margin: 0 auto; height: 100%; padding: 0 20px; display: flex; align-items: flex-end; }
  .team-hero .hero-title { font-size: 80px; line-height: 1.08; padding: 0 8px 0 8px; margin-bottom: 41px; letter-spacing: -0.02em; background: #68b04d; }
  .grey-strip { height: 10px; background: var(--grey-bg); }

  .exec { max-width: var(--content-width); margin: 0 auto; padding: 24px 20px 40px; }
  .exec .spaced-title { font-size: 40px; letter-spacing: 0.5em; margin-bottom: 40px; }
  .person-row { display: grid; gap: 20px; justify-items: center; }
  .person-row.single { grid-template-columns: 1fr; }
  .person-row.four { grid-template-columns: repeat(4, 1fr); margin-top: 26px; }
  .person { text-align: center; }
  .person img { width: 200px; height: 200px; border-radius: 50%; object-fit: cover; margin: 0 auto 8px; }
  .person h3 { font-family: var(--font-bold); font-size: 21px; line-height: 1.3; }
  .person .role { font-family: var(--font-body); font-size: 18px; }
  .person h3 a { font-family: var(--font-body); font-size: 14px; color: inherit; }

  .staff { max-width: var(--content-width); margin: 0 auto; padding: 40px 0 0; }
  .staff .spaced-title { font-size: 40px; letter-spacing: 0.5em; margin-bottom: 24px; }
  .grey-line { height: 4px; background: var(--grey-bg); margin: 0 -150px 8px; }
  .gallery { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; padding-bottom: 50px; }
  .gallery figure { position: relative; margin: 0; overflow: hidden; }
  .gallery img { width: 100%; aspect-ratio: 191 / 167; object-fit: cover; object-position: center 20%; display: block; }
  .gallery figcaption { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; text-align: center; padding: 10px 8px; color: var(--white); background: linear-gradient(to top, rgba(0,0,0,.65), rgba(0,0,0,0) 60%); opacity: 0; transition: opacity .2s; }
  .gallery figure:hover figcaption, .gallery figure:focus-within figcaption { opacity: 1; }
  .gallery .name { font-family: var(--font-bold); font-size: 15px; }
  .gallery .role { font-family: var(--font-body); font-size: 13px; }

  @media (max-width: 900px) {
    .team-hero { height: 50vw; min-height: 260px; }
    .team-hero .hero-title { font-size: 44px; margin-bottom: 20px; }
    .exec .spaced-title, .staff .spaced-title { font-size: 28px; letter-spacing: 0.35em; }
    .person-row.four { grid-template-columns: repeat(2, 1fr); gap: 30px 16px; }
    .grey-line { margin: 0 0 8px; }
    .gallery { grid-template-columns: repeat(3, 1fr); }
    .staff { padding: 30px 12px 0; }
  }
  @media (max-width: 600px) {
    .team-hero .hero-title { font-size: 30px; }
    .exec .spaced-title, .staff .spaced-title { font-size: 22px; letter-spacing: 0.25em; }
    .person img { width: 160px; height: 160px; }
    .person h3 { font-size: 19px; }
    .person .role { font-size: 15px; }
    .person h3 a { font-size: 13px; word-break: break-all; }
    .gallery { grid-template-columns: repeat(2, 1fr); }
    .gallery figcaption { opacity: 1; }
  }
</style>
