---
import Base from '../layouts/Base.astro';
import EventsWidget from '../components/EventsWidget.astro';
import ResourceIndexSection from '../components/sections/ResourceIndexSection.astro';
import ScrollMotion from '../components/ScrollMotion.astro';
---
<Base title="AMI | Business education, one useful idea at a time" description="Free business education from AMI. Explore practical guides, browse resources by topic, and find workshops for Phoenix entrepreneurs.">
 <section class="education-hero">
  <div class="education-title"><p class="eyebrow">Business education / Free to explore</p><h1>There’s always<br/>something<br/><em>to learn.</em></h1><p>A business starts with an idea. It grows with what you learn along the way.</p><a href="#resources" class="line-link">Find your next useful idea <span aria-hidden="true">↓</span></a></div>
  <figure class="education-photo"><img data-parallax="0.10" src="/media/ami-pitch-speakers.webp" srcset="/media/ami-pitch-speakers-small.webp 960w, /media/ami-pitch-speakers.webp 2400w" sizes="(max-width:700px) 100vw, 55vw" width="2400" height="1800" alt="AMI speakers introducing judges to the community at the December 2025 pitch competition" fetchpriority="high"/><figcaption>Ideas shared. Confidence built.<br/><span>AMI pitch competition / December 2025</span></figcaption></figure>
 </section>
 <nav class="education-nav" aria-label="Explore business education"><a href="#start">Start with a guide <span>01</span></a><a href="#resources">Browse the library <span>02</span></a><a href="#events">Learn together <span>03</span></a></nav>
 <section class="featured-guide" id="start"><div class="guide-note"><p class="eyebrow">Start here</p><span aria-hidden="true">A<br/>to Z.</span><p>Your first idea deserves<br/>a practical next step.</p></div><div class="guide-main"><p class="eyebrow">The business startup guide</p><h2>From a blank page<br/>to a business plan.</h2><p>Work through the foundations of starting a small business, with a guide you can return to as your idea takes shape.</p><a class="line-link" href="/business-startup-guide">Open the startup guide <span aria-hidden="true">↗</span></a></div><a class="side-guide" href="/create-a-budget"><span class="eyebrow">Know your numbers</span><h3>Make room<br/>for a budget.</h3><p>Understand what comes in, what goes out, and what’s possible.</p><span class="side-arrow" aria-hidden="true">↗</span></a></section>
 <ResourceIndexSection id="resources"/>
 <section class="learning-together"><figure><img data-parallax="0.08" src="/media/ami-pitch-community.webp" width="2400" height="1800" alt="Community members listening at an AMI pitch event" loading="lazy"/></figure><div><p class="eyebrow">Bring your curiosity</p><h2>Some things<br/>are better learned<br/><em>together.</em></h2><p>Free workshops and practical resources for people building businesses in our community. Come with a question. Leave with a next step.</p><a href="#events" class="line-link">Explore workshops & events <span aria-hidden="true">↓</span></a></div></section>
 <section class="edu-events" id="events"><div><p class="eyebrow">What’s on</p><h2>Pull up a chair.</h2><p>Explore AMI’s upcoming workshops and community events.</p></div><div class="event-list"><EventsWidget/><a class="line-link" href="/events">Browse the event calendar <span aria-hidden="true">↗</span></a></div></section>
 <ScrollMotion/>
</Base>
<style>
.eyebrow{font:11px/1.7 Helvetica,Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}.education-hero{display:grid;grid-template-columns:1fr 1.15fr;padding:64px 4.2vw 80px;gap:5vw;background:#f1f1ec;align-items:center;overflow:hidden}.education-title h1{font:500 clamp(62px,6.4vw,100px)/.96 Helvetica,Arial,sans-serif;letter-spacing:-.06em;margin:42px 0 32px}.education-title em{font-family:Georgia,serif;color:#39732b;font-weight:400}.education-title>p:not(.eyebrow){font:20px/1.65 Georgia,serif;max-width:370px;color:#555}.line-link{display:inline-flex;align-items:center;justify-content:space-between;gap:35px;text-decoration:none;border-bottom:1px solid #888;padding:12px 0;font:14px/1.5 Helvetica,Arial,sans-serif}.line-link span{font-size:26px}.education-title .line-link{margin-top:28px}.education-photo{position:relative;min-width:0;height:590px;overflow:hidden;margin:0;transform:rotate(2deg)}.education-photo img{width:100%;height:100%;object-fit:cover;object-position:65% center;filter:grayscale(1)}.education-photo figcaption{position:absolute;left:0;bottom:28px;padding:24px 28px;background:var(--green);color:#111;font:21px/1.25 Helvetica,Arial,sans-serif;max-width:85%;transform:rotate(-2deg)}.education-photo figcaption span{display:block;font:10px/1.6 Helvetica,Arial,sans-serif;text-transform:uppercase;letter-spacing:.07em;margin-top:13px}.education-nav{display:flex;justify-content:space-between;padding:0 4.2vw;background:#111;color:white}.education-nav a{display:flex;justify-content:space-between;gap:30px;flex:1;padding:25px 0;margin-right:50px;font:13px/1.5 Helvetica,Arial,sans-serif;text-decoration:none}.education-nav a:last-child{margin-right:0}.education-nav span{color:var(--green)}.education-nav a:hover{color:var(--green)}.featured-guide{padding:100px 4.2vw;display:grid;grid-template-columns:.65fr 1.45fr 1fr;gap:50px;align-items:center}.guide-note{border-left:1px solid #aaa;padding-left:22px}.guide-note>span{display:block;font:500 84px/.9 Helvetica,Arial,sans-serif;letter-spacing:-.09em;margin:30px 0;color:#39732b}.guide-note>p:last-child{font:14px/1.6 Georgia,serif;color:#666}.guide-main h2{font:500 clamp(34px,3.5vw,52px)/1.05 Helvetica,Arial,sans-serif;letter-spacing:-.04em;margin:24px 0}.guide-main>p:not(.eyebrow){font:18px/1.7 Georgia,serif;color:#555}.guide-main .line-link{margin-top:24px}.side-guide{padding:38px 30px;background:var(--green);text-decoration:none;transform:rotate(-3deg);transition:transform .3s;min-height:350px;display:flex;flex-direction:column}.side-guide:hover{transform:rotate(0) translateY(-8px)}.side-guide h3{font-size:36px;line-height:1.05;margin:34px 0 22px}.side-guide p{font:16px/1.6 Georgia,serif}.side-arrow{font:40px Helvetica,Arial,sans-serif;align-self:end;margin-top:25px}.learning-together{display:grid;grid-template-columns:1.2fr 1fr;background:#111;color:white}.learning-together figure{margin:0;overflow:hidden;min-height:570px}.learning-together img{width:100%;height:100%;object-fit:cover;filter:grayscale(1)}.learning-together>div{padding:70px 10%;align-self:center}.learning-together h2{font:400 clamp(38px,4.5vw,65px)/1.05 Helvetica,Arial,sans-serif;letter-spacing:-.04em;margin:35px 0}.learning-together h2 em{font-family:Georgia,serif;color:var(--green)}.learning-together>div>p:not(.eyebrow){font:18px/1.7 Georgia,serif;color:#ccc}.learning-together .line-link{margin-top:30px}.edu-events{padding:90px 4.2vw;display:grid;grid-template-columns:1fr 1.4fr;gap:7vw}.edu-events h2{font:400 clamp(36px,4vw,60px)/1.04 Helvetica,Arial,sans-serif;margin:24px 0}.edu-events>div>p:not(.eyebrow){font:18px/1.7 Georgia,serif;color:#555;max-width:380px}.event-list{border-top:1px solid #aaa;padding-top:32px}.event-list :global(.no-events){text-align:left;font:22px Georgia,serif}.event-list>.line-link{margin-top:30px}
@media(max-width:900px){.education-hero{gap:35px}.education-photo{height:530px}.featured-guide{gap:30px;grid-template-columns:1.4fr 1fr}.guide-note{display:none}.education-nav a{margin-right:25px}.education-title h1{font-size:64px}}
@media(max-width:700px){.education-hero{grid-template-columns:1fr;padding:40px 22px 54px;gap:40px}.education-title h1{font-size:64px;margin-top:30px}.education-photo{height:380px;transform:rotate(1deg)}.education-photo figcaption{font-size:19px;padding:18px 20px}.education-nav{padding:0 22px;flex-direction:column}.education-nav a{margin:0;border-bottom:1px solid #555;padding:18px 0}.featured-guide{padding:60px 22px;grid-template-columns:1fr;gap:45px}.side-guide{margin:0 8px;min-height:300px}.learning-together{grid-template-columns:1fr}.learning-together figure{min-height:0;height:380px}.learning-together>div{padding:50px 22px}.edu-events{padding:60px 22px;grid-template-columns:1fr;gap:32px}}
</style>
