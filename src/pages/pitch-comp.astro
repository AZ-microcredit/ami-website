---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MotionBanner from '../components/MotionBanner.astro';

const workshops = [
  { n: '01', date: 'Thu, Oct 1', title: 'Business Model Canvas', url: 'https://luma.com/2eduhcdp', copy: 'Map your customer, your idea, and your money on a single page.' },
  { n: '02', date: 'Thu, Oct 8', title: 'Small Business Accounting', url: 'https://luma.com/6tpws02j', copy: 'Know the numbers a judge, or a lender, will ask you about.' },
  { n: '03', date: 'Thu, Oct 15', title: 'Pitching and Q&A', url: 'https://luma.com/4mro0z80', copy: 'Practice your pitch and get real feedback before the real thing.' },
];
---
<Base title="West Valley Pitch Competition | Arizona Microcredit Initiative" description="Bring your business to the stage. Register for free workshops and pitch for a share of $10,000 at the West Valley Pitch Competition." mainClass="pitch-page">
  <section class="hero dark">
    <div class="hero-copy reveal">
      <h1>Bring your<br/>business to the<br/><em>stage.</em></h1>
      <p class="lede">A free pitch competition for West Valley entrepreneurs, run by AMI with the economic development teams of Peoria, Goodyear, and Avondale. Learn in October, pitch on stage October 24, compete for a share of $10,000.</p>
      <div class="hero-actions">
        <a class="button green-button" href="#workshops">Sign up for a workshop <Icon name="arrow-down" /></a>
        <a class="text-link" href="#how-it-works">How it works</a>
      </div>
    </div>
    <figure class="hero-photo reveal delay">
      <img src="/media/pitch-winners-2026.jpg" alt="Entrepreneurs and community members at an AMI pitch competition" width="5712" height="4284" fetchpriority="high"/>
      <div class="prize-banner" aria-label="$10,000 in prizes on October 24">
        <strong><span data-count="10000">$10,000</span></strong>
        <span>In prizes</span>
      </div>
    </figure>
    <div class="hero-sponsors">
      <p class="eyebrow">Organized with. Supported by.</p>
      <MotionBanner label="Pitch competition sponsors and partners" variant="partners">
        <span class="logo-tile"><img src="/media/pitch-partners/peoria.webp" alt="City of Peoria Economic Development" loading="lazy"/></span>
        <span class="logo-tile"><img src="/media/pitch-partners/avondale.webp" alt="City of Avondale" loading="lazy"/></span>
        <span class="logo-tile"><img src="/media/pitch-partners/goodyear.webp" alt="City of Goodyear" loading="lazy"/></span>
        <span class="logo-tile"><img src="/media/pitch-partners/srp.webp" alt="SRP" loading="lazy"/></span>
        <span class="logo-tile"><img src="/media/pitch-partners/aps.webp" alt="APS" loading="lazy"/></span>
        <span class="logo-tile"><img src="/media/pitch-partners/integro.webp" alt="Integro Bank Foundation" loading="lazy"/></span>
        <span class="logo-tile mamacitas-logo"><img src="/media/pitch-partners/mamacitas.png" alt="MamaCitas Mommy Dates" loading="lazy"/></span>
      </MotionBanner>
    </div>
    <dl class="facts reveal">
      <div><dt>When</dt><dd>Sat, Oct 24<br/>11 a.m. to 3 p.m.</dd></div>
      <div><dt>Where</dt><dd>Rio Vista Recreation Center<br/>Peoria</dd></div>
      <div><dt>Cost</dt><dd>Free<br/>Workshops and entry</dd></div>
      <div><dt>Who</dt><dd>West Valley business owners<br/>and founders</dd></div>
    </dl>
  </section>


  <section class="steps light" id="how-it-works">
    <div class="section-head reveal"><h2>Three steps to the stage.</h2></div>
    <ol class="step-grid">
      <li class="reveal"><p class="step-meta">Step 1 · Now</p><h3>Register</h3><p>Choose your workshops below and register on Luma.</p></li>
      <li class="reveal delay"><p class="step-meta">Step 2 · Oct 1, 8, 15</p><h3>Learn</h3><p>Attend at least two of the three free virtual workshops. Thursdays, 12 to 1 p.m. That is what qualifies you.</p></li>
      <li class="reveal delay-2"><p class="step-meta">Step 3 · Oct 24</p><h3>Pitch</h3><p>Take the stage at Rio Vista in front of judges and your community, and compete for a share of $10,000.</p></li>
    </ol>
  </section>

  <section class="workshops dark" id="workshops">
    <div class="qualify reveal"><strong>2 of 3</strong><div><h2>One rule to qualify.</h2><p>You must attend at least two of these three free virtual workshops to pitch on October 24.</p></div></div>
    <div class="workshop-grid">
      {workshops.map((workshop, i) => <article class={`workshop reveal ${i ? `delay-${i}` : ''}`}>
        <div class="workshop-top"><p>Workshop {workshop.n}</p><span>Virtual</span></div>
        <h3>{workshop.date}</h3><p class="time">12 to 1 p.m.</p><h4>{workshop.title}</h4><p>{workshop.copy}</p>
        <a class="button green-button" href={workshop.url} target="_blank" rel="noopener noreferrer">Register on Luma <Icon name="arrow-up-right" /></a>
      </article>)}
    </div>
    <p class="workshop-note reveal">Sign up for all three if you can. Two is the minimum.</p>
  </section>

  <section class="pitch-day light">
    <div class="day-info reveal">
      <p class="eyebrow">Pitch day</p><h2>Saturday,<br/>October 24.</h2><p><strong>11 a.m. to 3 p.m.</strong><br/><strong>Rio Vista Recreation Center</strong><br/>Peoria, Arizona</p>
      <p class="muted">Parking details will be announced before the event.</p>
      <a class="button black-button" href="#workshop-cta">Choose your workshops <Icon name="arrow-down" /></a>
      <div class="map-card"><iframe title="Map to Rio Vista Recreation Center" src="https://www.google.com/maps?q=Rio+Vista+Recreation+Center,+8866+W+Thunderbird+Rd,+Peoria,+AZ+85381&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
    </div>
    <div class="pitch-gallery reveal delay" aria-label="Scenes from past AMI pitch competitions">
      <figure class="photo-card"><img src="/media/pitch-gallery-networking.webp" alt="Two business owners in purple shirts seated at a past AMI event" loading="lazy" width="2400" height="1800"/></figure>
      <figure class="photo-card"><img src="/media/pitch-gallery-group.webp" alt="Entrepreneurs, guests, and AMI members gathered after a past pitch competition" loading="lazy" width="2400" height="1800"/></figure>
      <figure class="photo-card"><img src="/media/pitch-gallery-third.webp" alt="Two attendees seated together at a past AMI event" loading="lazy" width="1238" height="928"/></figure>
    </div>
  </section>

  <section class="closer" id="workshop-cta">
    <div class="reveal"><h2>Pick two workshops.<br/>That’s all it takes.</h2><p>First one is Thursday, October 1.<br/>Pitch day is Saturday, October 24.</p></div>
    <div class="closer-links">
      {workshops.map(workshop => <a href={workshop.url} target="_blank" rel="noopener noreferrer"><small>{workshop.date.replace('Thu, ', '')}</small><span>{workshop.title}</span><Icon name="arrow-up-right" /></a>)}
    </div>
  </section>
  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const items = document.querySelectorAll('.reveal');
    if (reduced) items.forEach(el => el.classList.add('in'));
    else {
      const observer = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('in'); observer.unobserve(entry.target); } }), { threshold: .12 });
      items.forEach(el => observer.observe(el));
      const counter = document.querySelector<HTMLElement>('[data-count]');
      if (counter) {
        const counterObserver = new IntersectionObserver(([entry]) => { if (!entry.isIntersecting) return; const start = performance.now(); const tick = (now:number) => { const p = Math.min(1, (now-start)/1100); const eased = 1-Math.pow(1-p,3); counter.textContent = `$${Math.round(10000*eased).toLocaleString()}`; if(p<1) requestAnimationFrame(tick); }; requestAnimationFrame(tick); counterObserver.disconnect(); }, {threshold:.5});
        counterObserver.observe(counter);
      }
    }
  </script>
</Base>

<style>
:global(.pitch-page){--ink:#0b0c0b;--paper:#f3f3ef;--green:#5EB346;background:var(--paper);color:var(--ink)}
:global(.pitch-page *){box-sizing:border-box}.dark{background:var(--ink);color:#fff}.light{background:var(--paper)}.eyebrow,.step-meta,.workshop-top{font:700 11px/1.4 var(--font-heading);letter-spacing:.13em;text-transform:uppercase}.green-text{color:var(--green)}
.hero{padding:44px 4vw 0;display:grid;grid-template-columns:1fr .78fr;column-gap:5vw;row-gap:30px;overflow:hidden}.hero-copy{padding-top:0}.hero h1{font:500 clamp(52px,6vw,88px)/.88 var(--font-heading);letter-spacing:-.07em;margin:8px 0 16px}.hero h1 em{font:400 1.05em/.85 var(--font-body);color:var(--green)}.lede{max-width:690px;color:#c9c9c5;font:18px/1.55 var(--font-body)}.hero-actions{display:flex;align-items:center;gap:28px;margin:18px 0}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;padding:15px 18px;font:700 13px/1 var(--font-heading);text-decoration:none;transition:transform .25s,background .25s}.button:hover{transform:translateY(-3px)}.green-button{background:var(--green);color:#071008}.text-link{color:#fff;text-underline-offset:6px;font:700 13px var(--font-heading)}.rule{font:700 12px/1.5 var(--font-heading);display:flex;align-items:center;gap:12px}.rule span{width:4px;height:22px;background:var(--green)}.hero-photo{margin:0;position:relative;min-height:370px;overflow:hidden}.hero-photo img{width:100%;height:100%;object-fit:cover;filter:grayscale(1);transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}.hero-photo.in img{transform:scale(1.025)}.prize-banner{position:absolute;right:0;bottom:34px;width:100%;background:var(--green);color:#071008;padding:18px 24px;display:grid;grid-template-columns:auto 1fr;align-items:center;gap:18px;transform:translateX(100%);animation:prize-slide-in .85s .35s cubic-bezier(.2,.75,.2,1) forwards}.prize-banner strong{white-space:nowrap;font:700 clamp(48px,5.2vw,78px)/.8 var(--font-heading);letter-spacing:-.055em}.prize-banner>span{font:800 clamp(14px,1.4vw,20px)/1 var(--font-heading);letter-spacing:.12em;text-transform:uppercase}@keyframes prize-slide-in{to{transform:translateX(0)}}.facts{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr);margin:18px 0 0;border-top:1px solid #444}.facts div{padding:23px 22px 28px 0;border-right:1px solid #444}.facts div:not(:first-child){padding-left:22px}.facts dt{color:#888;font:700 10px var(--font-heading);letter-spacing:.13em;text-transform:uppercase;margin-bottom:12px}.facts dd{margin:0;font:15px/1.4 var(--font-body);color:#eee}
.hero-sponsors{grid-column:1/-1;margin:0 -4vw;background:#fff;color:var(--ink)}.hero-sponsors>.eyebrow{padding:10px 18px 0;margin:0}.hero-sponsors :global(.motion-banner.partners){padding:8px 0;border-top:0}.hero-sponsors :global(.partners .banner-group){gap:24px;padding-right:24px}.hero-sponsors :global(.partners :is(a,.logo-tile)){width:138px;height:49px}.hero-sponsors :global(.partners :is(a,.logo-tile) img){max-width:126px;max-height:43px}.hero-sponsors :global(.mamacitas-logo){background:#fff;padding:8px 16px}.hero-sponsors :global(.mamacitas-logo img){filter:invert(1) grayscale(1) contrast(1.5)}.steps{padding:100px 4vw 112px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:58px}.section-head h2,.qualify h2{font:600 clamp(42px,5vw,72px)/.95 var(--font-heading);letter-spacing:-.055em;margin:0}.section-head p{max-width:330px;font:16px/1.55 var(--font-body)}.step-grid{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.step-grid li{border-top:4px solid var(--ink);padding-top:19px;transition:border-color .25s}.step-grid li:hover{border-color:var(--green)}.step-meta{color:#666}.step-grid h3{font:600 34px/1 var(--font-heading);margin:16px 0}.step-grid li>p:last-child{font:16px/1.55 var(--font-body);max-width:390px;color:#444}
.workshops{padding:92px 4vw 86px}.qualify{display:grid;grid-template-columns:auto 1fr;background:var(--green);color:var(--ink);align-items:center;padding:26px 32px;gap:32px}.qualify>strong{font:700 clamp(48px,7vw,90px)/.8 var(--font-heading);letter-spacing:-.06em;border-right:2px solid var(--ink);padding-right:32px}.qualify h2{font-size:32px;margin:0 0 7px}.qualify p{font:16px/1.4 var(--font-body);margin:0}.workshop-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:30px}.workshop{border:1px solid #444;padding:26px 24px;min-height:390px;display:flex;flex-direction:column;transition:border-color .25s,transform .25s}.workshop:hover{border-color:var(--green);transform:translateY(-5px)}.workshop-top{display:flex;justify-content:space-between;color:var(--green)}.workshop-top span{color:#777}.workshop h3{font:600 35px/1 var(--font-heading);margin:23px 0 9px}.workshop .time{font-size:13px;color:#aaa;margin:0}.workshop h4{font:600 21px/1.15 var(--font-heading);margin:28px 0 10px}.workshop>p:not(.time){font:15px/1.5 var(--font-body);color:#aaa}.workshop .button{margin-top:auto}.workshop-note{font:13px var(--font-body);color:#999;margin:24px 0 0}
.pitch-day{padding:56px 4vw 64px;display:grid;grid-template-columns:.95fr .9fr;gap:6vw;align-items:start}.day-info h2{font:600 clamp(48px,5vw,70px)/.85 var(--font-heading);letter-spacing:-.065em;margin:20px 0}.day-info>p:not(.eyebrow){font:16px/1.55 var(--font-body)}.muted{color:#777}.black-button{background:var(--ink);color:#fff;margin:14px 0 20px}.map-card{height:220px;border:1px solid #d1d1cc;overflow:hidden}.map-card iframe{width:100%;height:100%;border:0;filter:grayscale(1)}.pitch-gallery{position:relative;width:100%;max-width:560px;min-height:500px;justify-self:end;isolation:isolate}.pitch-gallery::before{content:"";position:absolute;inset:18px -12px -18px 12px;border:1px solid #c6c6c0;transform:rotate(1.8deg);z-index:-1}.photo-card{position:absolute;inset:0;margin:0;overflow:hidden;background:#ddd;opacity:0;transform:translate(22px,10px) rotate(1.5deg) scale(.985);animation:photo-shuffle 15s infinite cubic-bezier(.4,0,.2,1);box-shadow:0 18px 50px rgba(11,12,11,.16)}.photo-card:nth-child(2){animation-delay:5s}.photo-card:nth-child(3){animation-delay:10s}.pitch-gallery img{width:100%;height:100%;object-fit:cover;filter:grayscale(1)}@keyframes photo-shuffle{0%{opacity:0;transform:translate(22px,10px) rotate(1.5deg) scale(.985);z-index:1}7%,28%{opacity:1;transform:translate(0,0) rotate(0) scale(1);z-index:3}35%,100%{opacity:0;transform:translate(-22px,-8px) rotate(-1.2deg) scale(.985);z-index:2}}
.closer{background:var(--green);padding:75px 4vw 72px;color:var(--ink)}.closer>div:first-child{display:flex;align-items:end;justify-content:space-between;gap:30px}.closer h2{font:600 clamp(48px,6vw,86px)/.86 var(--font-heading);letter-spacing:-.065em;margin:0}.closer p{font:14px/1.5 var(--font-body)}.closer-links{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:46px}.closer-links a{background:var(--ink);color:#fff;padding:16px 18px;text-decoration:none;display:grid;grid-template-columns:1fr auto;align-items:end;transition:transform .25s}.closer-links a:hover{transform:translateY(-4px)}.closer-links small{grid-column:1/-1;color:var(--green);font:700 10px var(--font-heading);text-transform:uppercase}.closer-links span{font:600 15px var(--font-heading);margin-top:4px}
.reveal{opacity:0;transform:translateY(28px);transition:opacity .75s ease,transform .75s cubic-bezier(.2,.7,.2,1)}.reveal.in{opacity:1;transform:none}.delay{transition-delay:.1s}.delay-1{transition-delay:.1s}.delay-2{transition-delay:.2s}@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}.hero-photo img{transition:none}.prize-banner{animation:none;transform:none}.photo-card{animation:none;opacity:0;transform:none}.photo-card:first-child{opacity:1}.button,.workshop,.closer-links a{transition:none}}
@media(max-width:800px){.hero{grid-template-columns:1fr;padding:38px 22px 0;gap:42px}.hero h1{font-size:60px}.lede{font-size:16px}.hero-photo{min-height:430px}.prize-banner{bottom:18px;padding:15px 16px;grid-template-columns:auto 1fr;gap:14px}.prize-banner strong{font-size:clamp(44px,13vw,58px)}.prize-banner>span{font-size:13px}.facts{grid-template-columns:1fr 1fr;margin-top:48px}.facts div:nth-child(2){border-right:0}.facts div:nth-child(3),.facts div:nth-child(4){border-top:1px solid #444}.steps,.workshops,.pitch-day{padding:70px 22px}.section-head{align-items:start;flex-direction:column}.step-grid,.workshop-grid,.closer-links{grid-template-columns:1fr}.step-grid{gap:42px}.qualify{grid-template-columns:1fr;padding:24px}.qualify>strong{border-right:0;border-bottom:2px solid var(--ink);padding:0 0 18px}.workshop{min-height:360px}.pitch-day{grid-template-columns:1fr;gap:44px}.hero-sponsors{grid-column:1;margin:0 -22px}.pitch-gallery{min-height:520px}.closer{padding:64px 22px}.closer>div:first-child{align-items:start;flex-direction:column}.closer h2{font-size:54px}.closer-links{gap:10px}.hero-actions{align-items:flex-start;flex-direction:column}.facts div{padding:20px 10px 22px 0}.facts div:not(:first-child){padding-left:15px}.facts dd{font-size:13px}}
@media(max-width:430px){.hero h1{font-size:52px}.hero-photo{min-height:360px}.prize-banner strong{font-size:50px}.section-head h2{font-size:44px}.qualify>strong{font-size:68px}.day-info h2{font-size:56px}.closer h2{font-size:47px}}
</style>
