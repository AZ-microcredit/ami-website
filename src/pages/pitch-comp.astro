---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { PITCH_COMP_LUMA_URL } from '../data/pitchComp';

const workshops = [
  { n: '01', date: 'Thu, Oct 1', title: 'Business Model Canvas', url: 'https://luma.com/2eduhcdp', copy: 'Map your customer, your idea, and your money on a single page.' },
  { n: '02', date: 'Thu, Oct 8', title: 'Small Business Accounting', url: 'https://luma.com/6tpws02j', copy: 'Know the numbers a judge, or a lender, will ask you about.' },
  { n: '03', date: 'Thu, Oct 15', title: 'Pitching and Q&A', url: 'https://luma.com/4mro0z80', copy: 'Practice your pitch and get real feedback before the real thing.' },
];
---
<Base title="West Valley Pitch Competition | Arizona Microcredit Initiative" description="Bring your business to the stage. Register for free workshops and pitch for a share of $10,000 at the West Valley Pitch Competition." mainClass="pitch-page">
  <section class="hero dark">
    <div class="hero-copy reveal">
      <p class="eyebrow green-text">West Valley Pitch Competition · 2026</p>
      <h1>Bring your<br/>business to the<br/><em>stage.</em></h1>
      <p class="lede">A free pitch competition for West Valley entrepreneurs, run by AMI with the economic development teams of Peoria, Goodyear, and Avondale. Learn in October, pitch on stage October 24, compete for a share of $10,000.</p>
      <div class="hero-actions">
        <a class="button green-button" href={PITCH_COMP_LUMA_URL} target="_blank" rel="noopener noreferrer">Sign up for a workshop <Icon name="arrow-up-right" /></a>
        <a class="text-link" href="#how-it-works">How it works</a>
      </div>
      <p class="rule"><span></span>One rule to qualify: attend 2 of our 3 free workshops.</p>
    </div>
    <figure class="hero-photo reveal delay">
      <img src="/media/pitch-winners-2026.jpg" alt="Entrepreneurs and community members at an AMI pitch competition" width="5712" height="4284" fetchpriority="high"/>
      <figcaption>West Valley ideas belong on stage.</figcaption>
    </figure>
    <div class="prize-billboard reveal" aria-label="$10,000 in prizes on October 24">
      <strong><span data-count="10000">$10,000</span></strong>
      <div><span>In prizes</span><p>Pitch live on October 24 for a share of the prize fund.</p></div>
    </div>
    <dl class="facts reveal">
      <div><dt>When</dt><dd>Sat, Oct 24<br/>11 a.m. to 3 p.m.</dd></div>
      <div><dt>Where</dt><dd>Rio Vista Recreation Center<br/>Peoria</dd></div>
      <div><dt>Cost</dt><dd>Free<br/>Workshops and entry</dd></div>
      <div><dt>Who</dt><dd>West Valley business owners<br/>and founders</dd></div>
    </dl>
  </section>

  <section class="steps light" id="how-it-works">
    <div class="section-head reveal"><h2>Three steps to the stage.</h2><p>The whole thing takes four Thursdays and one Saturday. Nothing extra.</p></div>
    <ol class="step-grid">
      <li class="reveal"><p class="step-meta">Step 1 · Now</p><h3>Register</h3><p>Sign up for the workshops you want on Luma. That is your entry. There is no separate application.</p></li>
      <li class="reveal delay"><p class="step-meta">Step 2 · Oct 1, 8, 15</p><h3>Learn</h3><p>Attend at least two of the three free virtual workshops. Thursdays, 12 to 1 p.m. That is what qualifies you.</p></li>
      <li class="reveal delay-2"><p class="step-meta">Step 3 · Oct 24</p><h3>Pitch</h3><p>Take the stage at Rio Vista in front of judges and your community, and compete for a share of $10,000.</p></li>
    </ol>
  </section>

  <section class="workshops dark" id="workshops">
    <div class="qualify reveal"><strong>2 of 3</strong><div><h2>One rule to qualify.</h2><p>You must attend at least two of these three free virtual workshops to pitch on October 24.</p></div></div>
    <div class="workshop-grid">
      {workshops.map((workshop, i) => <article class={`workshop reveal ${i ? `delay-${i}` : ''}`}>
        <div class="workshop-top"><p>Workshop {workshop.n}</p><span>Virtual</span></div>
        <h3>{workshop.date}</h3><p class="time">12 to 1 p.m.</p><h4>{workshop.title}</h4><p>{workshop.copy}</p>
        <a class="button green-button" href={workshop.url} target="_blank" rel="noopener noreferrer">Register on Luma <Icon name="arrow-up-right" /></a>
      </article>)}
    </div>
    <p class="workshop-note reveal">Sign up for all three if you can. Two is the minimum.</p>
  </section>

  <section class="pitch-day light">
    <div class="day-info reveal">
      <p class="eyebrow">Pitch day</p><h2>Saturday,<br/>October 24.</h2><p><strong>11 a.m. to 3 p.m.</strong><br/><strong>Rio Vista Recreation Center</strong><br/>Peoria, Arizona</p>
      <p class="muted">Parking details will be announced before the event.</p>
      <a class="button black-button" href={PITCH_COMP_LUMA_URL} target="_blank" rel="noopener noreferrer">Qualify by signing up <Icon name="arrow-up-right" /></a>
      <div class="map-card"><span>Rio Vista Recreation Center</span><small>8866 W Thunderbird Rd, Peoria, AZ</small></div>
    </div>
    <div class="schedule reveal delay">
      <h3>What the day looks like</h3>
      <ol><li><time>11:00</time><span>Check-in</span></li><li><time>11:30</time><span>Pitches begin</span></li><li><time>1:30</time><span>Networking with AMI and city economic development teams</span></li><li><time>2:30</time><span>Winners announced and prizes awarded</span></li></ol>
      <div class="judges"><p>The judges</p><strong>Names and titles to be announced.</strong></div>
    </div>
  </section>

  <section class="closer">
    <div class="reveal"><h2>Pick two workshops.<br/>That’s all it takes.</h2><p>First one is Thursday, October 1.<br/>Pitch day is Saturday, October 24.</p></div>
    <div class="closer-links">
      {workshops.map(workshop => <a href={workshop.url} target="_blank" rel="noopener noreferrer"><small>{workshop.date.replace('Thu, ', '')}</small><span>{workshop.title}</span><Icon name="arrow-up-right" /></a>)}
    </div>
  </section>
  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const items = document.querySelectorAll('.reveal');
    if (reduced) items.forEach(el => el.classList.add('in'));
    else {
      const observer = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('in'); observer.unobserve(entry.target); } }), { threshold: .12 });
      items.forEach(el => observer.observe(el));
      const counter = document.querySelector<HTMLElement>('[data-count]');
      if (counter) {
        const counterObserver = new IntersectionObserver(([entry]) => { if (!entry.isIntersecting) return; const start = performance.now(); const tick = (now:number) => { const p = Math.min(1, (now-start)/1100); const eased = 1-Math.pow(1-p,3); counter.textContent = `$${Math.round(10000*eased).toLocaleString()}`; if(p<1) requestAnimationFrame(tick); }; requestAnimationFrame(tick); counterObserver.disconnect(); }, {threshold:.5});
        counterObserver.observe(counter);
      }
    }
  </script>
</Base>

<style>
:global(.pitch-page){--ink:#0b0c0b;--paper:#f3f3ef;--green:#31c63b;background:var(--paper);color:var(--ink)}
:global(.pitch-page *){box-sizing:border-box}.dark{background:var(--ink);color:#fff}.light{background:var(--paper)}.eyebrow,.step-meta,.workshop-top{font:700 11px/1.4 var(--font-heading);letter-spacing:.13em;text-transform:uppercase}.green-text{color:var(--green)}
.hero{padding:72px 4vw 0;display:grid;grid-template-columns:1fr .78fr;gap:5vw;overflow:hidden}.hero-copy{padding-top:18px}.hero h1{font:500 clamp(58px,7.2vw,112px)/.88 var(--font-heading);letter-spacing:-.07em;margin:28px 0 30px}.hero h1 em{font:400 1.05em/.85 var(--font-body);color:var(--green)}.lede{max-width:690px;color:#c9c9c5;font:18px/1.55 var(--font-body)}.hero-actions{display:flex;align-items:center;gap:28px;margin:30px 0}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;padding:15px 18px;font:700 13px/1 var(--font-heading);text-decoration:none;transition:transform .25s,background .25s}.button:hover{transform:translateY(-3px)}.green-button{background:var(--green);color:#071008}.text-link{color:#fff;text-underline-offset:6px;font:700 13px var(--font-heading)}.rule{font:700 12px/1.5 var(--font-heading);display:flex;align-items:center;gap:12px}.rule span{width:4px;height:22px;background:var(--green)}.hero-photo{margin:0;position:relative;min-height:570px;overflow:hidden}.hero-photo img{width:100%;height:100%;object-fit:cover;filter:grayscale(1);transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}.hero-photo.in img{transform:scale(1.025)}.hero-photo figcaption{position:absolute;top:28px;left:28px;font:700 11px var(--font-heading);letter-spacing:.08em;text-transform:uppercase;color:#eee}.prize-billboard{grid-column:1/-1;background:var(--green);color:#071008;padding:clamp(28px,3.5vw,54px) clamp(22px,4vw,58px);display:grid;grid-template-columns:minmax(0,auto) minmax(210px,1fr);align-items:end;gap:clamp(30px,6vw,100px);margin-top:58px;overflow:hidden}.prize-billboard strong{white-space:nowrap;font:700 clamp(96px,18vw,280px)/.72 var(--font-heading);letter-spacing:-.085em}.prize-billboard>div{border-left:2px solid #071008;padding-left:clamp(22px,3vw,44px);padding-bottom:.25em}.prize-billboard>div span{font:800 clamp(18px,2vw,30px)/1 var(--font-heading);letter-spacing:.12em;text-transform:uppercase}.prize-billboard>div p{max-width:360px;margin:18px 0 0;font:600 clamp(15px,1.25vw,19px)/1.4 var(--font-body)}.facts{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr);margin:0;border-top:1px solid #071008}.facts div{padding:23px 22px 28px 0;border-right:1px solid #444}.facts div:not(:first-child){padding-left:22px}.facts dt{color:#888;font:700 10px var(--font-heading);letter-spacing:.13em;text-transform:uppercase;margin-bottom:12px}.facts dd{margin:0;font:15px/1.4 var(--font-body);color:#eee}
.steps{padding:100px 4vw 112px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:58px}.section-head h2,.qualify h2{font:600 clamp(42px,5vw,72px)/.95 var(--font-heading);letter-spacing:-.055em;margin:0}.section-head p{max-width:330px;font:16px/1.55 var(--font-body)}.step-grid{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.step-grid li{border-top:4px solid var(--ink);padding-top:19px}.step-grid li:last-child{border-color:var(--green)}.step-meta{color:#666}.step-grid h3{font:600 34px/1 var(--font-heading);margin:16px 0}.step-grid li>p:last-child{font:16px/1.55 var(--font-body);max-width:390px;color:#444}
.workshops{padding:92px 4vw 86px}.qualify{display:grid;grid-template-columns:auto 1fr;background:var(--green);color:var(--ink);align-items:center;padding:26px 32px;gap:32px}.qualify>strong{font:700 clamp(48px,7vw,90px)/.8 var(--font-heading);letter-spacing:-.06em;border-right:2px solid var(--ink);padding-right:32px}.qualify h2{font-size:32px;margin:0 0 7px}.qualify p{font:16px/1.4 var(--font-body);margin:0}.workshop-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:30px}.workshop{border:1px solid #444;padding:26px 24px;min-height:390px;display:flex;flex-direction:column;transition:border-color .25s,transform .25s}.workshop:hover{border-color:var(--green);transform:translateY(-5px)}.workshop-top{display:flex;justify-content:space-between;color:var(--green)}.workshop-top span{color:#777}.workshop h3{font:600 35px/1 var(--font-heading);margin:23px 0 9px}.workshop .time{font-size:13px;color:#aaa;margin:0}.workshop h4{font:600 21px/1.15 var(--font-heading);margin:28px 0 10px}.workshop>p:not(.time){font:15px/1.5 var(--font-body);color:#aaa}.workshop .button{margin-top:auto}.workshop-note{font:13px var(--font-body);color:#999;margin:24px 0 0}
.pitch-day{padding:100px 4vw;display:grid;grid-template-columns:.9fr 1.15fr;gap:9vw}.day-info h2{font:600 clamp(52px,6vw,88px)/.85 var(--font-heading);letter-spacing:-.065em;margin:30px 0}.day-info>p:not(.eyebrow){font:16px/1.55 var(--font-body)}.muted{color:#777}.black-button{background:var(--ink);color:#fff;margin:20px 0 28px}.map-card{height:210px;background:repeating-linear-gradient(35deg,#ddd,#ddd 1px,#e9e9e5 1px,#e9e9e5 16px);display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #d1d1cc;text-align:center}.map-card span{font:700 16px var(--font-heading)}.map-card small{margin-top:8px;font:13px var(--font-body)}.schedule h3{font:600 25px var(--font-heading);margin:0 0 18px}.schedule ol{list-style:none;padding:0;border-top:3px solid var(--ink);margin:0}.schedule li{display:grid;grid-template-columns:90px 1fr;gap:20px;padding:24px 0;border-bottom:1px solid #aaa}.schedule time{font:700 14px var(--font-heading)}.schedule span{font:16px/1.35 var(--font-body)}.judges{margin-top:20px;padding:24px;background:#e5e5e1}.judges p{margin:0 0 9px;font:700 11px var(--font-heading);letter-spacing:.1em;text-transform:uppercase}.judges strong{font:600 20px var(--font-heading)}
.closer{background:var(--green);padding:75px 4vw 72px;color:var(--ink)}.closer>div:first-child{display:flex;align-items:end;justify-content:space-between;gap:30px}.closer h2{font:600 clamp(48px,6vw,86px)/.86 var(--font-heading);letter-spacing:-.065em;margin:0}.closer p{font:14px/1.5 var(--font-body)}.closer-links{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:46px}.closer-links a{background:var(--ink);color:#fff;padding:16px 18px;text-decoration:none;display:grid;grid-template-columns:1fr auto;align-items:end;transition:transform .25s}.closer-links a:hover{transform:translateY(-4px)}.closer-links small{grid-column:1/-1;color:var(--green);font:700 10px var(--font-heading);text-transform:uppercase}.closer-links span{font:600 15px var(--font-heading);margin-top:4px}
.reveal{opacity:0;transform:translateY(28px);transition:opacity .75s ease,transform .75s cubic-bezier(.2,.7,.2,1)}.reveal.in{opacity:1;transform:none}.delay{transition-delay:.1s}.delay-1{transition-delay:.1s}.delay-2{transition-delay:.2s}@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}.hero-photo img{transition:none}.button,.workshop,.closer-links a{transition:none}}
@media(max-width:800px){.hero{grid-template-columns:1fr;padding:48px 22px 0;gap:42px}.hero h1{font-size:60px}.lede{font-size:16px}.hero-photo{min-height:430px}.prize-billboard{grid-template-columns:1fr;align-items:start;gap:28px;margin:0;padding:42px 22px 38px}.prize-billboard strong{font-size:clamp(96px,27vw,150px);line-height:.75}.prize-billboard>div{border-left:0;border-top:2px solid #071008;padding:22px 0 0}.prize-billboard>div p{max-width:29rem}.facts{grid-template-columns:1fr 1fr;margin-top:0}.facts div:nth-child(2){border-right:0}.facts div:nth-child(3),.facts div:nth-child(4){border-top:1px solid #444}.steps,.workshops,.pitch-day{padding:70px 22px}.section-head{align-items:start;flex-direction:column}.step-grid,.workshop-grid,.closer-links{grid-template-columns:1fr}.step-grid{gap:42px}.qualify{grid-template-columns:1fr;padding:24px}.qualify>strong{border-right:0;border-bottom:2px solid var(--ink);padding:0 0 18px}.workshop{min-height:360px}.pitch-day{grid-template-columns:1fr;gap:64px}.closer{padding:64px 22px}.closer>div:first-child{align-items:start;flex-direction:column}.closer h2{font-size:54px}.closer-links{gap:10px}.hero-actions{align-items:flex-start;flex-direction:column}.facts div{padding:20px 10px 22px 0}.facts div:not(:first-child){padding-left:15px}.facts dd{font-size:13px}}
@media(max-width:430px){.hero h1{font-size:52px}.hero-photo{min-height:360px}.prize-billboard strong{font-size:clamp(88px,26vw,112px)}.section-head h2{font-size:44px}.qualify>strong{font-size:68px}.day-info h2{font-size:56px}.closer h2{font-size:47px}}
</style>
