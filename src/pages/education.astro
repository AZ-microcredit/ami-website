---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import LearningDial from '../components/LearningDial.astro';
import ResourceIndexSection from '../components/sections/ResourceIndexSection.astro';
import ScrollMotion from '../components/ScrollMotion.astro';
---
<Base title="AMI | Business education, one useful idea at a time" description="Free business education from AMI. Explore practical guides, browse resources by topic, and find workshops for Phoenix entrepreneurs.">
 <section class="education-hero">
  <div class="education-title"><p class="eyebrow">Business education / Free to explore</p><h1>There’s always<br/>something<br/><em>to learn.</em></h1><p>A business starts with an idea. It grows with what you learn along the way.</p><a href="#resources" class="line-link">Find your next useful idea <span aria-hidden="true"><Icon name="arrow-down" /></span></a></div>
  <div class="education-photo-stack" aria-label="Current AMI competitions">
   <a class="education-photo-card" href="/pitch-comp"><img src="/media/pitch-winners-2026.jpg" width="2400" height="1800" alt="Entrepreneurs at an AMI pitch competition" fetchpriority="high"/><span>Bring your business to the stage.<small>West Valley Pitch Competition / October 24</small></span></a>
   <a class="education-photo-card" href="/logo-comp"><img src="/media/pitch-partners/integro.webp" width="1000" height="357" alt="Integro Bank Foundation current logo"/><span>Design the Foundation's New Mark.<small>Logo Competition / Entries open September 21</small></span></a>
  </div>
 </section>
 <nav class="education-nav" aria-label="Explore business education"><a href="#start">Start with a guide <span>01</span></a><a href="#resources">Browse the library <span>02</span></a><a href="#competitions">Competitions <span>03</span></a></nav>
 <section class="featured-guide" id="start"><div class="guide-note"><p class="eyebrow">Start here</p><span aria-hidden="true">A<br/>to Z.</span><p>Your first idea deserves<br/>a practical next step.</p></div><div class="guide-main"><p class="eyebrow">The business startup guide</p><h2>From a blank page<br/>to a business plan.</h2><p>Work through the foundations of starting a small business, with a guide you can return to as your idea takes shape.</p><a class="line-link" href="/business-startup-guide">Open the startup guide <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div><a class="side-guide" href="/create-a-budget"><span class="eyebrow">Know your numbers</span><h3>Make room<br/>for a budget.</h3><p>Understand what comes in, what goes out, and what’s possible.</p><span class="side-arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span></a></section>
 <LearningDial />
 <section class="competitions" id="competitions">
  <article class="competition-band pitch-preview">
   <div class="pitch-preview-copy"><p class="eyebrow">West Valley Pitch Competition</p><h2>Bring your business<br/>to the <em>stage.</em></h2><p>Learn through free workshops, then pitch live on October 24 for a share of $10,000.</p><a class="pitch-preview-link" href="/pitch-comp">See the pitch competition <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div>
   <div class="competition-visual"><div class="visual-image"><img src="/media/pitch-gallery-group.webp" alt="Entrepreneurs and community members at an AMI pitch competition" loading="lazy"/><strong>$10K</strong></div><div class="pitch-preview-facts"><p><span>When</span>Saturday, October 24<br/>11 a.m. to 3 p.m.</p><p><span>Where</span>Rio Vista Recreation Center<br/>Peoria</p></div></div>
  </article>
  <article class="competition-band logo-preview">
   <div class="pitch-preview-copy"><p class="eyebrow">Integro Bank Foundation Logo Competition</p><h2>Design the Foundation's<br/><em>New Mark.</em></h2><p>Submit one human-made logo package for a $1,500 prize.</p><a class="pitch-preview-link" href="/logo-comp">See the logo competition <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div>
   <div class="competition-visual"><div class="visual-image"><img class="logo-visual" src="/media/pitch-partners/integro.webp" alt="Integro Bank Foundation logo" loading="lazy"/><strong>$1,500</strong></div><div class="pitch-preview-facts"><p><span>Entries</span>Open September 21<br/>Close October 10</p><p><span>Winner</span>October 24<br/>At the pitch competition</p></div></div>
  </article>
 </section>
 <ResourceIndexSection id="resources"/>
 <section class="learning-together"><figure><img data-parallax="0.08" src="/media/ami-pitch-community.webp" width="2400" height="1800" alt="Community members listening at an AMI pitch event" loading="lazy"/></figure><div><p class="eyebrow">Bring your curiosity</p><h2>Some things<br/>are better learned<br/><em>together.</em></h2><p>Free workshops and practical resources for people building businesses in our community. Come with a question. Leave with a next step.</p><a href="/events" class="line-link">Explore workshops &amp; events <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></section>


 <ScrollMotion/>
</Base>
<style>
.eyebrow{font:var(--text-label)/1.7 var(--font-heading);letter-spacing:.1em;text-transform:uppercase}.education-hero{display:grid;grid-template-columns:1fr 1.15fr;padding:64px 4.2vw 80px;gap:5vw;background:#f1f1ec;align-items:center;overflow:hidden}.education-title h1{font:500 var(--text-display)/.96 var(--font-heading);letter-spacing:-.06em;margin:42px 0 32px}.education-title em{font-family:var(--font-body);color:#39732b;font-weight:400}.education-title>p:not(.eyebrow){font:var(--text-body)/1.65 var(--font-body);max-width:370px;color:#555}.line-link{display:inline-flex;align-items:center;justify-content:space-between;gap:35px;text-decoration:none;border-bottom:1px solid #888;padding:12px 0;font:var(--text-label)/1.5 var(--font-heading)}.line-link span{font-size:var(--text-heading)}.education-title .line-link{margin-top:28px}.education-photo-stack{position:relative;min-width:0;height:570px;isolation:isolate}.education-photo-stack:before{content:"";position:absolute;inset:14px -10px -14px 10px;border:1px solid #c6c6c0;transform:rotate(1.5deg)}.education-photo-card{position:absolute;inset:0;display:flex;flex-direction:column;background:var(--green);color:#111;text-decoration:none;opacity:0;transform:translate(22px,10px) rotate(1.5deg) scale(.985);animation:education-shuffle 10s infinite cubic-bezier(.4,0,.2,1);box-shadow:0 18px 50px rgba(11,12,11,.16)}.education-photo-card:nth-child(2){animation-delay:5s}.education-photo-card img{display:block;width:100%;height:480px;object-fit:cover;object-position:65% center;filter:grayscale(1);background:#fff}.education-photo-card:nth-child(2) img{object-fit:contain;padding:55px}.education-photo-card>span{padding:24px 28px;font:var(--text-body)/1.25 var(--font-heading)}.education-photo-card small{display:block;font:var(--text-label)/1.6 var(--font-heading);text-transform:uppercase;letter-spacing:.07em;margin-top:13px}@keyframes education-shuffle{0%{opacity:0;transform:translate(22px,10px) rotate(1.5deg) scale(.985);z-index:1}10%,45%{opacity:1;transform:none;z-index:3}55%,100%{opacity:0;transform:translate(-22px,-8px) rotate(-1.2deg) scale(.985);z-index:2}}.education-nav{display:flex;justify-content:space-between;padding:0 4.2vw;background:#111;color:white}.education-nav a{display:flex;justify-content:space-between;gap:30px;flex:1;padding:25px 0;margin-right:50px;font:var(--text-label)/1.5 var(--font-heading);text-decoration:none}.education-nav a:last-child{margin-right:0}.education-nav span{color:var(--green)}.education-nav a:hover{color:var(--green)}.featured-guide{padding:100px 4.2vw;display:grid;grid-template-columns:.65fr 1.45fr 1fr;gap:50px;align-items:center}.guide-note{border-left:1px solid #aaa;padding-left:22px}.guide-note>span{display:block;font:500 var(--text-display)/.9 var(--font-heading);letter-spacing:-.09em;margin:30px 0;color:#39732b}.guide-note>p:last-child{font:var(--text-label)/1.6 var(--font-body);color:#666}.guide-main h2{font:500 var(--text-heading)/1.05 var(--font-heading);letter-spacing:-.04em;margin:24px 0}.guide-main>p:not(.eyebrow){font:var(--text-body)/1.7 var(--font-body);color:#555}.guide-main .line-link{margin-top:24px}.side-guide{padding:38px 30px;background:var(--green);text-decoration:none;transform:rotate(-3deg);transition:transform .3s;min-height:350px;display:flex;flex-direction:column}.side-guide:hover{transform:rotate(0) translateY(-8px)}.side-guide h3{font-size:var(--text-heading);line-height:1.05;margin:34px 0 22px}.side-guide p{font:var(--text-body)/1.6 var(--font-body)}.side-arrow{font:var(--text-heading) var(--font-heading);align-self:end;margin-top:25px}.learning-together{display:grid;grid-template-columns:1.2fr 1fr;background:#111;color:white}.learning-together figure{margin:0;overflow:hidden;min-height:570px}.learning-together img{width:100%;height:100%;object-fit:cover;filter:grayscale(1)}.learning-together>div{padding:70px 10%;align-self:center}.learning-together h2{font:400 var(--text-display)/1.05 var(--font-heading);letter-spacing:-.04em;margin:35px 0}.learning-together h2 em{font-family:var(--font-body);color:var(--green)}.learning-together>div>p:not(.eyebrow){font:var(--text-body)/1.7 var(--font-body);color:#ccc}.learning-together .line-link{margin-top:30px}
.competitions{background:#111}.competition-band{padding:64px 4.2vw;display:grid;grid-template-columns:1.05fr 1fr;gap:7vw;align-items:center;background:#111;color:#fff}.competition-band+.competition-band{border-top:1px solid #383838}.competition-visual{min-height:340px;display:grid;grid-template-rows:250px auto;overflow:hidden}.visual-image{position:relative;overflow:hidden}.visual-image>img{width:100%;height:100%;object-fit:cover;filter:grayscale(1)}.visual-image>.logo-visual{object-fit:contain;background:#fff;padding:40px}.visual-image>strong{position:absolute;left:18px;top:18px;background:var(--green);color:#111;padding:10px 16px;font:800 clamp(48px,5.5vw,78px)/.9 var(--font-heading);letter-spacing:-.05em}.competition-band h2{font:400 clamp(42px,5.2vw,76px)/.95 var(--font-heading);letter-spacing:-.05em;margin:18px 0}.pitch-preview h2 em,.logo-preview h2 em{font-family:var(--font-body);font-weight:400;color:var(--green)}.pitch-preview-copy>p:not(.eyebrow){font:var(--text-body)/1.6 var(--font-body);color:#bbb;max-width:530px}.pitch-preview-link{display:inline-flex;align-items:center;gap:20px;margin-top:22px;padding:13px 18px;background:var(--green);color:#111;text-decoration:none;font:700 var(--text-label)/1.4 var(--font-heading);transition:transform .25s}.pitch-preview-link:hover{transform:translateY(-3px)}.pitch-preview-facts{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid #555}.pitch-preview-facts p{margin:0;padding:20px 20px 0 0;font:var(--text-label)/1.6 var(--font-body);color:#ddd}.pitch-preview-facts span{display:block;margin-bottom:8px;color:var(--green);font:700 10px/1 var(--font-heading);letter-spacing:.12em;text-transform:uppercase}
@media(max-width:900px){.education-hero{gap:35px}.education-photo-stack{height:510px}.education-photo-card img{height:420px}.featured-guide{gap:30px;grid-template-columns:1.4fr 1fr}.guide-note{display:none}.education-nav a{margin-right:25px}.education-title h1{font-size:var(--text-display)}}
@media(max-width:700px){.competition-band{padding:52px 22px;grid-template-columns:1fr;gap:36px}.competition-visual{min-height:320px}.competition-band h2{font-size:48px}.pitch-preview-facts{grid-template-columns:1fr}.pitch-preview-facts p+ p{border-top:1px solid #444;margin-top:16px;padding-top:16px}.education-hero{grid-template-columns:1fr;padding:40px 22px 54px;gap:40px}.education-title h1{font-size:var(--text-display);margin-top:30px}.education-photo-stack{height:430px}.education-photo-card img{height:340px}.education-photo-card>span{font-size:var(--text-body);padding:18px 20px}.education-nav{padding:0 22px;flex-direction:column}.education-nav a{margin:0;border-bottom:1px solid #555;padding:18px 0}.featured-guide{padding:60px 22px;grid-template-columns:1fr;gap:45px}.side-guide{margin:0 8px;min-height:300px}.learning-together{grid-template-columns:1fr}.learning-together figure{min-height:0;height:380px}.learning-together>div{padding:50px 22px}}
@media(prefers-reduced-motion:reduce){.education-photo-card{animation:none;opacity:0;transform:none}.education-photo-card:first-child{opacity:1}}
</style>
