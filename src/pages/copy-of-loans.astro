---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import FundingBlueprint from '../components/FundingBlueprint.astro';
import ScheduleEmbed from '../components/ScheduleEmbed.astro';
import FaqSection from '../components/sections/FaqSection.astro';
const steps = [
 {title:'Start with a conversation.',text:'Tell us what you’re building and what’s next. We’ll get to know your business, your goals, and how a microloan could help.',tag:'Your ambition comes first',link:'Book your first call',href:'#schedule'},
 {title:'Put your plan on paper.',text:'Equipment. Inventory. Your next revenue-generating investment. Bring a clear plan for the funds, along with the documents that tell your business’s story.',tag:'Make the next step tangible',link:'See the document checklist',href:'#documents'},
 {title:'A person. Not just a score.',text:'Our holistic review considers your capacity, capital, collateral, conditions, and character. We look at the whole picture behind your business.',tag:'People before paperwork'},
 {title:'Build your next chapter.',text:'Once approved, receive your funding and begin repayment on the agreed plan. Put that investment to work for your business.',tag:'Small beginnings. Real possibility'},
];
const groups=[
 {title:'Your financial picture',items:['Personal tax returns · past 2 years','Personal bank statements · past 12 months','Business bank statements · past 12 months','Most recent utility bill']},
 {title:'Your business & plan',items:['EIN and Tax ID','Budget for a revenue-generating investment','Business vision / plan','Personal resume']},
 {title:'Your supporting details',items:['Professional references','Collateral or co-signer']},
];
---
<Base title="AMI | Microloans for your next chapter" description="Low-interest microloans for Phoenix small businesses. Explore the process, prepare your documents, and book a loan interest meeting with AMI.">
 <section class="loan-hero">
  <div class="hero-copy"><p class="eyebrow">Microloans / Built around your potential</p><h1>A little capital.<br/><span>A big next step.</span></h1><p class="intro">For the equipment you need. The inventory you’re ready for. The business you believe in.</p><a class="loan-button" href="#schedule">Let’s talk about your business <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div>
  <div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="big-arrow"><Icon name="arrow-up-right" /></span><span class="art-caption">SMALL BEGINNINGS.<br/>FORWARD MOMENTUM.</span></div>
 </section>
 <section class="loan-facts" aria-label="Published microloan terms"><div><span class="fact-label">Room to begin</span><strong>$500 <small>to</small> $7,500</strong><p>For your business needs</p></div><div><span class="fact-label">Time to build</span><strong>6 <small>to</small> 24 <small>months</small></strong><p>Repayment terms</p></div><div><span class="fact-label">Accessible capital</span><strong>1% <small>fixed</small></strong><p>Published interest rate</p></div><p class="terms-note">Discuss current terms and eligibility with our team on your initial call.</p></section>
 <FundingBlueprint />
 <section class="journey" id="how-it-works">
  <div class="journey-sticky"><p class="eyebrow">From “what if” to what’s next</p><h2>Your next move.<br/><span>Four steps forward.</span></h2><p>A lower credit barrier. A team that listens. A process built around small business.</p><div class="step-track" aria-hidden="true">{steps.map((_,i)=><span data-step-dot={i}>{String(i+1).padStart(2,'0')}</span>)}</div><a href="#schedule" class="underlined">Take the first step <Icon name="arrow-up-right" /></a></div>
  <div class="journey-steps">{steps.map((s,i)=><article class="journey-step" data-step={i}><span class="step-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><p class="eyebrow">{s.tag}</p><h3>{s.title}</h3><p class="step-copy">{s.text}</p>{s.link&&<a class="underlined" href={s.href}>{s.link} <Icon name="arrow-up-right" /></a>}</div></article>)}</div>
 </section>
 <section class="loan-photo"><img src="/media/ami-pitch-community.webp" alt="Community members at AMI’s December 2025 pitch competition" loading="lazy"/><div><p class="eyebrow">Local people. Real possibility.</p><h2>You bring the vision.<br/>We’ll help with<br/><span>the next move.</span></h2><p>Supporting entrepreneurs in the Phoenix area.</p></div></section>
 <section class="documents" id="documents"><div class="docs-heading"><div><p class="eyebrow">A head start on your application</p><h2>A little preparation.<br/>A clearer path.</h2></div><p>You don’t need to figure it all out alone. Start gathering these documents, and we’ll walk through what’s needed on your call.</p></div><div class="doc-grid">{groups.map((g,i)=><article><span class="doc-index">0{i+1} / Get ready</span><h3>{g.title}</h3><ul>{g.items.map(item=><li><span aria-hidden="true"><Icon name="arrow-up-right" /></span>{item}</li>)}</ul></article>)}</div></section>
 <FaqSection id="faq"/>
 <section class="loan-closing"><p class="eyebrow">Your ambition belongs here</p><h2>Ready when<br/><span>you are.</span></h2><a class="loan-button" href="#schedule">Book a loan interest meeting <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></section>
 <ScheduleEmbed id="schedule" sub="Let’s talk about your business’s next chapter." url="https://calendly.com/azmicrocredit/loans"/>
</Base>
<style>
.eyebrow{font:11px/1.6 'AMI Sans',sans-serif;text-transform:uppercase;letter-spacing:.12em}.loan-hero{display:grid;grid-template-columns:1.25fr 1fr;background:#111;color:white;overflow:hidden}.hero-copy{padding:clamp(48px,6vw,100px) 4.2vw;position:relative;z-index:1}.hero-copy h1{font:700 clamp(50px,6.3vw,100px)/.99 'AMI Sans',sans-serif;letter-spacing:-.065em;margin:52px 0 30px}.hero-copy h1 span{color:var(--green)}.intro{font:20px/1.65 'AMI Serif',serif;color:#ccc;max-width:420px}.loan-button{display:inline-flex;align-items:center;justify-content:space-between;gap:36px;background:var(--green);color:#111;padding:20px 24px;font:14px/1.4 'AMI Sans',sans-serif;text-decoration:none;margin-top:36px;transition:background .2s}.loan-button:hover{background:#7bc867}.loan-button span{font-size:26px}.scroll-cue{display:flex;align-items:center;gap:24px;width:fit-content;font:12px/1.6 'AMI Sans',sans-serif;text-decoration:none;color:#bbb;margin-top:48px}.scroll-cue span{font-size:23px}.hero-art{position:relative;background:var(--green);overflow:hidden;min-height:600px}.orbit{position:absolute;width:100%;aspect-ratio:1;border:1px solid #1115;border-radius:50%;left:15%;top:6%}.orbit-two{left:-30%;top:37%}.orbit-three{left:42%;top:61%}.big-arrow{position:absolute;inset:0;display:grid;place-items:center;font:400 clamp(220px,36vw,560px)/1 'AMI Sans',sans-serif;color:#111;transform:translateY(-5%)}.art-caption{position:absolute;bottom:40px;left:36px;font:11px/1.6 'AMI Sans',sans-serif;letter-spacing:.13em;color:#111}.loan-facts{padding:54px 4.2vw 32px;display:grid;grid-template-columns:repeat(3,1fr);gap:28px;border-bottom:1px solid #ccc}.loan-facts>div{padding:0 24px;border-left:1px solid #ccc}.loan-facts>div:first-child{padding-left:0;border:0}.fact-label{font:11px/1.6 'AMI Sans',sans-serif;letter-spacing:.09em;text-transform:uppercase}.loan-facts strong{display:block;font:500 clamp(30px,3.6vw,58px)/1.2 'AMI Sans',sans-serif;letter-spacing:-.055em;margin:18px 0 10px}.loan-facts strong small{font-size:.42em;letter-spacing:-.02em}.loan-facts p{color:#555;font-size:16px}.loan-facts .terms-note{grid-column:1/-1;font:12px/1.6 'AMI Sans',sans-serif;color:#666;margin-top:10px}.journey{padding:100px 4.2vw;display:grid;grid-template-columns:1fr 1fr;gap:8vw;align-items:start}.journey-sticky{position:sticky;top:calc(var(--header-height) + 50px)}h2{font:500 clamp(38px,4.3vw,68px)/1.04 'AMI Sans',sans-serif;letter-spacing:-.055em}.journey h2{margin:30px 0}.journey h2 span{color:#777}.journey-sticky>p:not(.eyebrow){font:18px/1.65 'AMI Serif',serif;color:#555;max-width:370px}.step-track{display:flex;max-width:360px;margin:42px 0 32px;border-top:1px solid #bbb}.step-track span{flex:1;padding-top:16px;font:14px 'AMI Sans',sans-serif;color:#777;border-top:3px solid transparent;margin-top:-2px;transition:color .3s,border-color .3s}.step-track span.active{color:#39732b;border-color:var(--green)}.underlined{display:inline-block;font:14px/1.6 'AMI Sans',sans-serif;padding-bottom:7px;border-bottom:1px solid #888;text-decoration:none}.journey-step{min-height:460px;padding:38px 0 70px;border-top:1px solid #bbb;display:flex;flex-direction:column;gap:42px;justify-content:space-between}.step-number{font:500 100px/.85 'AMI Sans',sans-serif;color:var(--green);letter-spacing:-.075em;transition:transform .6s}.journey-step.active .step-number{transform:translateX(12px)}.journey-step h3{font-size:clamp(30px,3vw,44px);line-height:1.07;letter-spacing:-.045em;margin:18px 0}.step-copy{font:18px/1.7 'AMI Serif',serif;color:#555;max-width:450px}.journey-step .underlined{margin-top:25px}.loan-photo{display:grid;grid-template-columns:1fr 1fr;background:#111;color:white}.loan-photo img{width:100%;height:650px;object-fit:cover;object-position:center 42%;filter:grayscale(1)}.loan-photo>div{padding:70px 8%;display:flex;flex-direction:column;justify-content:center}.loan-photo h2{margin:50px 0 32px}.loan-photo h2 span{color:var(--green)}.loan-photo>div>p:last-child{font:17px/1.7 'AMI Serif',serif;color:#ccc}.documents{padding:110px 4.2vw}.docs-heading{display:flex;justify-content:space-between;gap:60px;align-items:end;margin-bottom:56px}.docs-heading h2{margin-top:25px}.docs-heading>p{font:18px/1.7 'AMI Serif',serif;max-width:370px;color:#555}.doc-grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid #bbb}.doc-grid article{padding:32px;border-right:1px solid #bbb}.doc-grid article:last-child{border:0}.doc-index{font:11px/1.5 'AMI Sans',sans-serif;color:#666;text-transform:uppercase;letter-spacing:.08em}.doc-grid h3{font-size:28px;line-height:1.15;margin:32px 0}.doc-grid li{display:flex;gap:14px;align-items:baseline;padding:17px 0;border-top:1px solid #ddd;font:16px/1.6 'AMI Serif',serif}.doc-grid li span{color:#39732b}.loan-closing{background:var(--green);padding:64px 4.2vw;display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:28px}.loan-closing>.eyebrow{grid-column:1/-1}.loan-closing h2{font-size:clamp(60px,8vw,120px);font-weight:700;line-height:.94}.loan-closing h2 span{color:white}.loan-closing .loan-button{background:#111;color:white;justify-self:end;margin:0}.loan-closing .loan-button:hover{background:#333}
@media(max-width:900px){.hero-copy{padding:52px 25px}.hero-art{min-height:540px}.hero-copy h1{font-size:clamp(46px,6.7vw,66px)}.intro{font-size:18px}.loan-facts strong{font-size:34px}.journey{gap:40px}.journey-step{min-height:420px}.doc-grid article{padding:24px}.docs-heading{align-items:start;gap:30px}.docs-heading>p{max-width:300px}.loan-photo img{height:560px}}
@media(max-width:650px){.loan-hero{grid-template-columns:1fr}.hero-copy{padding:40px 22px 44px}.hero-copy h1{font-size:clamp(48px,12vw,74px);margin-top:36px}.hero-art{min-height:270px}.big-arrow{font-size:300px}.orbit{width:70%;top:-50%}.orbit-two{top:10%}.orbit-three{top:50%}.art-caption{left:22px;bottom:24px}.loan-button{padding:18px 20px;gap:20px}.loan-facts{grid-template-columns:1fr;padding:38px 22px;gap:26px}.loan-facts>div{border-left:0;border-bottom:1px solid #ddd;padding:0 0 26px}.loan-facts strong{font-size:43px;margin:10px 0}.journey{padding:64px 22px;grid-template-columns:1fr;gap:48px}.journey-sticky{position:static}.step-track{display:none}.journey-sticky>.underlined{margin-top:28px}.journey-step{min-height:0;gap:30px;padding:32px 0 45px 18px;position:relative}.journey-step:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--green);transform:scaleY(var(--fill,0));transform-origin:top}.step-number{font-size:74px}.journey-step .step-number{transform:translateX(calc(var(--fill,0)*var(--step-shift,12px)));transition:none}.loan-photo{grid-template-columns:1fr}.loan-photo img{height:430px}.loan-photo>div{padding:50px 22px}.loan-photo h2{margin:30px 0}.documents{padding:64px 22px}.docs-heading{flex-direction:column;margin-bottom:36px}.docs-heading>p{max-width:none}.doc-grid{grid-template-columns:1fr}.doc-grid article{padding:28px;border-right:0;border-bottom:1px solid #bbb}.doc-grid h3{margin:24px 0}.loan-closing{padding:50px 22px;grid-template-columns:1fr}.loan-closing .loan-button{justify-self:start}.loan-closing h2{font-size:76px}}
@media(prefers-reduced-motion:reduce){.journey-sticky{position:static}.journey-step.active .step-number{transform:none}}
</style>
<script>
 import { createScrollScene, clamp01 } from '../scripts/motion/engine';
 const journey = document.querySelector<HTMLElement>('.journey');
 const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
 const dots = [...document.querySelectorAll<HTMLElement>('[data-step-dot]')];
 if (journey && steps.length) {
  createScrollScene({
   root: journey,
   margin: 300,
   measure: () => {
    // Step-number travel scales with the inline space that is actually there.
    const shift = Math.min(12, Math.max(6, window.innerWidth * 0.03));
    journey.style.setProperty('--step-shift', `${shift.toFixed(1)}px`);
   },
   render: (f) => {
    const center = f.vh * .5;
    let active = steps[0];
    let best = Infinity;
    steps.forEach(step => {
     const rect = step.getBoundingClientRect();
     const d = Math.abs(rect.top + rect.height / 2 - center);
     if (d < best) { best = d; active = step; }
     // Per-step fill: the rail and number travel follow local progress.
     const fill = f.reduced ? 0 : clamp01((f.vh * .75 - rect.top) / Math.max(1, rect.height * .85));
     step.style.setProperty('--fill', String(fill));
    });
    steps.forEach(step => step.classList.toggle('active', step === active));
    dots.forEach(dot => dot.classList.toggle('active', dot.dataset.stepDot === active.dataset.step));
   },
  });
 }
</script>
