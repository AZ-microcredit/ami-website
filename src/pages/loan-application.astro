---
/** "Loan Application" Wix page: the only content is a Typeform embed (954×594). */
import Base from '../layouts/Base.astro';
---

<Base title="Loan Application | az-microcredit">
  <section class="application">
    <iframe
      src="https://form.typeform.com/to/buozA44f"
      title="AMI Loan Application"
      loading="eager"
      allow="camera; microphone; autoplay; encrypted-media; fullscreen"
    ></iframe>
  </section>
</Base>

<style>
  .application {
    min-height: 860px;
    display: flex;
    justify-content: center;
    padding: 112px 20px 32px;
    background: #fff;
  }

  iframe {
    width: 954px;
    max-width: 100%;
    height: 680px;
    border: 0;
  }

  @media (max-width: 900px) {
    .application { min-height: 760px; padding: 92px 0 0; }
    iframe { width: 100%; height: 700px; }
  }
</style>
