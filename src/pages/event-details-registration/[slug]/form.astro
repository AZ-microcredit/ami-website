---
import Base from '../../../layouts/Base.astro';
import { events } from '../../../data/events.js';

// Mirrors the live /event-details-registration/<slug>/form URLs (Wix Events RSVP / ticket form).
export function getStaticPaths() {
  return events.filter((e) => !e.slug.endsWith('__form')).map((e) => ({ params: { slug: e.slug }, props: { event: e } }));
}
const { event: e } = Astro.props;
const backHref = `/event-details-registration/${e.slug}`;
---

<Base title={`RSVP: ${e.title} | Arizona Microcredit Initiative`} description={`Register for ${e.title}.`}>
  <section class="rsvp">
    <a class="back" href={backHref}>&larr; {e.title}</a>
    <h1>{e.title}</h1>
    <p class="meta"><span>{e.shortDate}</span><span class="sep">|</span><span>{e.shortLocation}</span></p>

    <!-- INTEGRATION: Wix Events RSVP / ticket checkout form. Static placeholder — wire action to the registration backend. -->
    {e.registrationClosed ? (
      <p class="closed">Registration is closed. <a href="/events">See other events</a></p>
    ) : (
      <form class="rsvp-form" action="#" method="post">
        <h2>Add your details</h2>
        <div class="row">
          <label>First name<input type="text" name="firstName" autocomplete="given-name" required /></label>
          <label>Last name<input type="text" name="lastName" autocomplete="family-name" required /></label>
        </div>
        <label>Email<input type="email" name="email" autocomplete="email" required /></label>
        <button type="submit" class="submit">RSVP</button>
      </form>
    )}
  </section>
</Base>

<style>
  .rsvp { max-width: 843px; margin: 0 auto; padding: 50px 20px 70px; }
  .back { display: inline-block; font-family: var(--font-body); font-size: 14px; color: #555; text-decoration: none; margin-bottom: 24px; }
  .back:hover { color: var(--green-dark); }
  .rsvp h1 { font-family: var(--font-bold); font-size: 44px; line-height: 1.1; }
  .meta { font-family: var(--font-body); font-size: 16px; margin: 10px 0 40px; }
  .meta .sep { margin: 0 10px; }
  .closed { font-family: var(--font-body); font-size: 16px; }
  .rsvp-form { background: #fcf7e6; padding: 36px 40px 40px; }
  .rsvp-form h2 { font-family: var(--font-bold); font-size: 24px; margin-bottom: 20px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  label { display: block; font-family: var(--font-body); font-size: 14px; margin-bottom: 18px; }
  input { display: block; width: 100%; margin-top: 6px; padding: 12px 14px; font: inherit; font-size: 16px; border: 1px solid #333; background: #fff; }
  input:focus { outline: 2px solid #ddb40d; outline-offset: 1px; }
  .submit { display: block; margin-left: auto; background: #ddb40d; color: #fff; border: 0; font-family: var(--font-body); font-size: 16px; padding: 14px 60px; cursor: pointer; }
  .submit:hover { background: #c9a30a; }
  @media (max-width: 600px) { .row { grid-template-columns: 1fr; gap: 0; } .rsvp h1 { font-size: 30px; } .rsvp-form { padding: 24px 20px; } }
</style>
