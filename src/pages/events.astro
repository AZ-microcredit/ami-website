---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { events } from '../data/events.js';

// Upcoming = undated (TBD) or starting today or later.
const today = new Date(); today.setHours(0, 0, 0, 0);
const upcoming = events
  .filter((e) => !e.slug.endsWith('__form') && (!e.start || new Date(e.end ?? e.start) >= today))
  .sort((a, b) => (a.start ? new Date(a.start).getTime() : Infinity) - (b.start ? new Date(b.start).getTime() : Infinity));

const detail = (slug: string) => `/event-details-registration/${slug}`;

// Data for the calendar widget: one entry per dated event (date = local ISO date of the start).
const calEvents = events
  .filter((e) => e.start)
  .map((e) => ({ slug: e.slug, title: e.title, date: e.start.slice(0, 10), href: detail(e.slug) }));
---

<Base title="Arizona Microcredit Initiative | EVENTS" description="Upcoming AMI workshops, office hours and community events for Arizona small business owners.">
  <Hero image="/media/760f7c_af9e271c1cad4857967a0b1c6a22d87a.jpg" height={390} align="left" blur class="ev-hero">
    <span class="plus" aria-hidden="true">+</span>
    <h1 class="hero-title ev-title">Upcoming Events</h1>
  </Hero>

  <section class="featured wide">
    {upcoming.map((e) => (
      <article class="feature" style={`--img:url('${e.image}')`}>
        <div class="feature-inner">
          <h2><a href={detail(e.slug)}>{e.title}</a></h2>
          <p class="meta"><span>{e.shortDate}</span><span class="sep">|</span><span>{e.shortLocation}</span></p>
          <a class="btn btn-green tickets" href={e.registrationUrl ?? detail(e.slug)}>{e.registrationUrl ? 'Register' : 'Buy Tickets'}</a>
        </div>
      </article>
    ))}
    {upcoming.length === 0 && <p class="no-events">No upcoming events at the moment</p>}
  </section>

  <section class="calendar wide">
    <h2 class="cal-heading">Event Calendar</h2>
    <div class="cal" id="event-calendar">
      <div class="cal-bar">
        <div class="cal-nav">
          <button type="button" class="cal-arrow" id="cal-prev" aria-label="Previous month">&#8249;</button>
          <button type="button" class="cal-month" id="cal-month" aria-live="polite">Month</button>
          <button type="button" class="cal-arrow" id="cal-next" aria-label="Next month">&#8250;</button>
        </div>
        <button type="button" class="cal-today" id="cal-today">Today</button>
      </div>
      <div class="cal-head" aria-hidden="true">
        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
      </div>
      <div class="cal-grid" id="cal-grid" role="grid"></div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ calEvents }}>
  (function () {
    const grid = document.getElementById('cal-grid');
    const label = document.getElementById('cal-month');
    const byDate = {};
    calEvents.forEach((e) => { (byDate[e.date] = byDate[e.date] || []).push(e); });

    const pad = (n) => String(n).padStart(2, '0');
    const key = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const now = new Date();
    const todayKey = key(now);
    let view = new Date(now.getFullYear(), now.getMonth(), 1);

    function render() {
      const y = view.getFullYear(), m = view.getMonth();
      label.textContent = view.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
      const first = new Date(y, m, 1);
      const offset = (first.getDay() + 6) % 7; // Monday-first
      const start = new Date(y, m, 1 - offset);
      grid.innerHTML = '';
      for (let i = 0; i < 42; i++) {
        const d = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i);
        const k = key(d);
        const cell = document.createElement('div');
        cell.className = 'cal-cell';
        cell.setAttribute('role', 'gridcell');
        if (d.getMonth() !== m) cell.classList.add('other');
        if (d.getDay() === 0 || d.getDay() === 6) cell.classList.add('weekend');
        if (k === todayKey) cell.classList.add('today');
        const num = document.createElement('span');
        num.className = 'num';
        num.textContent = d.getDate();
        cell.appendChild(num);
        (byDate[k] || []).forEach((e) => {
          const a = document.createElement('a');
          a.className = 'cal-event';
          a.href = e.href;
          a.textContent = e.title;
          a.title = e.title;
          cell.classList.add('has-event');
          cell.appendChild(a);
        });
        grid.appendChild(cell);
      }
    }
    document.getElementById('cal-prev').addEventListener('click', () => { view = new Date(view.getFullYear(), view.getMonth() - 1, 1); render(); });
    document.getElementById('cal-next').addEventListener('click', () => { view = new Date(view.getFullYear(), view.getMonth() + 1, 1); render(); });
    document.getElementById('cal-today').addEventListener('click', () => { view = new Date(now.getFullYear(), now.getMonth(), 1); render(); });
    render();
  })();
</script>

<style>
  :global(.ev-hero .hero-content) { padding-bottom: 42px; gap: 0; }
  :global(.hero.ev-hero) { min-height: 0; }
  :global(.hero.blur.ev-hero .hero-bg) { filter: blur(12px); transform: scale(1.1); }
  .plus { color: #fff; font-family: var(--font-bold); font-size: 78px; line-height: 0.6; margin: 0 0 -6px 0; }
  :global(.ev-hero .ev-title) { font-size: 60px; line-height: 1.1; padding: 0 12px 4px; text-transform: none; margin-left: 50px; }

  /* Featured upcoming event banners (Wix Events "single event" widget) */
  .featured { padding: 44px 65px 0; display: flex; flex-direction: column; gap: 30px; }
  .feature { position: relative; min-height: 235px; overflow: hidden; background: #474646 var(--img) center/cover; color: #fff; text-align: center; }
  .feature::before { content: ''; position: absolute; inset: -20px; background: var(--img) center/cover; filter: blur(14px) brightness(.55); }
  .feature-inner { position: relative; padding: 40px 20px 34px; display: flex; flex-direction: column; align-items: center; }
  .feature h2 { font-family: var(--font-body); font-size: 26px; line-height: 1.3; }
  .feature h2 a { text-decoration: none; }
  .feature .meta { font-family: var(--font-body); font-size: 16px; margin-top: 8px; }
  .feature .sep { margin: 0 10px; }
  .feature .tickets { margin-top: 44px; font-family: var(--font-avenir-light); text-transform: none; font-size: 16px; letter-spacing: 0; padding: 10px 34px; min-width: 160px; }
  .no-events { font-family: var(--font-bold); font-size: 17px; text-align: center; padding: 20px; }

  /* Calendar */
  .calendar { padding: 60px 80px 40px; }
  .cal-heading { font-family: var(--font-bold); font-size: 48px; color: var(--green); text-align: center; line-height: 1.2; margin-bottom: 10px; }
  .cal-bar { display: flex; justify-content: space-between; align-items: center; padding: 8px 0 26px; }
  .cal-nav { display: flex; align-items: center; gap: 4px; }
  .cal-month { background: none; border: 0; padding: 0 6px; font-family: var(--font-body); font-size: 16px; cursor: default; }
  .cal-arrow { background: none; border: 0; font-size: 22px; line-height: 1; padding: 0 6px; cursor: pointer; color: #333; }
  .cal-arrow:hover { color: var(--green-dark); }
  .cal-today { background: #fff; border: 1px solid #ddb40d; color: #ddb40d; font-family: var(--font-body); font-size: 14px; padding: 6px 20px; cursor: pointer; }
  .cal-today:hover { background: #fcf7e6; }
  .cal-head { display: grid; grid-template-columns: repeat(7, 1fr); font-family: var(--font-body); font-size: 14px; padding-bottom: 12px; }
  .cal-head span { padding-left: 0; }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); border-top: 1px solid #e6e6e6; border-left: 1px solid #e6e6e6; }
  :global(.cal-cell) { min-height: 137px; border-right: 1px solid #e6e6e6; border-bottom: 1px solid #e6e6e6; padding: 14px 0 8px 20px; font-family: var(--font-body); font-size: 22px; background: #fff; display: flex; flex-direction: column; gap: 6px; }
  :global(.cal-cell.weekend) { background: #f5f5f5; }
  :global(.cal-cell.other .num) { color: #b3b3b3; }
  :global(.cal-cell.today) { background: #f8f0cf; }
  :global(.cal-event) { display: block; font-size: 12px; line-height: 1.25; background: var(--green); color: #fff; text-decoration: none; padding: 4px 6px; margin-right: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.cal-event:hover) { background: var(--green-dark); }

  @media (max-width: 900px) {
    :global(.ev-hero .ev-title) { font-size: 40px; margin-left: 30px; }
    .plus { font-size: 56px; }
    .featured { padding: 30px 20px 0; }
    .calendar { padding: 40px 20px 30px; }
    .cal-heading { font-size: 34px; }
    :global(.cal-cell) { min-height: 80px; padding: 8px 0 6px 8px; font-size: 16px; }
    :global(.cal-event) { font-size: 10px; padding: 2px 4px; margin-right: 4px; }
  }
  @media (max-width: 600px) {
    :global(.ev-hero .ev-title) { font-size: 30px; margin-left: 20px; }
    .feature h2 { font-size: 20px; }
    :global(.cal-cell) { min-height: 56px; font-size: 13px; padding: 4px 0 4px 5px; }
    :global(.cal-event) { display: block; height: 6px; padding: 0; text-indent: -999px; overflow: hidden; }
    .cal-head { font-size: 12px; }
  }
</style>
