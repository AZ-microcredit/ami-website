---
/** Unused draft of the Market Fund page (Wix title "Market Fund unused"). */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
---

<Base
  title="Market Fund unused | az-microcredit"
  description="Interested In Funding Your Small Business, But Not Sure How To Get Started? Here At AMI, We Want To Make The Loan Application Process As Simple As Possible. Read All Our Our Most-Asked Microloan FAQ's Here!"
>
  <Hero image="/media/760f7c_f4418312102c4f48b3a6ef9116dbbabc.jpg" height={281} align="left" blur class="mfu-hero">
    <div class="title-wrap">
      <svg class="plus" viewBox="0 0 252.492 252.492" aria-hidden="true" role="presentation">
        <path vector-effect="non-scaling-stroke" d="M252.492 117.246H135.246V0h-18v117.246H0v18h117.246v117.246h18V135.246h117.246v-18z" />
      </svg>
      <h1 class="hero-title">MARKET FUND</h1>
    </div>
  </Hero>

  <section class="about">
    <div class="inner">
      <p class="heading">What is the AMI Market Fund?</p>
      <p class="text">The Market Fund is a microgrant* of up to $400 designed to support business owners participating in local markets for the first time, helping them grow their sales and expand their customer base.</p>
      <p class="note">*microgrant: financial aid that does not have to be paid back; for first-time market-goers only.</p>
      <p class="heading interested">Interested in the Market Fund?</p>
      <!-- The live draft has only empty paragraphs below this heading (no scheduling widget was placed). -->
    </div>
  </section>

  <section class="still">
    <hr />
    <h2 class="still-title">STILL HAVE QUESTIONS?</h2>
    <h2 class="still-text">
      Reach out to us directly at:&nbsp;<a class="mail" href="mailto:info@azmicrocredit.org">info@azmicrocredit.org</a><br />
      or schedule an initial loan call!
    </h2>
  </section>
</Base>

<style>
  :global(.mfu-hero) { background: #cfd3d6; }
  :global(.mfu-hero .hero-content) { padding-bottom: 96px; padding-left: 42px; }
  :global(.mfu-hero .hero-content .hero-title) { font-size: 80px; line-height: 1.18; padding: 0 8px 0 4px; }
  .title-wrap { position: relative; }
  .plus { position: absolute; left: -47px; top: -39px; width: 72px; height: 60px; fill: #289e19; stroke: #fff; stroke-width: 9px; overflow: visible; }

  .about { background: #fff; }
  .about .inner { max-width: var(--content-width); margin: 0 auto; padding: 26px 20px 0; text-align: center; }
  .heading { font-family: var(--font-bold); font-size: 30px; line-height: 1.5; color: var(--green); }
  .text { max-width: 693px; margin: 0 auto; font-family: var(--font-bold); font-size: 22px; line-height: 1.5; }
  .note { font-family: var(--font-bold); font-size: 15px; line-height: 1.5; }
  .heading.interested { margin-top: 33px; }

  .still { max-width: var(--content-width); margin: 0 auto; padding: 140px 20px 50px; }
  .still hr { border: 0; border-top: 2px solid #000; margin: 0 -20px 34px; }
  .still-title { display: inline-block; margin-left: 25px; background: var(--green); color: var(--white); font-family: var(--font-bold); font-size: 32px; line-height: normal; letter-spacing: 0.1em; padding: 0 0.35em; }
  .still-text { margin: 8px 0 0 37px; font-family: var(--font-body); font-size: 20px; line-height: normal; letter-spacing: 0.01em; color: #242323; }
  .still-text .mail { font-family: var(--font-bold); color: var(--green); text-decoration: none; }
  .still-text .mail:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    :global(.mfu-hero .hero-content) { padding-left: 40px; padding-bottom: 40px; }
    :global(.mfu-hero .hero-content .hero-title) { font-size: 44px; }
    .plus { width: 48px; height: 40px; left: -34px; top: -28px; }
    .heading { font-size: 24px; }
    .text { font-size: 18px; }
    .still { padding-top: 70px; }
    .still-title, .still-text { margin-left: 0; }
    .still-title { font-size: 22px; }
    .still-text { font-size: 17px; }
  }
  @media (max-width: 600px) { :global(.mfu-hero .hero-content .hero-title) { font-size: 30px; } }
</style>
