---
import Base from '../layouts/Base.astro';
---

<!-- Empty Wix page ("Resource"): a blank grey section is all the live page shows. -->
<Base title="Resources | Arizona Microcredit Initiative" description="Browse AMI&#39;s free small business resources: guides, tutorials and tools for starting, running and growing your Arizona business.">
  <section class="empty-page" aria-hidden="true"></section>
</Base>

<style>
  .empty-page { background: var(--grey-bg); height: 500px; }
  @media (max-width: 900px) { .empty-page { height: 300px; } }
</style>
