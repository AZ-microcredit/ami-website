---
/**
 * Draft/previous version of the LOANS page (Wix "Copy 2 of Loans"). Same skeleton as
 * /copy-of-loans (hero → WHY OUR MICROLOANS → stats → clients → CTA) plus unfinished
 * placeholder sections that are still live on the Wix page.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WhyRow from '../components/WhyRow.astro';
import InterestedCTA from '../components/InterestedCTA.astro';

const impact = [
  { icon: '/media/760f7c_c6ee2ff4718e48c08dec454d27383573.png', num: '$70,000', text: 'in loans distributed so far' },
  { icon: '/media/760f7c_1453f3a7e6f6407090f37a29b08d2b2a.png', num: '85%', text: 'Loans repaid so far' },
  { num: '15+', text: 'small businesses impacted' },
];
---

<Base
  title="Arizona Microcredit Initiative | LOANS"
  description="Our loans up to $7,500 are tailored to fit your business needs. Let us help your business reach its fullest potential!"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@600&family=Cormorant+Garamond:wght@300&display=swap" />
  </Fragment>

  <!-- Wix slideshow with a single slide (IMG_2592.HEIC); prev/next arrows kept for fidelity. -->
  <Hero image="/media/760f7c_341b24391a4a4db094f7e53ad88a8d3a.png" height={595} align="left" class="c2l-hero">
    <p class="hero-title">MICROLOANS</p>
    <h1 class="hero-subtitle">JUST FOR YOU</h1>
    <a class="btn hero-cta" href="#loan-details" aria-label="LOAN DETAILS">LOAN DETAILS</a>
  </Hero>
  <div class="slide-arrows" aria-hidden="true">
    <button type="button" class="prev" aria-label="Previous"><svg viewBox="0 0 21 41" width="21" height="41"><path d="M20.3 40.8 0 20.5 20.3.2l.7.7L1.3 20.5 21 40.1z" fill="#fff"/></svg></button>
    <button type="button" class="next" aria-label="Next"><svg viewBox="0 0 21 41" width="21" height="41"><path d="M.7 40.8 21 20.5.7.2l-.7.7 19.7 19.6L0 40.1z" fill="#fff"/></svg></button>
  </div>

  <WhyRow
    title="WHY OUR<br />MICROLOANS"
    html="With AMI, access microloans with <span class='g'>lower credit requirements</span> than traditional banks. As <span class='g'>small business specialists</span>, we offer <span class='g'>targeted financial solutions</span> for your company."
  />

  <section class="loan-stats" id="loan-details">
    <div><h2>$7500</h2><p>STARTING AT $1001 FOR YOUR BUSINESS NEEDS</p></div>
    <div><h2>6 - 24</h2><p>MONTHS FOR YOUR REPAYMENT TERMS</p></div>
    <div><h2>5 - 8%</h2><p>COMPETATIVE INTEREST RATES</p></div>
  </section>

  <section class="clients">
    <h2 class="clients-title"><span class="line"></span><span class="label">OUR CLIENTS</span><span class="line"></span></h2>
    <!-- Wix slideshow (one draft slide): arch-masked photo + dark caption box. Arrows/dots are decorative. -->
    <div class="client-slide">
      <button type="button" class="arrow prev" aria-label="Previous"><svg viewBox="0 0 21 41" width="21" height="41"><path d="M20.3 40.8 0 20.5 20.3.2l.7.7L1.3 20.5 21 40.1z" fill="#8cc28a"/></svg></button>
      <button type="button" class="arrow next" aria-label="Next"><svg viewBox="0 0 21 41" width="21" height="41"><path d="M.7 40.8 21 20.5.7.2l-.7.7 19.7 19.6L0 40.1z" fill="#8cc28a"/></svg></button>
      <img class="arch" src="/media/760f7c_64c5e1c432ed42f0b58f949b1bcf35fd.png" alt="Screenshot 2025-02-15 at 10.46.54 PM.png" width="300" height="421" loading="lazy" />
      <div class="caption">
        <blockquote>[Insert Text]</blockquote>
        <span class="chart" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path d="M3 20h4v-8H3zm7 0h4V4h-4zm7 0h4v-12h-4z" fill="#0d1b6b"/></svg></span>
        <hr />
        <p>CLIENT NAME</p>
      </div>
      <div class="dots"><span class="on"></span><span class="on"></span></div>
    </div>
  </section>

  <section class="impact">
    <div class="impact-grid">
      {impact.map((it) => (
        <div class="stat">
          {it.icon ? <img src={it.icon} alt="image.png" width="43" height="44" loading="lazy" /> : <span class="spacer"></span>}
          <h2>{it.num}</h2>
          <h3>{it.text}</h3>
        </div>
      ))}
    </div>

    <!-- Unfinished draft sections that are live on the Wix page (kept verbatim). -->
    <div class="drafts">
      <div class="draft-col faq-col">
        <h2 class="poppins sm">Frequently Asked Questions</h2>
        <p>Various Questions and Answers</p>
        <p>&#8203;</p>
        <p>Ex:</p>
        <p>&#8203;</p>
        <p>Q: Do I need a high credit score?</p>
        <p>A: No! Unlike traditional banks, we offer lower credit requirements and focus on your business potential.</p>
        <p>&#8203;</p>
        <p>Q:</p>
        <p>A:</p>
        <p>&#8203;</p>
        <h2 class="poppins director">Meet our Director of Finance</h2>
      </div>
      <div class="draft-col process-col">
        <h2 class="poppins sm">Loan Process</h2>
        <p class="lg">Step by Process:</p>
        <p class="lg">&#8203;</p>
        <p class="lg">1.</p>
        <p class="lg">&#8203;</p>
        <p class="lg">2.</p>
        <p class="lg">&#8203;</p>
        <p class="lg">3.</p>
        <p class="picture">Picture???</p>
      </div>
    </div>
  </section>

  <section class="cta">
    <InterestedCTA title="INTERESTED IN A LOAN?" spaced href="/schedule-a-consultation" />
  </section>
</Base>

<style>
  /* Hero: title stack top-left, LOAN DETAILS button lower-left */
  :global(.c2l-hero .hero-inner) { align-items: flex-start !important; }
  :global(.c2l-hero .hero-content) { padding-top: 66px; height: 100%; gap: 0; }
  :global(.c2l-hero .hero-content .hero-title) { background: #68b04d; color: #fafafa; font-size: 80px; line-height: 1.1; letter-spacing: -0.02em; padding: 0 10px 4px 8px; }
  :global(.c2l-hero .hero-content .hero-subtitle) { background: #68b04d; color: #fafafa; font-family: var(--font-body); font-weight: bold; font-size: 40px; line-height: 1.1; letter-spacing: -0.02em; margin-top: 6px; padding: 0 8px 2px; }
  :global(.c2l-hero .hero-cta) { margin-top: auto; margin-bottom: 118px; width: 273px; height: 49px; padding: 0; display: inline-flex; align-items: center; justify-content: center; background: #68b04d; color: #fff; border-color: #68b04d; font-size: 17px; letter-spacing: 0.08em; }
  :global(.c2l-hero .hero-cta:hover) { background: var(--green-dark); }
  .slide-arrows { position: relative; height: 0; }
  .slide-arrows button { position: absolute; bottom: 152px; background: none; border: 0; padding: 0; cursor: default; opacity: 0.85; }
  .slide-arrows .prev { left: 100px; }
  .slide-arrows .next { right: 100px; }

  .loan-stats { max-width: var(--content-width); margin: 0 auto; padding: 60px 20px 40px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; text-align: center; }
  .loan-stats h2 { font-family: var(--font-bold); font-size: 85px; line-height: 1; color: #68b04d; margin-bottom: 14px; }
  .loan-stats p { font-family: var(--font-bold); font-size: 15px; line-height: 1.4; max-width: 219px; margin: 0 auto; }

  .clients { max-width: var(--content-width); margin: 0 auto; padding: 36px 0 0; }
  .clients-title { display: flex; align-items: center; gap: 28px; margin: 0 auto; width: 954px; max-width: 100%; }
  .clients-title .line { flex: 1; height: 3px; background: #000; }
  .clients-title .label { font-family: var(--font-bold); font-size: 29px; letter-spacing: 0.5em; white-space: nowrap; }
  .client-slide { position: relative; height: 495px; margin-top: 50px; }
  .client-slide .arch { position: absolute; left: 67px; top: 14px; width: 300px; height: 421px; object-fit: cover; border-radius: 150px 150px 0 0; }
  .client-slide .caption { position: absolute; left: 323px; top: 135px; width: 558px; height: 228px; background: #404040; color: #fff; padding: 52px 0 0 42px; }
  .caption blockquote { margin: 0; font-family: var(--font-body); font-size: 26px; line-height: 1.4; }
  .caption .chart { position: absolute; left: 155px; top: 78px; }
  .caption hr { width: 38px; margin: 12px 0 0; border: 0; border-top: 2px solid #fff; }
  .caption p { margin-top: 30px; font-family: var(--font-body); font-size: 20px; }
  .client-slide .arrow { position: absolute; top: 175px; background: none; border: 0; padding: 0; cursor: default; }
  .client-slide .prev { left: -126px; }
  .client-slide .next { right: -126px; }
  .client-slide .dots { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); display: flex; gap: 14px; }
  .client-slide .dots span { width: 6px; height: 6px; border-radius: 50%; background: var(--green); }

  .impact { max-width: var(--content-width); margin: 0 auto; padding: 60px 20px 0; }
  .impact-grid { width: 898px; max-width: 100%; margin-left: 39px; display: grid; grid-template-columns: 217px 217px 217px; justify-content: space-between; }
  .stat { text-align: center; }
  .stat img, .stat .spacer { display: block; width: 43px; height: 44px; margin: 0 auto; }
  .stat h2 { font-family: var(--font-bold); font-size: 55px; line-height: 1.5; color: #68b04d; }
  .stat h3 { font-family: var(--font-body); font-weight: bold; font-size: 18px; line-height: 1.5; }
  .impact-grid .stat:nth-child(3) h2 { line-height: 1.3; margin-top: 14px; }

  .drafts { margin: 48px 0 0 39px; display: grid; grid-template-columns: 1fr 1fr; }
  .poppins { font-family: 'Poppins', var(--font-bold); font-weight: 600; letter-spacing: 0.01em; }
  .poppins.sm { font-size: 16px; line-height: normal; }
  .draft-col p { max-width: 304px; font-family: var(--font-avenir-light); font-size: 20px; line-height: 1.3; }
  .faq-col > p:first-of-type { margin-top: 46px; }
  .director { font-size: 26px; line-height: normal; max-width: 215px; margin: 76px 0 0 11px; }
  .process-col { padding-left: 55px; }
  .process-col p.lg { font-size: 21px; margin-left: -94px; }
  .process-col p.lg:first-of-type { margin-top: 46px; }
  .picture { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 300; font-size: 57px; line-height: 1.2; margin: 66px 0 0 -152px; }

  .cta { max-width: var(--content-width); margin: 0 auto; padding: 100px 20px 40px; }

  @media (max-width: 1100px) { .client-slide .prev { left: 8px; } .client-slide .next { right: 8px; } }
  @media (max-width: 900px) {
    :global(.c2l-hero .hero-content) { padding-top: 30px; }
    :global(.c2l-hero .hero-content .hero-title) { font-size: 48px; }
    :global(.c2l-hero .hero-content .hero-subtitle) { font-size: 24px; }
    :global(.c2l-hero .hero-cta) { margin-bottom: 30px; width: 220px; height: 44px; }
    .slide-arrows { display: none; }
    .loan-stats { grid-template-columns: 1fr; }
    .loan-stats h2 { font-size: 60px; }
    .clients { padding: 30px 20px 0; }
    .clients-title .label { font-size: 20px; letter-spacing: 0.3em; }
    .client-slide { height: auto; padding-bottom: 30px; }
    .client-slide .arch { position: static; margin: 0 auto; display: block; max-width: 100%; }
    .client-slide .caption { position: static; width: auto; height: auto; margin-top: 20px; padding: 30px 24px; }
    .caption .chart { display: none; }
    .client-slide .arrow { display: none; }
    .impact-grid { width: auto; margin-left: 0; grid-template-columns: 1fr; gap: 24px; justify-content: center; }
    .drafts { margin-left: 0; grid-template-columns: 1fr; gap: 30px; }
    .process-col { padding-left: 0; }
    .process-col p.lg, .picture, .director { margin-left: 0; }
    .cta { padding-top: 60px; }
  }
  @media (max-width: 600px) {
    :global(.c2l-hero .hero-content .hero-title) { font-size: 34px; }
    :global(.c2l-hero .hero-content .hero-subtitle) { font-size: 18px; }
    .picture { font-size: 40px; }
  }
</style>
