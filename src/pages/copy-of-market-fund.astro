---
/** Older "MARKET FUND GRANT" page (band header variant of /marketfund). */
import Base from '../layouts/Base.astro';
import PlusBand from '../components/PlusBand.astro';

// Displayed 1 → 2 → 3 left to right (the Wix DOM order is 1, 3, 2).
const steps = [
  { icon: '/media/760f7c_8c33949659f145c889bee25567953777.png', alt: 'resume.png', size: 99, html: '1. Fill out our application, providing details about your business<br /><br />(Applications unavailable at this moment)', w: 255 },
  { icon: '/media/760f7c_d5c6bcd9360545388ecf34ee967f6196.png', alt: 'zoom.png', size: 176, html: '2. Schedule an initial call  below to see if AMI Market Fund is the right fit for you', w: 223 },
  { icon: '/media/760f7c_048f20cf9a504ce48cb5cc2d8f3d3506.png', alt: 'download copy 2.png', size: 241, html: '3. If approved, AMI will assist you in joining local markets', w: 255 },
];
const arrow = '/media/760f7c_b3f12180f264444f9d634b8c8a9a1bfc.png';
---

<Base title="MARKET FUND | az-microcredit">
  <PlusBand title="MARKET FUND GRANT" subtitle="Assisting entrepreneurs to be involved in local markets with our grant!" subtitleWidth={678} indent={50} />

  <div class="photo-strip">
    <img src="/media/760f7c_8fec55c23f2645c7af769edd62cec679.png" alt="IMG_1774.heic" loading="eager" />
  </div>

  <section class="mf">
    <div class="inner">
      <p class="heading">What is the AMI Market Fund?</p>
      <p class="text">The Market Fund is a microgrant* of up to $400 designed to support business owners participating in local markets for the first time, helping them grow their sales and expand their customer base.</p>
      <p class="note">*microgrant: financial aid that does not have to be paid back; for first-time market-goers only.</p>
      <p class="heading interested">Interested in the Market Fund?</p>

      <ol class="steps">
        {steps.map((s, i) => (
          <>
            {i > 0 && <li class="arrow" aria-hidden="true"><img src={arrow} alt="" width="68" height="68" loading="lazy" /></li>}
            <li class="step">
              <div class="icon"><img src={s.icon} alt={s.alt} width={s.size} height={s.size} loading="lazy" /></div>
              <h2 style={`max-width:${s.w}px`} set:html={s.html} />
            </li>
          </>
        ))}
      </ol>

      <h1 class="mf-note">If no available times work for you, please contact <a href="mailto:info@azmicrocredit.org">info@azmicrocredit.org</a> so we can coordinate a time!</h1>

      <!-- INTEGRATION: Wix Bookings calendar (Market Fund initial call) sits in this ~850px
           container on the live page but renders blank without Wix. Replace the placeholder
           with the scheduling embed. -->
      <div class="calendar-placeholder" role="region" aria-label="Scheduling calendar">
        <span>Scheduling calendar</span>
      </div>

      <div class="questions">
        <p class="q-title">Have any questions?</p>
        <!-- The live site shows the mistyped address "@infoazmicrocredit.org"; text kept, link corrected. -->
        <p class="q-mail">Email <a href="mailto:info@azmicrocredit.org">@infoazmicrocredit.org</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .photo-strip { height: 370px; overflow: hidden; background: #cbc3bd; }
  /* the live column background shows this photo heavily blurred */
  .photo-strip img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; filter: blur(14px); transform: scale(1.08); }

  .mf { background: #fafafa; }
  .inner { max-width: var(--content-width); margin: 0 auto; padding: 25px 20px 110px; text-align: center; }
  .heading { font-family: var(--font-bold); font-size: 30px; line-height: 1.5; color: var(--green); }
  .text { max-width: 693px; margin: 0 auto; font-family: var(--font-bold); font-size: 22px; line-height: 1.5; }
  .note { font-family: var(--font-bold); font-size: 15px; line-height: 1.5; }
  .heading.interested { margin-top: 33px; }

  .steps { list-style: none; margin: 40px 0 0 0; padding: 0; display: grid; grid-template-columns: 255px 78px 255px 72px 255px; justify-content: center; align-items: start; }
  .step { display: flex; flex-direction: column; align-items: center; }
  .step .icon { height: 115px; display: flex; align-items: center; justify-content: center; }
  .step .icon img { max-width: none; height: auto; }
  .step h2 { margin: 0 auto; font-family: var(--font-body); font-weight: bold; font-size: 20px; line-height: 1.3; color: var(--green); }
  .arrow { height: 115px; display: flex; align-items: center; justify-content: center; }

  .mf-note { margin-top: 58px; font-family: var(--font-body); font-size: 16px; line-height: 1.4; }
  .mf-note a { color: inherit; text-decoration: none; }
  .mf-note a:hover { text-decoration: underline; }

  .calendar-placeholder { margin: 30px auto 0; height: 560px; border: 1px solid #ececec; background: #fdfdfd; display: flex; align-items: center; justify-content: center; font-family: var(--font-avenir-light); font-size: 18px; letter-spacing: 0.08em; color: #9a9a9a; text-transform: uppercase; }

  .questions { margin-top: 30px; }
  .q-title { font-family: var(--font-bold); font-size: 30px; line-height: normal; color: var(--green); }
  .q-mail { font-family: var(--font-bold); font-size: 22px; line-height: normal; margin-top: 2px; }
  .q-mail a { color: inherit; text-decoration: none; }
  .q-mail a:hover { text-decoration: underline; }

  @media (max-width: 1000px) {
    .steps { grid-template-columns: 1fr 60px 1fr 60px 1fr; }
    .step .icon img { max-width: 100%; }
  }
  @media (max-width: 900px) {
    .photo-strip { height: 48vw; min-height: 200px; }
    .inner { padding-bottom: 60px; }
    .heading { font-size: 24px; }
    .text { font-size: 18px; }
    .steps { grid-template-columns: 1fr; row-gap: 20px; }
    .arrow { height: auto; transform: rotate(90deg); }
    .arrow img { width: 48px; height: 48px; }
    .step .icon { height: 110px; }
    .step .icon img { max-height: 130px; width: auto; }
    .step h2 { font-size: 18px; max-width: 320px !important; }
    .calendar-placeholder { height: 420px; }
    .q-title { font-size: 24px; }
    .q-mail { font-size: 18px; }
  }
</style>
