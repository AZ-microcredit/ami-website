---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CalendlyWidget from '../components/CalendlyWidget.astro';

// ── CALENDLY CONFIG ──────────────────────────────────────────────────────────
// Update this URL to the AMI Calendly account + event type for the Market Fund call.
const CALENDLY_URL = 'https://calendly.com/azmicrocredit/loans';
// ─────────────────────────────────────────────────────────────────────────────

// Displayed 1 → 2 → 3 left to right (the Wix DOM order is 1, 3, 2).
const steps = [
  { icon: '/media/760f7c_8c33949659f145c889bee25567953777.png', alt: 'Application form icon', size: 99, text: '1. Fill out our application, providing details about your business' },
  { icon: '/media/760f7c_d5c6bcd9360545388ecf34ee967f6196.png', alt: 'Video call icon', size: 176, text: '2. Schedule an initial call  below to see if AMI Market Fund is right for you' },
  { icon: '/media/760f7c_048f20cf9a504ce48cb5cc2d8f3d3506.png', alt: 'Group of people icon', size: 241, text: '3. If approved, AMI will assist you in joining local markets' },
];
const arrow = '/media/760f7c_b3f12180f264444f9d634b8c8a9a1bfc.png';
---

<Base title="Market Fund | Arizona Microcredit Initiative">
  <Hero image="/media/760f7c_3adc1430feed4554bd21bc9be3ccd372.jpg" height={294} align="left" class="mf-hero">
    <div class="title-wrap">
      <svg class="plus" viewBox="0 0 252.492 252.492" aria-hidden="true" role="presentation">
        <path vector-effect="non-scaling-stroke" d="M252.492 117.246H135.246V0h-18v117.246H0v18h117.246v117.246h18V135.246h117.246v-18z" />
      </svg>
      <h1 class="hero-title">MARKET FUND</h1>
    </div>
  </Hero>

  <section class="mf">
    <div class="mf-inner">
      <h2 class="mf-heading">What is the AMI Market Fund?</h2>
      <p class="mf-intro">The Market Fund is a micro grant of up to $400 designed to support business owners participating in local markets for the first time, helping them grow their sales and expand their customer base.</p>

      <h2 class="mf-heading interested">Interested in the Market Fund?</h2>

      <ol class="steps">
        {steps.map((s, i) => (
          <>
            {i > 0 && <li class="arrow" aria-hidden="true"><img src={arrow} alt="" width="68" height="68" /></li>}
            <li class="step">
              <div class="icon"><img src={s.icon} alt={s.alt} width={s.size} height={s.size} loading="lazy" /></div>
              <p>{s.text}</p>
            </li>
          </>
        ))}
      </ol>

      <p class="mf-note">If no available times work for you, please contact <a href="mailto:info@azmicrocredit.org">info@azmicrocredit.org</a> so we can coordinate a time!</p>

      <CalendlyWidget url={CALENDLY_URL} height={790} />

      <div class="questions">
        <p class="q-title">Have any questions?</p>
        <!-- The live site shows the mistyped address "@infoazmicrocredit.org"; text kept, link corrected. -->
        <p class="q-mail">Email <a href="mailto:info@azmicrocredit.org">@infoazmicrocredit.org</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  :global(.mf-hero .hero-bg) { opacity: 0.5; }
  :global(.mf-hero) { background: #fff; min-height: 0; }
  :global(.mf-hero .hero-content) { padding-bottom: 42px; padding-left: 31px; }
  :global(.mf-hero .hero-content .hero-title) { font-size: 66px; line-height: 1.05; padding: 0 4px 2px 4px; }
  .title-wrap { position: relative; }
  .plus { position: absolute; left: -44px; top: -44px; width: 72px; height: 60px; fill: #fff; stroke: #fff; stroke-width: 9px; overflow: visible; }

  .mf { background: #fafafa; }
  .mf-inner { max-width: var(--content-width); margin: 0 auto; padding: 18px 20px 90px 15px; }
  .mf-heading { font-family: var(--font-bold); font-size: 32px; line-height: 1.5; color: var(--green); }
  .mf-intro { max-width: 941px; font-family: var(--font-body); font-size: 22px; line-height: 1.5; margin-top: 6px; }
  .mf-heading.interested { margin-top: 62px; }

  .steps { list-style: none; margin: 40px 0 0 8px; padding: 0; display: grid; grid-template-columns: 255px 68px 255px 68px 255px; column-gap: 12px; align-items: start; }
  .step { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .step .icon { height: 130px; display: flex; align-items: center; justify-content: center; }
  .step .icon img { max-width: none; height: auto; }
  .step p { margin-top: 6px; font-family: var(--font-body); font-weight: bold; font-size: 20px; line-height: 1.3; color: var(--green); }
  .arrow { height: 130px; display: flex; align-items: center; justify-content: center; }

  .mf-note { margin-top: 90px; text-align: center; font-family: var(--font-body); font-size: 16px; line-height: 1.4; }
  .mf-note a { color: inherit; text-decoration: none; }
  .mf-note a:hover { text-decoration: underline; }

  .calendar-placeholder { margin: 24px 0 0 5px; height: 600px; border: 1px solid #e3e3e3; background: #fdfdfd; display: flex; align-items: center; justify-content: center; font-family: var(--font-avenir-light); font-size: 18px; letter-spacing: 0.08em; color: #9a9a9a; text-transform: uppercase; }

  .questions { margin-top: 28px; text-align: center; }
  .q-title { font-family: var(--font-bold); font-size: 30px; line-height: normal; color: var(--green); }
  .q-mail { font-family: var(--font-bold); font-size: 22px; line-height: normal; margin-top: 4px; }
  .q-mail a { color: inherit; text-decoration: none; }
  .q-mail a:hover { text-decoration: underline; }

  @media (max-width: 1000px) {
    .steps { grid-template-columns: 1fr 60px 1fr 60px 1fr; column-gap: 4px; margin-left: 0; }
    .step .icon img { max-width: 100%; }
  }
  @media (max-width: 900px) {
    :global(.mf-hero .hero-content) { padding-left: 40px; padding-bottom: 30px; }
    :global(.mf-hero .hero-content .hero-title) { font-size: 40px; }
    .plus { width: 48px; height: 40px; left: -34px; top: -26px; }
    .mf-inner { padding: 18px 20px 60px; }
    .mf-heading { font-size: 26px; }
    .mf-intro { font-size: 18px; }
    .mf-heading.interested { margin-top: 36px; }
    .steps { grid-template-columns: 1fr; row-gap: 20px; }
    .arrow { height: auto; transform: rotate(90deg); }
    .arrow img { width: 48px; height: 48px; }
    .step .icon { height: 110px; }
    .step .icon img { max-height: 130px; width: auto; }
    .step p { font-size: 18px; max-width: 320px; }
    .mf-note { margin-top: 40px; }
    .calendar-placeholder { margin-left: 0; height: 480px; }
    .q-title { font-size: 24px; }
    .q-mail { font-size: 18px; }
  }
  @media (max-width: 600px) {
    :global(.mf-hero .hero-content .hero-title) { font-size: 30px; }
    .mf-heading { font-size: 22px; }
    .mf-intro { font-size: 16px; }
    .calendar-placeholder { height: 400px; }
  }
</style>
