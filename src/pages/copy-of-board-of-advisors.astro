---
import Base from '../layouts/Base.astro';
import AdvisorGrid from '../components/AdvisorGrid.astro';

// Older version of the Board of Advisors page: 12 advisors, lines broken as on the live page.
const advisors = [
  { name: 'Farhan Khera', lines: ['Senior Product Manager,', 'Huge,', 'ASU Alumnus'], image: '/media/760f7c_0c083e3332214985bd13dd367cb616cc.png' },
  { name: 'Mikkaela Salamatin', lines: ['Associate,', 'Norton Rose Fulbright,', 'ASU Alumnus'], image: '/media/760f7c_72e0086c21ea4fcdb703bdde41dbfdb1.png' },
  { name: 'Gabriel A. Gasca', lines: ['SBA Loan Officer,', 'Midwest Regional Bank,', 'Community Partner'], image: '/media/760f7c_5b6647f3a06b4e8b95ea5adafa17cd0b.jpg' },
  { name: 'Greg Russo', lines: ['Central Regional President,', 'OneAZ Credit Union,', 'Community Partner'], image: '/media/760f7c_4e0d9e8f599948da88f6915ceabb61f1.png' },
  { name: 'Amber Cordoba', lines: ['Director of External Affairs,', 'Prestamos,', 'Community Partner'], image: '/media/760f7c_4e965d541d324217819af81beec2e29f.png' },
  { name: 'Michael Barger', lines: ['Senior Business Analyst,', 'McKinsey & Co.,', 'AMI Alumnus'], image: '/media/760f7c_8b28568b48b347f18e4fa6e44dc5e0f4.png' },
  { name: 'Courtney Klein', lines: ['Co-Founder & Advisor,', 'Seed Spot,', 'Community Partner'], image: '/media/760f7c_85a3f1e2d05941fcafd716d057fcf735.png' },
  { name: 'TJ Radigan', lines: ['Senior Associate,', 'McKinsey & Co.,', 'AMI Alumnus'], image: '/media/760f7c_8a5e5b0b202242de9150f2226a8f1b45.jpg' },
  { name: 'Dr. Phil Lamoreaux', lines: ['Professor,', 'W.P. Carey,', 'ASU Advisor'], image: '/media/760f7c_f70794db56064f438f465937be8cb40d.jpg' },
  { name: 'Timothy Desmond', lines: ['Strategic initiatives SM,', 'CNA,', 'AZ Supporter'], image: '/media/760f7c_9d489a49338f425c9d078408499d3f9f.png' },
  { name: 'Cecilia Ashe', lines: ['Vice President/Chief', 'Operating Officer,', 'Landing Credit Union', 'Community Partner'], image: '/media/760f7c_8644fe14193c411288b2bcd317e0d698.png' },
  { name: 'Chelsea Smith', lines: ['Chief Operating Officer,', 'HUUB,', 'Community Partner'], image: '/media/760f7c_b370416e42be40f48d0297631a5fdef2.png' },
];
---

<Base title="Board of Advisors | az-microcredit">
  <section class="advisors">
    <h1 class="spaced-title">THE BOARD OF ADVISORS</h1>
    <AdvisorGrid people={advisors} />
  </section>
</Base>

<style>
  .advisors { max-width: var(--content-width); margin: 0 auto; padding: 8px 20px 60px; }
  .advisors .spaced-title { font-size: 40px; letter-spacing: 0.5em; margin: 0 -20px 56px; white-space: nowrap; }
  @media (max-width: 900px) { .advisors .spaced-title { font-size: 26px; letter-spacing: 0.35em; margin: 0 0 40px; white-space: normal; } }
  @media (max-width: 600px) { .advisors .spaced-title { font-size: 20px; letter-spacing: 0.25em; } }
</style>
