---
// Legacy Wix CMS "My Items" listing of every post (live site: /posts).
import Base from '../layouts/Base.astro';
import { posts, postUrl, excerpt } from '../lib/blog';
---

<Base title="Arizona Microcredit Initiative | Posts" description="All blog posts from the Arizona Microcredit Initiative.">
  <section class="cms-list">
    <h1>My Items</h1>
    <p class="sub">I'm a title. Click here to edit me.</p>
    <ul class="items">
      {posts.map((p) => (
        <li class="item">
          <a class="thumb" href={postUrl(p)} tabindex="-1" aria-hidden="true"><img src={p.cover} alt={p.title} loading="lazy" /></a>
          <div class="body">
            <h2><a href={postUrl(p)}>{p.title}</a></h2>
            <p class="text">{excerpt(p, 600)}</p>
            <a class="more" href={postUrl(p)} aria-label={`More: ${p.title}`}>More</a>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .cms-list { max-width: 796px; margin: 0 auto; padding: 50px 20px 60px; }
  h1 { font-family: var(--font-bold); font-size: 32px; text-align: center; margin-bottom: 14px; }
  .sub { font-family: var(--font-body); font-size: 16px; text-align: center; margin-bottom: 50px; }
  .items { display: flex; flex-direction: column; gap: 50px; }
  .item { border: 1px solid #e6e6e6; display: grid; grid-template-columns: 262px 1fr; gap: 40px; }
  .thumb img { width: 100%; height: 262px; object-fit: contain; object-position: top; }
  .body { padding: 34px 40px 30px 0; min-width: 0; }
  h2 { font-family: var(--font-bold); font-size: 22px; line-height: 1.3; margin-bottom: 40px; }
  h2 a { text-decoration: none; }
  h2 a:hover { text-decoration: underline; }
  .text { font-family: var(--font-body); font-size: 16px; line-height: 1.4; margin-bottom: 26px; display: -webkit-box; -webkit-line-clamp: 8; -webkit-box-orient: vertical; overflow: hidden; }
  .more { font-family: var(--font-avenir-light); font-size: 16px; color: #deb512; text-decoration: none; }
  .more:hover { text-decoration: underline; }
  @media (max-width: 700px) {
    .item { grid-template-columns: 1fr; gap: 0; }
    .thumb img { height: 220px; }
    .body { padding: 20px; }
  }
</style>
