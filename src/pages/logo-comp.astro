.reveal{opacity:0;transform:translateY(28px);transition:opacity .75s ease,transform .75s cubic-bezier(.2,.7,.2,1)}
.reveal.in{opacity:1;transform:none}
.delay{transition-delay:.1s}.delay-1{transition-delay:.1s}.delay-2{transition-delay:.2s}
@keyframes hero-rise{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
@keyframes prize-slide-in{from{transform:translateX(100%)}to{transform:translateX(0)}}
.brief-list li,.swatch,.board-card,.brand-card,.channel{transition:border-color .3s ease,transform .3s cubic-bezier(.2,.7,.2,1)}
