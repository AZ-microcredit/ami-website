---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { PENDING, heroFacts, palette, paletteNeutrals, briefRequirements, enterCards, timeline, judgingCriteria, rightsTerms, boardSlots, brandFoundations, brandPillars, brandImagery, brandVoice } from '../data/logoComp.js';
---
<Base title="Integro Bank Foundation Logo Competition | Arizona Microcredit Initiative" description="A statewide Arizona design competition to create the new logo for the Integro Bank Foundation, presented with Arizona Microcredit Initiative." mainClass="logo-page">
  <section class="hero dark">
    <div class="hero-copy">
      <p class="eyebrow gold-text">Open call for Arizona designers</p>
      <h1>Design the<br/><em>Foundation's</em><br/><em>New Mark.</em></h1>
      <p class="lede">The Integro Bank Foundation is looking for its logo, and would rather find it in Arizona than order it from a catalogue. Open to Arizona small businesses and Arizona design students, presented with Arizona Microcredit Initiative.</p>
      <div class="hero-actions">
        <a class="button ghost-button" href="https://docs.google.com/forms/d/e/1FAIpQLSc2vFSkoWLZsPGwSRrQhK-gxJtnXiMM_shMnU0lFEpYlO8sDA/viewform" target="_blank" rel="noopener noreferrer">Submit your entry</a>
        <a class="text-link hero-brief-link" href="#brief">Read the brief <Icon name="arrow-down" /></a>
      </div>
    </div>
    <div class="hero-side">
    <div class="co-brand" aria-label="Presented by Integro Bank Foundation and Arizona Microcredit Initiative">
      <span class="brand-tile"><img src="/media/pitch-partners/integro-white.png" alt="Integro Bank Foundation" width="200" height="71"/></span>
      <span class="brand-x" aria-hidden="true">+</span>
      <span class="brand-tile"><img src="/media/ami-official-white.png" alt="Arizona Microcredit Initiative" width="180" height="58"/></span>
    </div>
    <figure class="hero-card">
      <div class="mark-frame"><img src="/media/pitch-partners/integro.webp" alt="The current Integro Bank Foundation logo" width="1000" height="357"/></div>
      <figcaption>Current Logo</figcaption>
    </figure>
    </div>
    <div class="prize-band" aria-label="$1,500 first prize">
      <strong>$1,500</strong>
      <span class="prize-side">First prize</span>
    </div>
    <dl class="facts">
      {heroFacts.map(fact => <div><dt>{fact.term}</dt><dd>{fact.lines[0]}<br/>{fact.lines[1]}</dd></div>)}
    </dl>
  </section>
  <section class="enter dark">
    <div class="section-head reveal"><p class="eyebrow gold-text">Entering</p><h2>What it takes.</h2></div>
    <div class="enter-grid">
      {enterCards.map((card, i) => <article class={`enter-card reveal ${i ? `delay-${i}` : ''}`}>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
        {card.note && <p class="card-note">{card.note}</p>}
        {card.pendings.length > 0 && <ul class="pending-list">
          {card.pendings.map(item => <li><span class="pending-token">{PENDING}</span>{item}</li>)}
        </ul>}
      </article>)}
    </div>
  </section>
  <section class="process light">
    <div class="section-head reveal"><p class="eyebrow">Process and dates</p><h2>Four dates to know.</h2></div>
    <ol class="timeline">
      {timeline.map((step, i) => <li class={`reveal ${i ? `delay-${i}` : ''}`}>
        <p class="step-num">{step.n}</p>
        <h3>{step.title}</h3>
        <p class={`step-date ${step.pending ? 'is-pending' : ''}`}>{step.date}{step.pending && <span class="pending-token">To be announced</span>}</p>
        <p>{step.copy}</p>
      </li>)}
    </ol>
  </section>
  <section class="enter-cta" id="enter">
    <div class="reveal">
      <h2>Entries are open.</h2>
      <p>Submit one ZIP file containing your full-size logo, SVG vector source, black and white contrast versions, half-page rationale, and evidence of your working process.<br/>Deadline: October 10, 2026.</p>
      <p class="cta-contact">Google sign-in is required for the file upload. The Foundation board reviews every complete entry.</p>
    </div>
    <a class="button black-button" href="https://docs.google.com/forms/d/e/1FAIpQLSc2vFSkoWLZsPGwSRrQhK-gxJtnXiMM_shMnU0lFEpYlO8sDA/viewform" target="_blank" rel="noopener noreferrer">Submit one ZIP</a>
  </section>
  <section class="judging dark">
    <div class="judge-block reveal">
      <p class="eyebrow gold-text">Judging</p>
      <h2>Five criteria,<br/>weighted.</h2>
      <p>The Foundation board reviews every complete entry. Its decision is final, and the Foundation may decline to award if no entry meets the brief.</p>
      <p class="pending-line"><span class="pending-token">{PENDING}</span>Judging committee membership</p>
    </div>
    <div class="prize-block reveal delay">
      <p class="eyebrow gold-text">Prize</p>
      <h2>$1,500.</h2>
      <p>$1,500 to the winning entrant, a press release announcing the winner and their business or school, and a CEO special feature profiling the winner by Integro Bank.</p>
    </div>
  </section>
  <section class="criteria-band light">
    <div class="criteria-grid">
      {judgingCriteria.map((c, i) => <div class={`criterion reveal ${i ? `delay-${Math.min(i, 2)}` : ''}`}><strong><span class="num">{c.weight}</span><span class="pct">%</span></strong><div><h3>{c.name}</h3><p>{c.copy}</p></div></div>)}
    </div>
  </section>
  <section class="board light">
    <div class="section-head reveal"><p class="eyebrow">Foundation board</p><h2>The people judging.</h2></div>
    <div class="board-grid">
      {boardSlots.map((slot, i) => <article class={`board-card reveal ${i ? `delay-${Math.min(i, 2)}` : ''}`}>
        <span class="silhouette" aria-hidden="true"><svg viewBox="0 0 48 48" width="48" height="48" fill="none"><circle cx="24" cy="16" r="9" fill="#c9c4b4"/><path d="M6 44c2-10 9-15 18-15s16 5 18 15" fill="#c9c4b4"/></svg></span>
        <h3>{PENDING}</h3>
        <p>{slot}</p>
      </article>)}
    </div>
    <p class="board-note reveal">Names, titles, and bios will be published once the Foundation supplies them.</p>
  </section>
  <section class="rights dark">
    <div class="section-head reveal"><p class="eyebrow gold-text">Rules and rights</p><h2>Read this part carefully.</h2></div>
    <ul class="brief-list rights-list reveal">
      {rightsTerms.map(term => <li><strong>{term.title}</strong> {term.copy}</li>)}
    </ul>
  </section>
  <section class="brief light" id="brief">
    <div class="section-head reveal"><p class="eyebrow">Creative direction</p><h2>The brief.</h2></div>
    <div class="brief-grid">
      <ul class="brief-list reveal">
        <li><strong>Required name.</strong> The mark is for the Integro Bank Foundation, spelled in full and legible somewhere in the lockup. The circular arrow is taken by Integro360 - off limits.</li>
        <li><strong>Direction.</strong> A black-and-gold wordmark, starting fresh. The leaf is not required, and any font or treatment may be used.</li>
        {briefRequirements.slice(0, -2).map(req => <li><strong>{req.title}</strong> {req.copy}</li>)}
      </ul>
      <div class="brief-side reveal delay">
        <div class="swatches" aria-label="Approximate competition palette">
        {palette.map(swatch => <div class="swatch"><span class="chip" style={`background:${swatch.hex}`}></span><p>{swatch.name}<br/><small>{swatch.hex}</small></p></div>)}
        {paletteNeutrals.map(swatch => <div class="swatch neutral"><span class="chip" style={`background:${swatch.hex}`}></span><p>{swatch.name}<br/><small>{swatch.hex} · {swatch.use}</small></p></div>)}
        </div>

      </div>
    </div>
  </section>
  <section class="brand dark">
    <div class="section-head reveal"><p class="eyebrow gold-text">Brand foundations</p><h2>The brand in its own words.</h2></div>
    <div class="brand-grid">
      {brandFoundations.map((f, i) => <div class={`brand-card reveal ${f.dark ? 'dark-card' : ''} ${i ? `delay-${Math.min(i, 2)}` : ''}`}><h3>{f.k}</h3><p>{f.v}</p></div>)}
    </div>
    <div class="pillars reveal">
      {brandPillars.map(pillar => <div class="pillar"><h3>{pillar.name}</h3><p>{pillar.copy}</p></div>)}
    </div>
    <div class="imagery-grid reveal">
      <div>
        <h3 class="sub-head">How the brand pictures itself</h3>
        <p class="body-copy">{brandImagery.copy}</p>
        <p class="gap-note">{brandImagery.gap}</p>
      </div>
      <div class="channel-list">
        {brandImagery.channels.map(ch => <div class="channel"><h4>{ch.name}</h4><p>{ch.copy}</p></div>)}
      </div>
    </div>
  </section>
  <section class="voice light">
    <div class="section-head reveal"><p class="eyebrow">Type and voice</p><h2>How the brand talks.</h2></div>
    <div class="type-card reveal">
      <p class="eyebrow type-card-label">Observed hierarchy, web</p>
      <div class="type-row"><span class="type-tag">H1</span><p class="type-sample type-h1">Rise to the Top</p></div>
      <div class="type-row"><span class="type-tag">H2</span><p class="type-sample type-h2">Core Values</p></div>
      <div class="type-row"><span class="type-tag">H5 / eyebrow</span><p class="type-sample type-eyebrow">Our Mission</p></div>
      <div class="type-row"><span class="type-tag">Body</span><p class="type-sample type-body">To help small business maximize growth and employment. Set in the same family, one weight lighter, with generous line height.</p></div>
    </div>
    <blockquote class="voice-quote reveal">
      <p>&ldquo;{brandVoice.sentence}&rdquo;</p>
      <cite>{brandVoice.sentenceNote}</cite>
    </blockquote>
  </section>
  <section class="enter-cta">
    <div class="reveal">
      <h2>Entries are open.</h2>
      <p>Submit one ZIP file containing your full-size logo, SVG vector source, black and white contrast versions, half-page rationale, and evidence of your working process.<br/>Deadline: October 10, 2026.</p>
      <p class="cta-contact">Google sign-in is required for the file upload. The Foundation board reviews every complete entry.</p>
    </div>
    <a class="button black-button" href="https://docs.google.com/forms/d/e/1FAIpQLSc2vFSkoWLZsPGwSRrQhK-gxJtnXiMM_shMnU0lFEpYlO8sDA/viewform" target="_blank" rel="noopener noreferrer">Submit one ZIP</a>
  </section>
  <section class="co-footer dark">
    <div class="co-inner reveal">
      <p class="eyebrow gold-text">Presented by</p>
      <div class="co-lockup">
        <span class="brand-tile"><img src="/media/pitch-partners/integro-white.png" alt="Integro Bank Foundation" width="200" height="71" loading="lazy"/></span>
        <span class="brand-x" aria-hidden="true">+</span>
        <span class="brand-tile"><img src="/media/ami-official-white.png" alt="Arizona Microcredit Initiative" width="180" height="58" loading="lazy"/></span>
      </div>
      <p class="co-note">Integro Bank Foundation with Arizona Microcredit Initiative.<br/><a class="co-link" href="https://www.integrobank.com/About-Integro/Our-Commitment/Integro-Bank-Foundation" target="_blank" rel="noopener noreferrer">About the Integro Bank Foundation</a></p>
    </div>
  </section>
  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const items = document.querySelectorAll('.reveal');
    if (reduced) items.forEach(el => el.classList.add('in'));
    else {
      const observer = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('in'); observer.unobserve(entry.target); } }), { threshold: .12 });
      items.forEach(el => observer.observe(el));
    }
    const nums = document.querySelectorAll('.criterion .num');
    if (!reduced && nums.length) {
      const run = el => {
        const target = parseInt(el.textContent, 10);
        const dur = 900;
        const t0 = performance.now();
        const tick = now => {
          const p = Math.min(1, (now - t0) / dur);
          el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const cObs = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) { run(entry.target); cObs.unobserve(entry.target); } }), { threshold: .4 });
      nums.forEach(el => cObs.observe(el));
    }
  </script>
</Base>

<style>
:global(.logo-page){--ink:#0B0B0C;--cream:#F5F1E6;--gold:#C2A14D;--grey:#4A4E57;background:var(--cream);color:var(--ink)}
:global(.logo-page *){box-sizing:border-box}.dark{background:var(--ink);color:#fff}.light{background:var(--cream)}.eyebrow{font:700 11px/1.4 var(--font-heading);letter-spacing:.13em;text-transform:uppercase;margin:0}.gold-text{color:var(--gold)}
.pending-token{display:inline-block;border:1px dashed var(--gold);color:var(--gold);font:700 9px/1 var(--font-heading);letter-spacing:.14em;text-transform:uppercase;padding:4px 7px;margin-right:8px;vertical-align:middle}
.status-pill{display:inline-block;border:1px solid var(--ink);font:700 10px/1 var(--font-heading);letter-spacing:.12em;text-transform:uppercase;padding:7px 10px}
.status-pill.inline{border-color:var(--gold);color:var(--gold);margin:0 0 14px}
.button{display:inline-flex;align-items:center;justify-content:center;gap:14px;padding:15px 18px;font:700 13px/1 var(--font-heading);text-decoration:none}
.ghost-button{border:1px solid #555;color:#999;cursor:default}
.black-button{background:var(--ink);color:#fff}
.black-button.disabled{opacity:.45;cursor:default}
.text-link{color:#fff;text-underline-offset:6px;font:700 13px var(--font-heading)}
.brand-tile{display:inline-flex;align-items:center;justify-content:center}.brand-tile img{max-width:170px;height:auto;display:block}.co-brand,.co-lockup{gap:10px}
.brand-x{color:var(--gold);font:600 22px var(--font-heading);padding:0 18px}
.co-brand{display:flex;align-items:center}.hero-side{display:flex;flex-direction:column;gap:22px;align-self:start}
.hero{padding:30px 4vw 0;display:grid;grid-template-columns:1fr .78fr;column-gap:5vw;row-gap:28px;overflow:hidden}
.hero h1{font:500 clamp(48px,5.2vw,80px)/.98 var(--font-heading);letter-spacing:-.065em;margin:14px 0 18px}.hero h1 em{font:400 .98em/.95 var(--font-body);color:var(--gold)}
.lede{max-width:640px;color:#c9c9c5;font:18px/1.55 var(--font-body)}
.hero-actions{display:flex;align-items:center;gap:26px;margin:20px 0 6px}
.hero-card{margin:44px 0 0;background:#fff;padding:26px 26px 18px}
.mark-frame{border:1px solid #e2ddd0;padding:34px 22px;display:flex;align-items:center;justify-content:center}.mark-frame img{width:100%;max-width:330px;height:auto;display:block}
.hero-card figcaption{font:13px/1.5 var(--font-body);color:var(--grey);padding-top:14px}
.prize-band{grid-column:1/-1;background:var(--gold);color:var(--ink);display:flex;align-items:center;gap:22px;padding:18px 24px;margin-top:2px}
.prize-band strong{white-space:nowrap;font:700 clamp(46px,5vw,74px)/.8 var(--font-heading);letter-spacing:-.05em}
.prize-side{display:flex;align-items:center;gap:16px;border-left:2px solid var(--ink);padding-left:20px;font:800 12px/1 var(--font-heading);letter-spacing:.12em;text-transform:uppercase}
.facts{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr);margin:34px 0 0;border-top:1px solid #3a3a38}
.facts div{padding:22px 20px 26px 0;border-right:1px solid #3a3a38}.facts div:not(:first-child){padding-left:20px}
.facts dt{color:#8a8a86;font:700 10px var(--font-heading);letter-spacing:.13em;text-transform:uppercase;margin-bottom:10px}
.facts dd{margin:0;font:15px/1.4 var(--font-body);color:#eee}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:52px}
.section-head h2{font:600 clamp(40px,4.6vw,66px)/.95 var(--font-heading);letter-spacing:-.05em;margin:0}
.brief{padding:96px 4vw 104px}
.brief-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:6vw;align-items:start}
.brief-list{list-style:none;margin:0;padding:0}
.brief-list li{border-top:1px solid #cfc9b8;padding:20px 0;font:17px/1.55 var(--font-body);color:#33322e}
.brief-list strong{font-family:var(--font-heading);letter-spacing:-.01em}
.swatches{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.swatch{border:1px solid #cfc9b8;background:#fff;padding:14px;display:flex;align-items:center;gap:14px}
.chip{width:44px;height:44px;flex-shrink:0;border:1px solid rgba(11,11,12,.15)}
.swatch p{margin:0;font:700 12px/1.35 var(--font-heading)}.swatch small{color:var(--grey);font-weight:400}
.brief-side{display:flex;flex-direction:column;gap:26px}
.type-card{background:#fff;border:1px solid #cfc9b8;padding:30px 34px;margin-top:52px}
.type-card-label{margin:0 0 6px;color:var(--grey)}
.type-row{display:grid;grid-template-columns:120px 1fr;gap:24px;align-items:baseline;border-top:1px solid #e2ddd0;padding:20px 0}
.type-row:last-child{padding-bottom:4px}
.type-tag{font:700 10px/1 var(--font-heading);letter-spacing:.14em;text-transform:uppercase;color:#8a6d2f}
.type-sample{margin:0;color:var(--ink)}
.type-h1{font:600 clamp(30px,3.4vw,44px)/1.05 var(--font-heading);letter-spacing:-.02em}
.type-h2{font:600 24px/1.15 var(--font-heading);letter-spacing:-.01em}
.type-eyebrow{font:700 12px/1.4 var(--font-heading);letter-spacing:.13em;text-transform:uppercase}
.type-body{font:16px/1.7 var(--font-body);max-width:560px}
.enter{padding:92px 4vw 96px}
.enter-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.enter-card{border:1px solid #3a3a38;padding:26px 24px;display:flex;flex-direction:column;transition:border-color .25s,transform .25s}
.enter-card:hover{border-color:var(--gold);transform:translateY(-5px)}
.enter-card h3{font:600 26px/1.1 var(--font-heading);margin:0 0 12px}
.enter-card>p{font:15px/1.55 var(--font-body);color:#b9b9b4;margin:0}
.card-note{color:#8a8a86 !important;font-size:13px !important;margin-top:10px !important}
.pending-list{list-style:none;margin:20px 0 0;padding:18px 0 0;border-top:1px solid #3a3a38;display:grid;gap:10px;font:13px/1.4 var(--font-body);color:#d6d6d1}
.process{padding:96px 4vw 104px}
.timeline{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
.timeline li{border-top:4px solid var(--ink);padding-top:18px;transition:border-color .25s}
.timeline li:hover{border-color:var(--gold)}
.step-num{font:700 12px var(--font-heading);letter-spacing:.13em;color:var(--grey);margin:0}
.timeline h3{font:600 30px/1.05 var(--font-heading);margin:14px 0 8px}
.step-date{font:700 13px var(--font-heading);letter-spacing:.06em;text-transform:uppercase;color:var(--ink);margin:0 0 10px}
.step-date .pending-token{margin-left:10px;margin-right:0}
.timeline li>p:last-child{font:15px/1.55 var(--font-body);color:#44434f;color:var(--grey)}
.judging{padding:92px 4vw;display:grid;grid-template-columns:1fr 1fr;gap:6vw;align-items:start}
.judging h2{font:600 clamp(40px,4.4vw,62px)/.95 var(--font-heading);letter-spacing:-.05em;margin:14px 0 16px}
.judging p{font:16px/1.6 var(--font-body);color:#b9b9b4}
.points-row{display:flex;gap:16px;margin:26px 0 20px}
.point{border:1px solid #3a3a38;padding:18px 22px;text-align:center;flex:1}
.point strong{display:block;font:700 44px/.9 var(--font-heading);color:var(--gold)}
.point span{font:700 10px var(--font-heading);letter-spacing:.12em;text-transform:uppercase;color:#8a8a86}
.pending-line{font:13px/1.5 var(--font-body);color:#d6d6d1}
.swatch.neutral{padding:10px 14px}
.swatch.neutral .chip{width:34px;height:34px}
.brand{padding:96px 4vw 90px}
.brand-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.brand-card{background:#161614;border:1px solid #3a3a38;padding:26px 28px}
.brand-card h3{font:600 12px/1 var(--font-body);letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin:0 0 12px}
.brand-card p{font:500 22px/1.35 var(--font-heading);margin:0;letter-spacing:-.01em;color:#fff}
.brand-card.dark-card{background:var(--gold);border-color:var(--gold)}
.brand-card.dark-card p{color:var(--ink)}
.brand-card.dark-card h3{color:var(--ink)}
.pillars{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin-top:48px}
.pillar{border-top:3px solid var(--gold);padding-top:14px}
.pillar h3{font:600 19px/1.1 var(--font-heading);margin:0 0 8px;color:#fff}
.pillar p{font:13px/1.5 var(--font-body);color:#b9b9b4;margin:0}
.imagery-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:6vw;margin-top:56px;border-top:1px solid #3a3a38;padding-top:40px}
.sub-head{font:600 12px/1 var(--font-body);letter-spacing:.18em;text-transform:uppercase;margin:0 0 16px}
.brand .sub-head{color:var(--gold)}
.body-copy{font:17px/1.55 var(--font-body);color:#b9b9b4;margin:0 0 14px}
.gap-note{font:13px/1.5 var(--font-body);color:#8a8a86;border-left:3px solid var(--gold);padding-left:14px;margin:0}
.channel{border-top:1px solid #3a3a38;padding:14px 0}
.channel h4{font:600 15px/1.1 var(--font-heading);margin:0 0 6px;color:#fff}
.channel p{font:13px/1.5 var(--font-body);color:#b9b9b4;margin:0}
.voice{padding:92px 4vw 96px}
.voice-grid{display:grid;grid-template-columns:1fr 1fr;gap:6vw}
.voice-grid p{font:16px/1.6 var(--font-body);color:#33322e;margin:0 0 14px}
.voice-grid .fine{font-size:13px;color:var(--grey)}
.voice-quote{margin:64px 0 0;border-left:4px solid var(--gold);padding-left:28px}
.voice-quote p{font:500 clamp(26px,3.2vw,42px)/1.25 var(--font-heading);color:var(--ink);margin:0 0 14px;letter-spacing:-.01em}
.voice-quote cite{font:13px/1.5 var(--font-body);color:#8a6d2f;font-style:normal}
.criteria-band{padding:0 4vw 96px;background:var(--cream)}
.criteria-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:18px}
.criterion{border-top:4px solid var(--ink);padding-top:16px;transition:border-color .25s}
.criterion:hover{border-color:var(--gold)}
.criterion>strong{font:700 40px/.9 var(--font-heading);color:var(--gold);letter-spacing:-.03em}.criterion>strong .pct{font-size:.55em}
