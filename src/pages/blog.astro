---
import Base from '../layouts/Base.astro';
import BlogShell from '../components/BlogShell.astro';
import BlogList from '../components/BlogList.astro';
import { posts, POSTS_PER_PAGE } from '../lib/blog';

const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
---

<Base title="Arizona Microcredit Initiative | BLOG" description="Read the latest news about what our organization is doing in the community!">
  <link slot="head" rel="alternate" type="application/rss+xml" title="Arizona Microcredit Initiative blog" href="/blog-feed.xml" />
  <BlogShell>
    <BlogList posts={posts.slice(0, POSTS_PER_PAGE)} current={1} totalPages={totalPages} basePath="/blog" />
  </BlogShell>
</Base>
