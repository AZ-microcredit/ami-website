---
import Base from '../layouts/Base.astro';
const services = [
  { title: 'MICROLOANS', href: '/loans', image: 'a38016_fd00a530c28c4050be549656fc31fae3.png', text: 'Unlock the funding your small business needs with AMI, where lower credit barriers and specialized expertise make microloans more accessible than traditional banks.' },
  { title: 'FREE CONSULTING', href: '/consulting', image: 'a38016_82beaebca0b6424db16e3c0537bdc20e.png', text: "AMI provides free, one-on-one business consulting tailored to your needs, whether you're launching a startup or expanding your business, with expert advisors specializing in a variety of fields." },
  { title: 'BUSINESS EDUCATION', href: '/education', image: 'a38016_10163871fbdc484994120ad3806850ad.png', text: 'AMI empowers small business owners with free access to online educational materials and expert-led workshops on a variety of business topics. Explore our resources and start learning today!' },
];
const stats = [
  { icon: 'globe', value: '75+', label: 'Entrepreneurs empowered' },
  { icon: 'tag', value: '$70,000', label: 'Distributed in low-interest loans' },
  { icon: 'mail', value: '40+', label: 'Impacted through business education' },
  { icon: 'chart', value: '100+', label: 'Businesses impacted through our services' },
];
const partners = ['760f7c_cec1a284171e4ef5a76233fd8f20363d.png', '760f7c_33bbe4d0fb4e434485d2f778a5750068.png', '760f7c_13af0323c83045f19b6719aac223561c.png', '760f7c_c0b6bfcaf17b46969834a36c57743203.png'];
---
<Base title="Arizona Microcredit Initiative | HOME">
  <section class="video-hero">
    <!-- INTEGRATION: Original Wix video requires a signed playback URL; retain its local poster. -->
    <div class="poster"><img src="/media/760f7c_013518b47d384b4fa36f2c98a49e047bf000.jpg" alt="AMI meeting with entrepreneurs" /><p>OPENING DOORS FOR<br />ENTREPRENEURS IN<br />GREATER PHOENIX</p></div>
  </section>
  <section class="about">
    <h1 class="ruled">ABOUT US</h1>
    <p>Arizona Microcredit Initiative is a 501(c)(3) nonprofit that empowers underserved entrepreneurs to start or expand businesses through free consulting services, low interest microloans and free business instruction.</p>
  </section>
  <section class="expertise">EXPERTISE THAT TRANSLATE INTO YOUR BUSINESS GROWTH</section>
  <section class="impact">
    <h2 class="ruled">OUR IMPACT</h2>
    <div class="services">
      {services.map(service => <article><a href={service.href} aria-label={service.title}><img src={`/media/${service.image}`} alt="" /></a><h3>{service.title}</h3><p>{service.text}</p><a class="btn btn-green" href={service.href}>Learn more</a></article>)}
    </div>
    <div class="stats">
      {stats.map(stat => <div><img src={`/icons/${stat.icon}.svg`} alt="" /><p class="value">{stat.value}</p><p>{stat.label}</p></div>)}
    </div>
  </section>
  <section class="testimonials">
    <h2>TESTIMONIALS</h2>
    <!-- Original unpublished draft contains placeholder testimonial copy. -->
    <blockquote>[insert text]</blockquote>
  </section>
  <section class="partners">
    <h2>OUR<br />PARTNERS</h2>
    <div>{partners.map(image => <img src={`/media/${image}`} alt="AMI community partner" loading="lazy" />)}</div>
  </section>
  <section class="community">
    <h2>JOIN THE AMI COMMUNITY</h2>
    <p>Join our email listen to get special access to our newsletter</p>
    <!-- INTEGRATION: Connect the newsletter signup to an email provider before enabling submission. -->
    <form>
      <label for="newsletter-email">Enter your email here *</label>
      <div><input id="newsletter-email" type="email" name="email" required disabled /><button type="button" disabled>Sign Up</button></div>
      <p class="status">Newsletter signup is currently unavailable.</p>
    </form>
  </section>
</Base>
<style>
  .video-hero { background: #6bb748; padding: 60px max(20px, calc((100% - 1086px) / 2)); }
  .poster { position: relative; overflow: hidden; aspect-ratio: 1086 / 526; }
  .video-hero img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.18); }
  .poster p { position: absolute; right: 5%; bottom: 13%; width: 39%; color: white; text-align: center; font: bold clamp(16px, 3vw, 38px)/1.1 Impact, 'AMI Sans',sans-serif; }
  .about { max-width: 940px; margin: auto; padding: 0 20px 58px; text-align: center; }
  .ruled { display: flex; align-items: center; gap: 24px; justify-content: center; font: 30px var(--font-bold); letter-spacing: .4em; }
  .ruled::before, .ruled::after { content: ''; flex: 1; height: 2px; background: currentColor; }
  .about h1 { transform: translateY(-17px); }
  .about p { margin-top: 36px; font: 25px/1.4 var(--font-bold); }
  .expertise { padding: 22px 20px; text-align: center; background: var(--green); color: white; font: 30px var(--font-bold); }
  .impact { max-width: var(--content-width); margin: auto; padding: 40px 20px 48px; }
  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 55px; margin-top: 66px; text-align: center; }
  .services article { display: flex; flex-direction: column; align-items: center; }
  .services img { width: 50px; height: 50px; object-fit: contain; margin: 0 auto 40px; }
  .services h3 { font: 24px var(--font-bold); margin-bottom: 22px; }
  .services p { font: 18px/1.4 var(--font-bold); margin-bottom: 16px; }
  .services .btn { margin-top: auto; font: 16px var(--font-avenir-light); padding: 10px 30px; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 90px; text-align: center; }
  .stats img { width: 26px; height: 26px; margin: 0 auto 42px; }
  .stats .value { font: 60px var(--font-bold); color: var(--green); margin-bottom: 30px; }
  .stats p { font: 20px/1.2 var(--font-bold); }
  .testimonials { background: var(--green); color: white; min-height: 400px; padding: 100px 20px; text-align: center; }
  .testimonials h2 { font: 25px var(--font-bold); letter-spacing: .4em; }
  .testimonials blockquote { margin-top: 60px; font: 20px var(--font-bold); }
  .partners { max-width: 1000px; margin: auto; min-height: 370px; padding: 110px 20px 50px; display: flex; gap: 40px; }
  .partners h2, .community h2 { font: 30px/1.5 var(--font-bold); letter-spacing: .4em; }
  .partners h2 { border-right: 2px solid; padding-right: 32px; align-self: flex-start; }
  .partners > div { display: flex; flex-wrap: wrap; gap: 20px; }
  .partners img { width: 110px; height: 110px; object-fit: contain; }
  .community { max-width: 960px; margin: auto; padding: 30px 20px 90px; text-align: center; }
  .community > p { margin: 20px 0 30px; font: 18px var(--font-bold); }
  form { text-align: left; } label { display: block; font-size: 14px; margin-bottom: 5px; }
  form > div { display: flex; } input { flex: 1; min-width: 0; border: 1px solid #444; background: white; padding: 10px; }
  button { width: 230px; border: 0; background: var(--green); color: white; font: 16px var(--font-avenir-light); }
  .status { margin-top: 8px; font-size: 14px; }
  @media (max-width: 900px) { .services { gap: 24px; } .stats { grid-template-columns: repeat(2, 1fr); gap: 32px; } .partners { flex-direction: column; } .partners h2 { border: 0; } }
  @media (max-width: 600px) { .video-hero { padding: 24px 16px 40px; } .ruled { font-size: 22px; gap: 12px; letter-spacing: .2em; } .about p { font-size: 20px; } .expertise { font-size: 22px; } .services { grid-template-columns: 1fr; gap: 48px; } .stats .value { font-size: 38px; } .stats p { font-size: 16px; } .partners { padding-top: 50px; } .community h2 { font-size: 24px; letter-spacing: .2em; } button { width: 110px; } }
</style>
