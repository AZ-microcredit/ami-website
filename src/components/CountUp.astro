---
interface Props { value:number; suffix?:string; prefix?:string; }
const {value,suffix='',prefix=''}=Astro.props;
const formatted=prefix+value.toLocaleString('en-US')+suffix;
---
<strong class="count-up" data-value={value} data-prefix={prefix} data-suffix={suffix}><span class="sr-only">{formatted}</span><span class="count-visual" aria-hidden="true">{formatted}</span></strong>
<script>
 const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
 const counters = document.querySelectorAll<HTMLElement>('.count-up');
 const render=(el:HTMLElement,val:number)=>{
  const visual=el.querySelector<HTMLElement>('.count-visual');
  if(visual) visual.textContent=(el.dataset.prefix||'')+val.toLocaleString('en-US')+(el.dataset.suffix||'');
 };
 if ('IntersectionObserver' in window) {
  const run=(el:HTMLElement)=>{
   const value=Number(el.dataset.value);
   if(reduced.matches){ render(el,value); return; }
   const start=performance.now();
   const tick=(now:number)=>{
    const progress=reduced.matches?1:Math.min((now-start)/1700,1);
    render(el,Math.round(value*(1-Math.pow(1-progress,3))));
    if(progress<1) requestAnimationFrame(tick);
   };
   requestAnimationFrame(tick);
  };
  // Count once on first meaningful visibility, then keep the final value.
  if(!reduced.matches) counters.forEach(el=>render(el,0));
  const observer = new IntersectionObserver(entries => {
   for (const entry of entries) {
    if (!entry.isIntersecting) continue;
    const el = entry.target as HTMLElement;
    observer.unobserve(el);
    run(el);
   }
  },{threshold:.35});
  counters.forEach(el=>observer.observe(el));
 } else {
  counters.forEach(el=>render(el,Number(el.dataset.value)));
 }
</script>
<style>.count-up{font-variant-numeric:tabular-nums;white-space:nowrap}.count-visual{font:inherit!important;color:inherit!important}</style>
