---
interface Props { value:number; suffix?:string; prefix?:string; }
const {value,suffix='',prefix=''}=Astro.props;
const formatted=prefix+value.toLocaleString('en-US')+suffix;
---
<strong class="count-up" data-value={value} data-prefix={prefix} data-suffix={suffix}><span class="sr-only">{formatted}</span><span class="count-visual" aria-hidden="true">{formatted}</span></strong>
<script>
 const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
 const counters = document.querySelectorAll<HTMLElement>('.count-up');
 if (!reduced.matches && 'IntersectionObserver' in window) {
  const observer = new IntersectionObserver(entries => {
   for (const entry of entries) {
    if (!entry.isIntersecting) continue;
    const el = entry.target as HTMLElement;
    observer.unobserve(el);
    const visual=el.querySelector<HTMLElement>('.count-visual');
    if(!visual) continue;
    const value=Number(el.dataset.value), prefix=el.dataset.prefix||'',suffix=el.dataset.suffix||'';
    const start=performance.now();
    const tick=(now:number)=>{
     const progress=reduced.matches?1:Math.min((now-start)/950,1);
     visual.textContent=prefix+Math.round(value*(1-Math.pow(1-progress,3))).toLocaleString('en-US')+suffix;
     if(progress<1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
   }
  },{threshold:.6});
  counters.forEach(el=>observer.observe(el));
 }
</script>
<style>.count-up{font-variant-numeric:tabular-nums;white-space:nowrap}.count-visual{font:inherit!important;color:inherit!important}</style>
