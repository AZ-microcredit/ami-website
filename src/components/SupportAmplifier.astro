---
import Icon from './Icon.astro';
---
<section class="support-amplifier" id="support-in-motion" aria-labelledby="amplifier-title">
 <div class="skip-holder"><a class="scene-skip" href="#main">Skip this animation</a></div>
 <div class="amplifier-stage">
  <header><p>What your support makes possible</p><h2 id="amplifier-title">A little from you.<br/><em>A lot to build on.</em></h2></header>
  <div class="amplifier-lines">
   <article><div class="word-window"><h3>KNOWLEDGE<span aria-hidden="true"><Icon name="arrow-up-right" /></span></h3></div><p>Help keep business workshops and educational resources free to explore.</p></article>
   <article><div class="word-window"><h3>CONFIDENCE<span aria-hidden="true">+</span></h3></div><p>Support personalized consulting for entrepreneurs facing their next challenge.</p></article>
   <article><div class="word-window"><h3>POSSIBILITY<span aria-hidden="true"><Icon name="spark" /></span></h3></div><p>Support AMI’s mission to make capital more accessible for small businesses.</p></article>
  </div>
  <footer><a href="#donate">Help make it possible <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a><p>Local people.<br/>Lasting potential.</p></footer>
 </div>
</section>
<style>
.support-amplifier{background:var(--green);color:#111;overflow:clip}.skip-holder{display:none;position:sticky;top:calc(var(--header-height) + 8px);height:0;z-index:6;overflow:visible}.support-amplifier.is-amplifying .skip-holder{display:block}.scene-skip{position:absolute;left:5vw;top:0;background:#111;color:#fff;padding:8px 12px;font:var(--text-label) var(--font-heading);text-decoration:none;opacity:0;pointer-events:none;transition:opacity .15s}.scene-skip:focus-visible{opacity:1;pointer-events:auto}.amplifier-stage{padding:64px 5vw}.amplifier-stage header>p{font:var(--text-label)/1.5 var(--font-heading);text-transform:uppercase;letter-spacing:.12em;margin-bottom:24px}.amplifier-stage h2{font:500 var(--text-display)/1 var(--font-heading);letter-spacing:-.055em;margin-bottom:38px}.amplifier-stage h2 em{font-family:var(--font-body);font-weight:400}.amplifier-lines article{display:grid;grid-template-columns:1.75fr 1fr;align-items:center;gap:6vw;border-top:1px solid #1115;padding:22px 0}.amplifier-lines article:last-child{border-bottom:1px solid #1115}.word-window{overflow:hidden;padding:5px 0}.amplifier-lines h3{font:700 var(--text-display)/.95 var(--font-heading);letter-spacing:-.065em;display:flex;align-items:center;justify-content:space-between;gap:18px}.amplifier-lines h3 span{font-weight:400;color:white}.amplifier-lines article>p{font:var(--text-body)/1.6 var(--font-body);max-width:350px}.amplifier-stage footer{display:flex;justify-content:space-between;align-items:center;gap:30px;margin-top:32px}.amplifier-stage footer a{background:#111;color:white;padding:18px 24px;display:inline-flex;gap:38px;align-items:center;text-decoration:none;font:var(--text-label)/1.5 var(--font-heading)}.amplifier-stage footer>p{font:var(--text-label)/1.4 var(--font-body)}
.support-amplifier.is-amplifying{height:calc(250vh*var(--tempo-scale,1))}.is-amplifying .amplifier-stage{position:sticky;top:var(--header-height);height:calc(100vh - var(--header-height));height:calc(100svh - var(--header-height));display:flex;flex-direction:column;justify-content:center;padding-top:30px;padding-bottom:30px}.is-amplifying .amplifier-lines h3{transform:translateY(calc((1 - var(--reveal,1))*115%)) rotate(calc((1 - var(--reveal,1))*7deg));transform-origin:left bottom}.is-amplifying .amplifier-lines h3 span{transform:rotate(calc((1 - var(--reveal,1))*-160deg))}.is-amplifying .amplifier-lines article>p{opacity:calc(.2 + var(--reveal,1)*.8);transform:translateX(calc((1 - var(--reveal,1))*35px))}
.is-flow .word-window{overflow:visible}.is-flow .amplifier-lines h3{transform:translateY(calc((1 - var(--reveal,1))*8px));transform-origin:left bottom}.is-flow .amplifier-lines h3 span{transform:rotate(calc((1 - var(--reveal,1))*-20deg))}.is-flow .amplifier-lines article>p{opacity:calc(.75 + var(--reveal,1)*.25);transform:translateX(calc((1 - var(--reveal,1))*8px))}
@media(max-width:900px){.amplifier-stage{padding:52px 22px}.amplifier-lines article{grid-template-columns:1fr;gap:16px;padding:25px 0}.amplifier-lines h3{font-size:var(--text-display)}.amplifier-lines article>p{max-width:550px}.amplifier-stage footer>p{display:none}}

/* Keep the word and its icon together inside narrow phone columns. */
@media (max-width: 600px) {
 .amplifier-lines h3 { font-size: var(--text-heading); }
 .amplifier-lines h3 span { flex-shrink: 0; }
}
</style>
<script>
 import { createScrollScene, reducedMotion, viewportHeight, headerHeight, clamp01, localProgress, beat, setupSkipLink } from '../scripts/motion/engine';
 const amplifier=document.querySelector<HTMLElement>('.support-amplifier');
 if(amplifier){
  const stage=amplifier.querySelector<HTMLElement>('.amplifier-stage')!;
  const rows=[...amplifier.querySelectorAll<HTMLElement>('.amplifier-lines article')];
  let overlay=false;
  setupSkipLink(amplifier);
  createScrollScene({
   root:amplifier,
   margin:420,
   smooth:true,
   measure:()=>{
    const stageBlock=viewportHeight()-headerHeight();
    amplifier.classList.remove('is-amplifying');amplifier.classList.remove('is-flow');
    // Sticky word-window reveal whenever the measured content fits the stage;
    // otherwise the same reveal runs per row in normal flow.
    const need=stage.scrollHeight;
    overlay=!reducedMotion()&&stageBlock>=need&&window.innerWidth>=640;
    amplifier.classList.toggle('is-amplifying',overlay);
    amplifier.classList.toggle('is-flow',!overlay&&!reducedMotion());
   },
   render:(f)=>{
    if(f.reduced){rows.forEach(row=>row.style.setProperty('--reveal','1'));return}
    if(overlay){
     const p=beat(clamp01((f.header-f.top)/Math.max(1,f.height-f.vh+f.header)))*.76;
     rows.forEach((row,i)=>{const q=clamp01((p-i*.23)/.3);row.style.setProperty('--reveal',String(1-Math.pow(1-q,3)));});
    }else{
     rows.forEach(row=>{const r=row.getBoundingClientRect();const q=localProgress(r,f.vh,.95,.9);row.style.setProperty('--reveal',String(1-Math.pow(1-q,3)));});
    }
   },
  });
 }
</script>
