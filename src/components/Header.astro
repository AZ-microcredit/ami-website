---
import { nav, social } from '../data/nav.js';
// build.format 'file' makes pathname end in .html on static builds; normalize to the clean slug.
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
// Child hrefs carry #anchors; Astro.url.pathname never includes the hash, so compare paths only.
const pathOf = (href) => href.split('#')[0];
const isActive = (item) =>
  pathOf(item.href) === current || item.children?.some((c) => pathOf(c.href) === current);
---

<header class="site-header">
  <div class="header-inner">
    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
      <span></span><span></span><span></span>
    </button>

    <a class="logo" href="/" aria-label="Arizona Microcredit Initiative home">
      <img src="/media/ami-official-black.png" alt="Arizona Microcredit Initiative's Logo" width="180" height="58" />
    </a>

    <nav class="main-nav" aria-label="Site">
      <ul>
        {nav.map((item) => (
          <li class:list={['nav-item', { 'has-children': item.children.length, active: isActive(item) }]}>
            <a href={item.href}>{item.label}</a>
            {item.children.length > 0 && (
              <ul class="dropdown">
                {item.children.map((c) => (
                  <li><a href={c.href} class:list={{ active: pathOf(c.href) === current }}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a class="header-cta" href="/copy-2-of-consulting#schedule"><span class="cta-desktop">Book a free consultation</span><span class="cta-mobile">Book a free call</span><span aria-hidden="true">↗</span></a>
    <div class="social">
      <a href={social.facebook} target="_blank" rel="noopener"><img src="/media/4057345bcf57474b96976284050c00df.png" alt="Facebook - Black Circle" width="28" height="28" /></a>
      <a href={social.instagram} target="_blank" rel="noopener"><img src="/media/e1aa082f7c0747168d9cf43e77046142.png" alt="Instagram - Black Circle" width="28" height="28" /></a>
      <a href={social.linkedin} target="_blank" rel="noopener"><img src="/media/aa0402eb9ba2430d9d0620b59556efca.png" alt="LinkedIn" width="28" height="28" /></a>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Site (mobile)" hidden>
    <ul>
      {nav.map((item) => (
        <li>
          <a href={item.href} class:list={{ active: isActive(item) }}>{item.label}</a>
          {item.children.length > 0 && (
            <ul>
              {item.children.map((c) => (
                <li><a href={c.href}>{c.label}</a></li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <div class="social">
      <a href={social.facebook} target="_blank" rel="noopener"><img src="/media/4057345bcf57474b96976284050c00df.png" alt="Facebook" width="28" height="28" /></a>
      <a href={social.instagram} target="_blank" rel="noopener"><img src="/media/e1aa082f7c0747168d9cf43e77046142.png" alt="Instagram" width="28" height="28" /></a>
      <a href={social.linkedin} target="_blank" rel="noopener"><img src="/media/aa0402eb9ba2430d9d0620b59556efca.png" alt="LinkedIn" width="28" height="28" /></a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const mobile = document.getElementById('mobile-nav');
  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open menu');
    if (mobile) mobile.hidden = true;
    document.body.classList.remove('nav-open');
  };
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    if (open) { closeMenu(); return; }
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close menu');
    if (mobile) mobile.hidden = false;
    document.body.classList.add('nav-open');
  });
  // Tapping any link in the mobile menu (parent or section anchor) closes it.
  mobile?.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('a')) closeMenu();
  });
</script>

<style>
  .header-inner > .social { display:none; }
  .header-cta { display:flex; gap:18px; align-items:center; padding:9px 14px; background:var(--green); color:#111; text-decoration:none; font:11px Helvetica,Arial,sans-serif; white-space:nowrap; }
 .header-cta>span[aria-hidden]{font-size:16px}.cta-mobile{display:none} .header-cta:hover{background:#73c55a}
 .nav-item>a{text-transform:capitalize}

  .site-header { border-bottom: 1px solid #ddd; background: var(--white); position: sticky; top: 0; z-index: 50; }
  .header-inner {
    max-width: 1600px;
    margin: 0 auto;
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4.2vw;
    gap: 20px;
  }
  .logo img { width: 118px; height: auto; }

  .main-nav > ul { display: flex; align-items: center; gap: 0; }
  .nav-item { position: relative; }
  .nav-item > a {
    display: block;
    padding: 12px 12px;
    font-family: var(--font-bold);
    font-size: 14px;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--black);
    white-space: nowrap;
  }
  .nav-item > a:hover { color: var(--green-dark); }
  .nav-item.active > a { color: var(--green-dark); text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 190px;
    background: var(--white);
    box-shadow: 0 1px 6px rgba(0,0,0,.25);
    padding: 6px 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity .15s, transform .15s, visibility .15s;
  }
  .nav-item:hover .dropdown, .nav-item:focus-within .dropdown { opacity: 1; visibility: visible; transform: none; }
  .dropdown a {
    display: block;
    padding: 6px 18px;
    font-family: var(--font-avenir-heavy);
    font-size: 13px;
    text-decoration: none;
    color: var(--black);
    white-space: nowrap;
  }
  .dropdown a:hover, .dropdown a.active { color: var(--green-dark); }

  .social { display: flex; gap: 8px; align-items: center; }
  .social img { width: 28px; height: 28px; transition: opacity .2s; }
  .social a:hover img { opacity: .7; }

  .menu-toggle { display: none; background: none; border: 0; padding: 8px; cursor: pointer; width: 40px; height: 40px; flex-direction: column; justify-content: center; gap: 5px; }
  .menu-toggle span { display: block; height: 2px; background: var(--black); border-radius: 1px; }
  .mobile-nav { display: none; }

  @media (max-width: 900px) {
 .cta-desktop{display:none}.cta-mobile{display:inline}
    .main-nav, .header-inner > .social { display: none; }
 .header-cta{margin-left:auto;padding:8px 10px;gap:10px}
    .menu-toggle { display: flex; }
    .header-inner { height: 60px; justify-content: flex-start; }
    .logo { margin: 0; }
    .logo img { width: 100px; }

    .mobile-nav { display: block; border-top: 1px solid #eee; padding: 10px 20px 24px; background: var(--white); }
    .mobile-nav[hidden] { display: none; }
    .mobile-nav > ul > li > a { display: block; padding: 12px 0; font-family: var(--font-bold); font-size: 16px; text-decoration: none; color: var(--black); }
    .mobile-nav > ul > li > a.active { color: var(--green-dark); }
    .mobile-nav ul ul { padding-left: 16px; padding-bottom: 6px; }
    .mobile-nav ul ul a { display: block; padding: 8px 0; font-family: var(--font-avenir-heavy); font-size: 14px; text-decoration: none; color: #333; }
    .mobile-nav .social { margin-top: 16px; }
  }
</style>
