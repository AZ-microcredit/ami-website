 <a class="landing-skip" href="#support">Skip to services ↓</a>
</section>
<script>
 const root=document.querySelector<HTMLElement>('.landing-experience');
 if(root){
  const reduced=matchMedia('(prefers-reduced-motion: reduce)');
  const front=root.querySelector<HTMLElement>('.landing-front')!;
  const next=root.querySelector<HTMLElement>('.landing-next')!;
  let frame=0;
  function update(){frame=0;const animated=!reduced.matches&&innerWidth>=800&&innerHeight>=700;root!.classList.toggle('is-cinematic',animated);
   if(!animated){root!.style.setProperty('--turn','1');front.inert=false;next.inert=false;front.removeAttribute('aria-hidden');next.removeAttribute('aria-hidden');return}
   const rect=root!.getBoundingClientRect();const header=parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height'))||72;
   const travel=root!.offsetHeight-(innerHeight-header);const raw=Math.max(0,Math.min(1,(header-rect.top)/Math.max(1,travel)));
   const progress=Math.max(0,Math.min(1,(raw-.06)/.80));const eased=progress*progress*(3-2*progress);
   root!.style.setProperty('--turn',String(eased));
   const nextVisible=progress>.72;front.inert=nextVisible;next.inert=!nextVisible;front.setAttribute('aria-hidden',String(nextVisible));next.setAttribute('aria-hidden',String(!nextVisible));
  }
  const queue=()=>{if(!frame)frame=requestAnimationFrame(update)};
  addEventListener('scroll',queue,{passive:true});addEventListener('resize',queue);reduced.addEventListener('change',queue);update();
 }
</script>
<style>
