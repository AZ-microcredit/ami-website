---
import Icon from './Icon.astro';
---
<section class="landing-experience" aria-label="Welcome to AMI">
 <div class="landing-stage">
  <a class="landing-skip" href="#main">Skip the introduction</a>
  <div class="landing-front"><slot/></div>
  <div class="landing-next">
   <p class="chapter">Your next chapter / Arizona Microcredit Initiative</p>
   <h2>You bring<br/>the ambition.<br/><span>We’ll bring the support.</span></h2>
   <div class="landing-paths"><a href="/copy-of-loans"><span>01</span>Capital to get moving.<b aria-hidden="true"><Icon name="arrow-up-right" /></b></a><a href="/copy-2-of-consulting"><span>02</span>A team in your corner.<b aria-hidden="true"><Icon name="arrow-up-right" /></b></a><a href="/copy-of-education"><span>03</span>Knowledge to grow.<b aria-hidden="true"><Icon name="arrow-up-right" /></b></a></div>
   <div class="landing-next-bottom"><a class="landing-book" href="#book-a-call">Let’s talk about your business <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div>
  </div>
 </div>

</section>
<script>
 import { createScrollScene, reducedMotion, viewportHeight, headerHeight, clamp01, localProgress, beat, setupSkipLink } from '../scripts/motion/engine';
 const root=document.querySelector<HTMLElement>('.landing-experience');
 if(root){
  const front=root.querySelector<HTMLElement>('.landing-front')!;
  const next=root.querySelector<HTMLElement>('.landing-next')!;
  const stage=root.querySelector<HTMLElement>('.landing-stage')!;
  let overlay=false;
  let focusTurn:number|null=null;

  root.addEventListener('focusin',event=>{
   if(!overlay)return;
   // A focused link must be reachable: settle the scene on the panel that owns it.
   focusTurn=next.contains(event.target as Node)?1:0;
   root.style.setProperty('--turn',String(focusTurn));
  });
  root.addEventListener('focusout',()=>{focusTurn=null});

  setupSkipLink(root);
  createScrollScene({
   root,
   margin:420,
   smooth:true,
   measure:()=>{
    root.classList.remove('is-curtain');
    // Measure the panels inside the cinematic layout itself: the page-turn
    // runs whenever both measured panels fit the sticky stage it would use.
    root.style.removeProperty('--landing-pad-y');
    root.classList.add('is-cinematic');
    const stageBlock=stage.offsetHeight;
    // Browser chrome can leave a 1366x768 laptop with only ~650px of page
    // viewport at 100% zoom. Compress only the hero's vertical breathing room,
    // and only by the measured shortage, before abandoning the page turn.
    const frontShortage=Math.max(0,front.scrollHeight-stageBlock);
    if(frontShortage>0){
     const copy=front.querySelector<HTMLElement>('.opening-copy');
     const pad=parseFloat(getComputedStyle(copy!).paddingTop);
     const fittedPad=Math.max(24,pad-Math.ceil(frontShortage/2)-2);
     root.style.setProperty('--landing-pad-y',`${fittedPad}px`);
    }
    const fits=front.scrollHeight<=stageBlock+4&&next.scrollHeight<=stageBlock-20;
    overlay=!reducedMotion()&&stageBlock>=420&&fits;
    root.classList.toggle('is-cinematic',overlay);
    root.classList.toggle('is-curtain',!overlay&&!reducedMotion());
   },
   render:(f)=>{
    if(f.reduced){root.style.setProperty('--turn','1');return}
    if(overlay){
     const travel=root.offsetHeight-stage.offsetHeight;
     const raw=clamp01((f.header-f.top)/Math.max(1,travel));
     const progress=beat(raw);
     const eased=progress*progress*(3-2*progress);
     root.style.setProperty('--turn',String(focusTurn??eased));
    }else{
     const fr=front.getBoundingClientRect();
     const frontPass=clamp01((f.vh-fr.bottom)/Math.max(1,f.vh*.5));
     root.style.setProperty('--lift',String((44*frontPass).toFixed(1)));
     root.style.setProperty('--front-o',String(1-.45*frontPass));
     const nr=next.getBoundingClientRect();
     root.style.setProperty('--next-in',String(localProgress(nr,f.vh,.95,.8)));
    }
   },
  });
 }
</script>
<style>
.landing-experience{--turn:0;background:#111;position:relative}.landing-stage{position:relative}.landing-next{background:var(--green);color:#111;padding:55px 5vw;display:flex;flex-direction:column;justify-content:center;gap:28px}.chapter{font:11px/1.6 'AMI Sans',sans-serif;letter-spacing:.12em;text-transform:uppercase}.landing-next h2{font:500 clamp(44px,5.8vw,88px)/.98 'AMI Sans',sans-serif;letter-spacing:-.06em}.landing-next h2>span{color:white}.landing-paths{max-width:1000px}.landing-paths>a{display:flex;gap:25px;align-items:center;text-decoration:none;border-top:1px solid #1115;padding:16px 0;font:400 clamp(23px,2.4vw,38px)/1.1 'AMI Sans',sans-serif;letter-spacing:-.035em}.landing-paths>a:last-child{border-bottom:1px solid #1115}.landing-paths>a>span{font:11px 'AMI Sans',sans-serif;letter-spacing:0}.landing-paths b{margin-left:auto;font-weight:400}.landing-paths a:hover{color:white}.landing-next-bottom{display:flex;align-items:end;justify-content:space-between;gap:25px}.landing-book{display:inline-flex;gap:40px;padding:18px 24px;background:#111;color:white;text-decoration:none;font:14px/1.5 'AMI Sans',sans-serif}.landing-book span{font-size:22px;line-height:1}.landing-next-bottom p{font:16px/1.4 'AMI Serif',serif}.landing-skip{display:none}
.is-cinematic{height:calc(320vh*var(--tempo-scale,1))}.is-cinematic .landing-stage{position:sticky;top:var(--header-height);height:min(820px,calc(100vh - var(--header-height)));height:min(820px,calc(100svh - var(--header-height)));overflow:clip;perspective:1900px;isolation:isolate}.is-cinematic .landing-front{height:100%;transform-origin:left center;transform:translate3d(calc(var(--turn)*-28%),0,calc(var(--turn)*-180px)) rotateY(calc(var(--turn)*12deg));opacity:calc(1 - var(--turn))}.is-cinematic .landing-front :global(.opening){height:100%;min-height:0}.is-cinematic .landing-front :global(.opening-copy){padding:var(--landing-pad-y,clamp(32px,4vw,64px)) 5vw;justify-content:center}.is-cinematic .landing-front :global(.opening h1){font-size:clamp(52px,5.6vw,100px)}.is-cinematic .landing-front :global(.opening-bottom){margin-top:24px;padding-top:0}.is-cinematic .landing-front :global(.opening-visual img){transform:scale(1.08)}.is-cinematic .landing-next{position:absolute;inset:12px;transform-origin:left center;transform:translate3d(calc((1 - var(--turn))*104%),0,0) rotateY(calc((1 - var(--turn))*-68deg)) scale(calc(.91 + var(--turn)*.09));backface-visibility:hidden;box-shadow:-22px 0 65px #0005}.is-cinematic .landing-skip{display:block;position:absolute;left:5vw;bottom:14px;z-index:5;background:#111;color:white;padding:8px 12px;font:12px 'AMI Sans',sans-serif;text-underline-offset:5px;opacity:0;pointer-events:none;transition:opacity .15s}.is-cinematic .landing-skip:focus-visible{opacity:1;pointer-events:auto}
.is-curtain .landing-front{transform:translate3d(0,calc(var(--lift,0)*-1px),0);opacity:var(--front-o,1)}.is-curtain .landing-next{transform:translate3d(0,calc((1 - var(--next-in,1))*56px),0);opacity:calc(.25 + var(--next-in,1)*.75)}
@media(max-width:799px),(max-height:699px){.landing-next{padding:45px 22px;gap:30px}.landing-next h2{font-size:clamp(42px,8vw,65px)}.landing-next-bottom{align-items:start;flex-direction:column}.landing-paths>a{font-size:23px;padding:20px 0;gap:15px}.landing-next-bottom p{display:none}}

.is-cinematic .landing-next{gap:clamp(14px,2.5vh,28px);padding:clamp(24px,4vh,50px) 5vw}.is-cinematic .landing-next h2{font-size:clamp(44px,min(5.8vw,9vh),88px)}.is-cinematic .landing-paths>a{font-size:clamp(23px,min(2.4vw,3.5vh),38px);padding:12px 0}
</style>
