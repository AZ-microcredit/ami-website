.is-cinematic{height:235vh}.is-cinematic .landing-stage{position:sticky;top:var(--header-height);height:calc(100vh - var(--header-height));overflow:clip;perspective:1900px;isolation:isolate}.is-cinematic .landing-front{height:100%;transform-origin:left center;transform:translate3d(calc(var(--turn)*-28%),0,calc(var(--turn)*-180px)) rotateY(calc(var(--turn)*12deg));opacity:calc(1 - var(--turn))}.is-cinematic .landing-front :global(.opening){height:100%;min-height:0}.is-cinematic .landing-front :global(.opening-copy){padding-top:40px;padding-bottom:40px}.is-cinematic .landing-front :global(.opening h1){font-size:clamp(48px,4.8vw,76px)}.is-cinematic .landing-front :global(.opening-bottom){margin-top:24px;padding-top:0}.is-cinematic .landing-front :global(.opening-visual img){transform:scale(1.08)}.is-cinematic .landing-next{position:absolute;inset:12px;transform-origin:left center;transform:translate3d(calc((1 - var(--turn))*104%),0,0) rotateY(calc((1 - var(--turn))*-68deg)) scale(calc(.91 + var(--turn)*.09));backface-visibility:hidden;box-shadow:-22px 0 65px #0005}.is-cinematic .landing-skip{display:block;position:absolute;left:5vw;bottom:14px;color:white;font:12px Helvetica,Arial,sans-serif;text-underline-offset:5px}
@media(max-width:799px),(max-height:699px){.landing-next{padding:45px 22px;gap:30px}.landing-next h2{font-size:clamp(42px,8vw,65px)}.landing-next-bottom{align-items:start;flex-direction:column}.landing-paths>a{font-size:23px;padding:20px 0;gap:15px}.landing-next-bottom p{display:none}}

.is-cinematic .landing-next{gap:clamp(14px,2.5vh,28px);padding:clamp(24px,4vh,50px) 5vw}.is-cinematic .landing-next h2{font-size:clamp(44px,min(5.8vw,9vh),88px)}.is-cinematic .landing-paths>a{font-size:clamp(23px,min(2.4vw,3.5vh),38px);padding:12px 0}
</style>
