<div class="services-scroll"><slot/></div>
<script>
 const scene=document.querySelector<HTMLElement>('.services-scroll');
 if(scene){const cards=[...scene.querySelectorAll<HTMLElement>('.service-card')];const reduced=matchMedia('(prefers-reduced-motion: reduce)');let frame=0;
  const update=()=>{frame=0;const enabled=innerWidth>=900&&innerHeight>=800&&!reduced.matches;scene.classList.toggle('is-stacked',enabled);
   if(!enabled){cards.forEach(c=>{c.inert=false;c.removeAttribute('aria-hidden');c.style.removeProperty('transform')});return}
   const r=scene.getBoundingClientRect();const stage=scene.querySelector<HTMLElement>('.service-grid')!;const travel=scene.offsetHeight-stage.offsetHeight;const progress=Math.max(0,Math.min(2,(96-r.top)/Math.max(1,travel)*2.25));
   cards.forEach((card,i)=>{const entry=Math.max(0,Math.min(1,progress-i+1));const cover=Math.max(0,Math.min(1,progress-i));const y=i===0?0:(1-entry)*112;const rotation=i===0?0:(1-entry)*(i===1?7:-7);card.style.transform=`translate3d(0,${y}%,0) rotate(${rotation}deg) scale(${1-cover*.045})`;const current=Math.min(2,Math.floor(progress+.18))===i;card.inert=!current;card.setAttribute('aria-hidden',String(!current))});
  };const queue=()=>{if(!frame)frame=requestAnimationFrame(update)};addEventListener('scroll',queue,{passive:true});addEventListener('resize',queue);reduced.addEventListener('change',queue);update();
 }
</script>
<style is:global>
.modern-home .services-scroll.is-stacked{height:210vh;position:relative}.modern-home .services-scroll.is-stacked .service-grid{position:sticky;top:96px;height:min(680px,calc(100vh - 135px));min-height:560px;overflow:clip;border:0;perspective:1600px}.modern-home .services-scroll.is-stacked .service-card{position:absolute;inset:0;display:flex;flex-direction:column;align-items:start;justify-content:start;gap:0;padding:50px 6%;min-height:0;border:1px solid #1114;transform-origin:center bottom;transition:background .2s;box-shadow:0 -20px 60px #0002;background:#efefe9;color:#111}.modern-home .services-scroll.is-stacked .service-card:first-child{background:var(--green);color:#111}.modern-home .services-scroll.is-stacked .service-card:nth-child(2){background:#111;color:white}.modern-home .services-scroll.is-stacked .card-top{width:100%;display:flex;flex-direction:row;justify-content:space-between;align-items:center}.modern-home .services-scroll.is-stacked .card-top>span:last-child{font-size:44px;color:inherit}.modern-home .services-scroll.is-stacked .service-card h3{font-size:clamp(46px,5.8vw,84px);line-height:1.03;max-width:1000px;margin:45px 0 28px;color:inherit}.modern-home .services-scroll.is-stacked .service-card>p{font:22px/1.6 Georgia,serif;max-width:620px}.modern-home .services-scroll.is-stacked .card-link{margin-top:auto;padding-top:32px;width:100%;justify-content:space-between;font-size:16px;border-top:1px solid currentColor}.modern-home .services-scroll.is-stacked .card-link span{font-size:36px}.modern-home .services-scroll.is-stacked .service-card:hover .card-link{opacity:.7}
</style>

<style is:global>
.modern-home .services-scroll.is-stacked .service-card:hover{padding:50px 6%}.modern-home .services-scroll.is-stacked .service-card h3{font-size:clamp(54px,6.8vw,108px);max-width:none;margin:28px 0 24px}.modern-home .services-scroll.is-stacked .card-link{margin-top:auto;padding-top:20px}
</style>
