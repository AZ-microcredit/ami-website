---
/**
 * "Can't find what you need? Email info@azmicrocredit.org to schedule an appointment…"
 * centered note that closes the Education / Resources pages.
 * `conj` is the word between the email and the link ("to" or "or").
 * Pass children to replace the whole sentence.
 */
interface Props { conj?: 'to' | 'or'; class?: string }
const { conj = 'to', class: cls = '' } = Astro.props;
const hasCustom = Astro.slots.has('default');
---

<p class:list={['cant-find', cls]}>
  {hasCustom ? (
    <slot />
  ) : (
    <>Can't find what you need? Email <a href="mailto:info@azmicrocredit.org">info@azmicrocredit.org</a>{` ${conj} `}<a class="u" href="/contact">schedule an appointment</a> with our knowledgable staff!</>
  )}
</p>

<style>
  .cant-find { font-family: var(--font-avenir-light); font-size: 20px; line-height: 1.2; text-align: center; width: 656px; max-width: 100%; margin: 0 auto; padding: 0 20px; }
  .cant-find a { color: inherit; text-decoration: none; }
  .cant-find a.u, .cant-find :global(a.u) { text-decoration: underline; }
  .cant-find :global(b) { font-family: var(--font-avenir-heavy); font-weight: 400; }
  @media (max-width: 600px) { .cant-find { font-size: 18px; } }
</style>
