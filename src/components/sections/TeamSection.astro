---
/**
 * Meet the Team section (consolidated into /about-us#meet-the-team).
 * Content moved verbatim from the retired /meet-the-team page; the photo hero was
 * replaced with the standard spaced-title section header.
 *
 * Card design (Executive Board + Staff) follows Dorm Room Fund's "Our Team" partner
 * cards: https://www.dormroomfund.com/our-team — grayscale photo, name + title, and
 * a solid-color panel that wipes in diagonally from the bottom-left corner on hover
 * (CSS ::before, translate(-105%,105%) -> translate(0,0)). Recolored to AMI's
 * bright --green instead of DRF's orange; everything else (fonts, base colors) is
 * unchanged from the rest of the site.
 */
interface Props { id?: string }
const { id } = Astro.props;

// Executive board — names/titles/emails are the visible text on the live page
// (the live mailto targets are stale, so we link to the shown address).
// The Executive Director's card stays the same neutral gray as everyone else's
// (no pre-filled wipe); she's set apart with a green accent ring + "ED" badge
// on her photo instead.
