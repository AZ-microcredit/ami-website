---

<section class="team-section" id={id}>
  <h2 class="spaced-title team-heading">MEET THE TEAM</h2>

  <div class="exec">
    <h3 class="spaced-title small">EXECUTIVE BOARD</h3>
    <div class="card-grid exec-grid">
      {board.map((p) => (
        <div class:list={['person-card', { 'is-lead': p.lead }]}>
          <div class="person-card__avatar-wrap">
            <img class="person-card__avatar" src={p.image} alt={p.name} width="200" height="200" loading="lazy" />
          </div>
          <div class="person-card__info">
            <p class="person-card__name">{p.name}</p>
            <p class="person-card__title">{p.title}</p>
            <a class="person-card__email" href={`mailto:${p.email}`}>{p.email}</a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="staff">
    <h3 class="spaced-title small">STAFF</h3>
    <div class="card-grid staff-grid">
      {staff.map(([name, role, file]) => (
        <div class="person-card person-card--compact">
          <div class="person-card__avatar-wrap">
            <img class="person-card__avatar" src={`/media/${file}`} alt={name} width="160" height="160" loading="lazy" />
          </div>
          <div class="person-card__info">
            <p class="person-card__name">{name}</p>
            <p class="person-card__title">{role}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .team-section { padding-top: 34px; }
  .team-heading { font-size: 40px; letter-spacing: 0.5em; margin-bottom: 10px; }

  .exec, .staff { max-width: 1280px; margin: 0 auto; padding: 24px 32px 40px; }
  .exec .spaced-title, .staff .spaced-title { margin-bottom: 26px; }

  .card-grid { display: grid; gap: 20px; }
  .exec-grid { grid-template-columns: repeat(5, 1fr); }
  .staff-grid { grid-template-columns: repeat(5, 1fr); gap: 18px; }

  /* ---- Person card: grayscale photo + name/title, color wipe on hover ---- */
  .person-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px;
    border-radius: 10px;
    background: var(--grey-bg);
  }
  .person-card__avatar-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 6px;
    background: var(--grey-bg);
  }
  .person-card__avatar {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(1) contrast(1.03);
    transition: filter 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .person-card__info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .person-card__name {
    font-family: var(--font-bold);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.25;
    color: var(--black);
    transition: color 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .person-card__title {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--black);
    transition: color 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .person-card__email {
    font-family: var(--font-body);
    font-size: 11px;
    color: inherit;
    word-break: break-all;
    transition: color 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Color wipe: a full-card panel starts off-card (bottom-left) and slides in on hover,
     timed to match the photo/text color transitions above so nothing appears to stall
     mid-way. will-change is applied only while actually hovering/focused (not at rest) —
     leaving it on ~30 cards permanently promotes that many compositor layers at once,
     which is what caused the wipe to visibly hang/flicker for a moment after the mouse
     left a card. */
  .person-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--green);
    transform: translate3d(-105%, 105%, 0);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .person-card:hover::before,
  .person-card:focus-within::before {
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }
  .person-card:hover .person-card__avatar,
  .person-card:focus-within .person-card__avatar {
    filter: grayscale(0);
  }
  .person-card:hover .person-card__name,
  .person-card:hover .person-card__title,
  .person-card:hover .person-card__email,
  .person-card:focus-within .person-card__name,
  .person-card:focus-within .person-card__title,
  .person-card:focus-within .person-card__email {
    color: var(--white);
  }

  /* Executive Director: same neutral card as everyone else, called out with a
     green ring around the whole card instead of a pre-filled green card. */
  .person-card.is-lead {
    outline: 3px solid var(--green);
    outline-offset: 3px;
  }

  .person-card--compact .person-card__name { font-size: 13px; }
  .person-card--compact .person-card__title { font-size: 11px; }
  .person-card--compact { padding: 8px; gap: 6px; }

  @media (max-width: 900px) {
    .team-heading { font-size: 28px; letter-spacing: 0.35em; }
    .exec-grid { grid-template-columns: repeat(2, 1fr); }
    .staff-grid { grid-template-columns: repeat(4, 1fr); }
    .exec, .staff { padding: 24px 12px 40px; }
  }
  @media (max-width: 600px) {
    .team-heading { font-size: 22px; letter-spacing: 0.25em; }
    .exec-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .staff-grid { grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .person-card__email { font-size: 10px; }
  }
</style>
