---
/**
 * Meet the Team section (consolidated into /about-us#meet-the-team).
 * Content moved verbatim from the retired /meet-the-team page; the photo hero was
 * replaced with the standard spaced-title section header.
 */
interface Props { id?: string }
const { id } = Astro.props;

// Executive board — names/titles/emails are the visible text on the live page
// (the live mailto targets are stale, so we link to the shown address).
const director = { name: 'Catherine Jiang', title: 'Executive Director', email: 'catherine@azmicrocredit.org', image: '/media/760f7c_1ef0478ea640401caceaa858e174fcb0.jpg' };
