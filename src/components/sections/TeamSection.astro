---

<section class="team-section" id={id}>
  <h2 class="spaced-title team-heading">MEET THE TEAM</h2>
  <div class="exec">
    <h3 class="spaced-title small">EXECUTIVE BOARD</h3>
    <div class="person-row single">
      <div class="person">
        <img src={director.image} alt={director.name} width="200" height="200" />
        <h4>{director.name}<br /><span class="role">{director.title}</span><br /><a href={`mailto:${director.email}`}>{director.email}</a></h4>
      </div>
    </div>
    <div class="person-row four">
      {board.map((p) => (
        <div class="person">
          <img src={p.image} alt={p.name} width="200" height="200" />
          <h4>{p.name}<br /><span class="role">{p.title}</span><br /><a href={`mailto:${p.email}`}>{p.email}</a></h4>
        </div>
      ))}
    </div>
  </div>

  <div class="staff">
    <h3 class="spaced-title small">STAFF</h3>
    <ul class="gallery">
      {staff.map(([name, role, file]) => (
        <li>
          <figure>
            <img src={`/media/${file}`} alt={name} width="160" height="205" />
            <figcaption><span class="name">{name}</span><span class="role">{role}</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .team-section { padding-top: 34px; }
  .team-heading { font-size: 40px; letter-spacing: 0.5em; margin-bottom: 10px; }
  .exec { max-width: var(--content-width); margin: 0 auto; padding: 24px 20px 40px; }
  .exec .spaced-title { margin-bottom: 30px; }
  .person-row { display: grid; gap: 20px; justify-items: center; }
  .person-row.single { grid-template-columns: 1fr; }
  .person-row.four { grid-template-columns: repeat(4, 1fr); margin-top: 10px; }
  .person { text-align: center; }
  .person img { width: 200px; height: 200px; border-radius: 50%; object-fit: cover; margin: 0 auto 6px; }
  .person h4 { font-family: var(--font-bold); font-size: 22px; line-height: 1.25; }
  .person .role { font-family: var(--font-body); font-size: 18px; }
  .person-row.four .role { font-size: 17px; }
  .person h4 a { font-family: var(--font-body); font-size: 14px; color: inherit; }

  .staff { max-width: var(--content-width); margin: 0 auto; padding: 30px 0 70px; }
  .staff .spaced-title { margin-bottom: 26px; }
  .gallery { display: grid; grid-template-columns: repeat(6, 1fr); gap: 3px 4px; }
  .gallery figure { position: relative; margin: 0; overflow: hidden; }
  .gallery img { width: 100%; aspect-ratio: 160 / 205; object-fit: cover; object-position: top; display: block; }
  .gallery figcaption { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; text-align: center; padding: 12px 8px; color: var(--white); background: linear-gradient(to top, rgba(0,0,0,.65), rgba(0,0,0,0) 60%); opacity: 0; transition: opacity .2s; }
  .gallery figure:hover figcaption, .gallery figure:focus-within figcaption { opacity: 1; }
  .gallery .name { font-family: var(--font-bold); font-size: 15px; }
  .gallery .role { font-family: var(--font-body); font-size: 13px; }

  @media (max-width: 900px) {
    .team-heading { font-size: 28px; letter-spacing: 0.35em; }
    .person-row.four { grid-template-columns: repeat(2, 1fr); gap: 30px 16px; }
    .gallery { grid-template-columns: repeat(4, 1fr); }
    .staff { padding: 30px 12px 50px; }
  }
  @media (max-width: 600px) {
    .team-heading { font-size: 22px; letter-spacing: 0.25em; }
    .person img { width: 160px; height: 160px; }
    .person h4 { font-size: 19px; }
    .person .role, .person-row.four .role { font-size: 15px; }
    .person h4 a { font-size: 13px; word-break: break-all; }
    .gallery { grid-template-columns: repeat(3, 1fr); }
    .gallery figcaption { opacity: 1; }
  }
</style>
