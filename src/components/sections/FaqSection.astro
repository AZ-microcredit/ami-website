---
import Icon from '../Icon.astro';
/**
 * Microloan FAQ section (consolidated into /copy-of-loans#faq).
 * Content moved verbatim from the retired /copy-of-microloan-faq-s-1 page; the photo
 * hero was replaced with the standard spaced-title section header.
 */
interface Props { id?: string }
const { id } = Astro.props;

const faqs = [
  { q: 'What is a microloan?', a: 'A microloan is a small loan aimed at supporting the growth of small businesses.' },
  { q: 'Who can apply for a microloan?', a: 'Small business entrepreneurs in the Phoenix area seeking financial support for their businesses are encouraged to apply.' },
  { q: 'How can I apply for a microloan?', a: 'You can schedule a Loan Interest Meeting through the AMI website to meet with experts who will guide you through the application process.' },
  { q: 'Why choose AMI?', a: 'AMI offers lower credit score requirements compared to traditional banks and specializes in supporting small businesses, making us well-equipped to meet your needs.' },
  { q: 'What loan terms does AMI offer?', a: 'We offer loans up to $7,500 with terms of 6 to 24 months and a fixed interest rate of 1%.' },
  { q: 'How can I use the loan funds?', a: 'Loan funds should be invested in revenue-generating assets, such as equipment, and can also be invested in inventory.' },
  { q: 'What is the loan process?', a: 'The process begins with an initial consultation call to understand your business and loan purpose. After approval, funds are disbursed, and repayment follows the agreed plan. Once fully repaid, your business can continue to grow.' },
  { q: 'What documents are required?', a: 'Use the document checklist above to prepare your financial records, business plan, and supporting information. Your AMI team will confirm the records needed for your application during your initial call.' },
  { q: 'Can I apply for more than one loan?', a: 'Yes, after fully repaying your first loan, you may apply for additional funding.' },
  { q: 'What does a “holistic review” mean?', a: 'AMI assesses loan applicants using the five C’s: Capacity, Capital, Collateral, Conditions, and Character. Each factor is considered to ensure a fair evaluation.' },
];
---
<section class="faq-section" id={id}>
 <div class="faq-intro"><p class="kicker">A little clarity</p><h2>Good questions.<br/>Straight answers.</h2><p>Get to know our microloans before you take your next step.</p><a href="#schedule">Ask us a question <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div>
 <div class="faq-list">{faqs.map((f,i)=><details><summary><span class="number">{String(i+1).padStart(2,'0')}</span><span>{f.q}</span><span class="toggle" aria-hidden="true">+</span></summary><p>{f.a}</p></details>)}</div>
</section>
<style>
.faq-section{padding:clamp(64px,8vw,120px) clamp(22px,4.2vw,80px);display:grid;grid-template-columns:1fr 1.5fr;gap:clamp(40px,7vw,110px);background:#f3f3f0}.kicker{font:12px/1.6 'AMI Sans',sans-serif;letter-spacing:.12em;text-transform:uppercase}.faq-intro h2{font-size:clamp(36px,4vw,60px);line-height:1.04;margin:26px 0}.faq-intro>p:not(.kicker){font:18px/1.65 'AMI Serif',serif;color:#555;max-width:340px}.faq-intro a{display:inline-flex;gap:32px;margin-top:30px;padding-bottom:8px;border-bottom:1px solid #777;font:14px/1.5 'AMI Sans',sans-serif;text-decoration:none}.faq-list{border-top:1px solid #bbb;min-width:0}details{border-bottom:1px solid #bbb}summary{display:flex;align-items:center;gap:20px;padding:27px 4px;list-style:none;cursor:pointer;font:20px/1.4 'AMI Sans',sans-serif}summary::-webkit-details-marker{display:none}.number{font-size:11px;color:#666;flex:0 0 22px}.toggle{margin-left:auto;font-size:28px;flex-shrink:0;font-weight:300;transition:transform .25s}details[open] .toggle{transform:rotate(45deg)}details[open] summary{color:#39732b}details>p{padding:0 44px 30px 46px;font:17px/1.7 'AMI Serif',serif;color:#444}summary:hover{color:#39732b}@media(max-width:800px){.faq-section{grid-template-columns:1fr;gap:40px}.faq-intro>p:not(.kicker){max-width:500px}summary{font-size:18px;gap:12px;padding:24px 0}details>p{padding:0 20px 26px 34px}}
</style>
