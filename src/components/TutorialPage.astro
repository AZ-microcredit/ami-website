---
/**
 * Shared shell for the old Wix "tutorial" pages (Budgeting, Marketing, Make a
 * Website, Interact with Customers, Business Model Canvas, Social Media, …).
 *
 * Structure on the live site: green title band ("+ TITLE" + italic subtitle),
 * grey page body with an intro sentence, a video/document embed and supporting
 * text, then a centered "Can't find what you need?" note above the footer.
 *
 * Props
 *  - pageTitle   <title> of the page
 *  - title       big white title in the green band (omit → no band)
 *  - subtitle    italic Noticia Text sentence under the title
 *  - lead        intro sentence ("In this video tutorial …"); leadWidth/leadOffset
 *                mirror the Wix element width and its left offset inside the 980 grid
 *  - note        show the "Can't find what you need?" line (default true)
 *  - contactHref where "schedule an appointment" points
 *  - background  page body colour (default grey like the live pages)
 * Slots: "embed" (rendered right after the lead) and default (everything else).
 */
import Base from '../layouts/Base.astro';

interface Props {
  pageTitle: string;
  description?: string;
  title?: string;
  subtitle?: string;
  lead?: string;
  leadWidth?: number;
  leadOffset?: number;
  note?: boolean;
  contactHref?: string;
  background?: string;
  class?: string;
}
const {
  pageTitle,
  description,
  title,
  subtitle,
  lead,
  leadWidth = 909,
  leadOffset = 55,
  note = true,
  contactHref = '/contact',
  background = 'var(--grey-bg)',
  class: className = '',
} = Astro.props;
---

<Base title={pageTitle} description={description}>
  <div class:list={['tut', className]} style={`--tut-bg:${background}`}>
    {title && (
      <section class="tut-hero">
        <div class="tut-hero-inner">
          <svg class="tut-plus" viewBox="20 20 160 160" width="40" height="39" aria-hidden="true">
            <path d="M180 85.574h-65.517V20H85.559v65.574H20v28.917h65.559V180h28.924v-65.509H180V85.574z" fill="#242323" stroke="#242323" stroke-width="8" />
          </svg>
          <h1>{title}</h1>
          {subtitle && <p class="tut-sub">{subtitle}</p>}
        </div>
      </section>
    )}

    <div class="tut-body">
      {lead && (
        <p class="tut-lead" style={`width:${leadWidth}px;margin-left:${leadOffset}px`}>{lead}</p>
      )}
      <slot name="embed" />
      <slot />
    </div>

    {note && (
      <p class="tut-note">
        Can't find what you need? Email&nbsp;<a href="mailto:info@azmicrocredit.org">info@azmicrocredit.org</a> to
        <a href={contactHref} target="_blank" rel="noopener">schedule an appointment</a> with our knowledgable staff!
      </p>
    )}
  </div>
</Base>

<style is:global>
  /* Noticia Text italic: the same Google-font files Wix serves for the subtitle */



  .tut { --font-noticia: 'AMI Serif', serif; background: var(--tut-bg); }

  /* ---- green title band ---- */
  .tut .tut-hero { background: var(--green-dark); color: var(--white); }
  .tut .tut-hero-inner { position: relative; max-width: var(--content-width); margin: 0 auto; padding: 14px 20px 9px 55px; }
  .tut .tut-plus { position: absolute; left: -2px; top: 20px; width: 40px; height: 39px; }
  .tut .tut-hero h1 { font-family: var(--font-avenir-heavy); font-size: 55px; line-height: 1.25; color: var(--white); text-transform: uppercase; }
  .tut .tut-sub { font-family: var(--font-noticia); font-style: italic; font-size: 20px; line-height: 1.4; color: var(--black); margin-top: 4px; }

  /* ---- body ---- */
  .tut .tut-body { max-width: var(--content-width); margin: 0 auto; padding: 21px 0 0; }
  .tut .tut-lead { font-family: var(--font-avenir-light); font-size: 20px; line-height: 1.4; color: var(--black); max-width: 100%; }
  .tut .tut-lead b, .tut .tut-lead strong { font-family: var(--font-avenir-heavy); font-weight: 400; }
  .tut .tut-note { font-family: var(--font-avenir-light); font-size: 20px; line-height: 1.2; text-align: center; width: 656px; max-width: 100%; margin: 30px auto 0; padding: 0 20px 20px; }
  .tut .tut-note a { color: inherit; text-decoration: none; }
  .tut .tut-note a[href^='/'] { text-decoration: underline; }

  /* Wix-style rounded green button ("Break Even Template") */
  .tut .tut-btn { display: flex; align-items: center; justify-content: center; background: var(--green-dark); color: var(--white); border-radius: 5px; font-family: var(--font-avenir-light); font-size: 20px; line-height: 1.4; text-decoration: none; text-align: center; padding: 0 10px; max-width: 100%; transition: background .4s, color .4s; }
  .tut .tut-btn:hover { background: var(--green); }

  /* Wix Video box: poster + dark overlay + title + play button (video is
     hosted on video.wixstatic.com behind a signed token, so it cannot be
     embedded directly: see the INTEGRATION comment in each page). */
  .tut .tut-video { position: relative; overflow: hidden; background: #000; max-width: 100%; }
  .tut .tut-video img { width: 100%; height: 100%; object-fit: cover; }
  .tut .tut-video-overlay { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.35); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 30px; text-align: center; padding: 20px; }
  .tut .tut-video-overlay h3 { font-family: var(--font-body); font-size: 36px; line-height: 1.3; color: var(--white); max-width: 90%; }
  .tut .tut-video-overlay button { width: 56px; height: 56px; padding: 0; border: 0; background: none; cursor: pointer; display: block; }
  .tut .tut-video-overlay svg { width: 56px; height: 56px; display: block; }

  /* Wix "PDF File Viewer" app placeholder */
  .tut .tut-pdf { position: relative; max-width: 100%; background: #e9e9e9; border: 1px solid #a9a9a9; box-sizing: border-box; display: flex; align-items: center; justify-content: center; text-align: center; color: var(--grey-text); font-family: var(--font-avenir-light); font-size: 15px; line-height: 1.4; padding: 20px; }
  .tut .tut-pdf span { max-width: 300px; }

  @media (max-width: 900px) {
    .tut .tut-hero-inner { padding-left: 60px; }
    .tut .tut-plus { left: 12px; }
    .tut .tut-hero h1 { font-size: 36px; }
    .tut .tut-body { padding: 20px 20px 0; }
    .tut .tut-lead { width: auto !important; margin-left: 0 !important; }
    .tut .tut-video-overlay h3 { font-size: 24px; }
  }
  @media (max-width: 600px) {
    .tut .tut-hero h1 { font-size: 28px; }
    .tut .tut-sub { font-size: 17px; }
    .tut .tut-lead, .tut .tut-note { font-size: 18px; }
    .tut .tut-video-overlay { gap: 16px; }
    .tut .tut-video-overlay h3 { font-size: 20px; }
  }
</style>
