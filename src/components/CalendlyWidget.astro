---
/**
 * CalendlyWidget — inline Calendly scheduling embed.
 *
 * Usage:
 *   <CalendlyWidget url="https://calendly.com/ACCOUNT/EVENT-TYPE" height={700} />
 *
 * The Calendly script is loaded once per page via a <script> tag; Calendly
 * itself deduplicates if multiple widgets appear on the same page.
 */
interface Props {
  /** Full Calendly embed URL, e.g. https://calendly.com/azmicrocredit/consultation */
  url: string;
  /** Widget height in px (default 700). The div's min-width is always 320px. */
  height?: number;
}

const { url, height = 700 } = Astro.props;
---

<!-- Calendly inline widget begin -->
<div
  class="calendly-inline-widget"
  data-url={url}
  style={`min-width:320px;height:${height}px;`}
></div>
<script
  type="text/javascript"
  src="https://assets.calendly.com/assets/external/widget.js"
  async
></script>
<!-- Calendly inline widget end -->
