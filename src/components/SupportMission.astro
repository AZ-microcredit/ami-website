---
/**
 * Older "SUPPORT OUR MISSION" donate page body. Published twice on Wix:
 * /donate and /copy-of-donate-1 are identical.
 */
import PlusBand from './PlusBand.astro';
---

<PlusBand title="SUPPORT OUR MISSION" subtitle="Together we can empower entrepreneurs in Phoenix" subtitleWidth={589} indent={50} />

<section class="mission">
  <div class="inner">
    <h4 class="letter-title">A Letter from the Executive Director</h4>
    <hr />
    <p>Arizona Microcredit Initiative works to empower entrepreneurs in the greater Phoenix area and we could not do so without the help of our partners and our donors. Donations allow us to continue to offer our educational resources and consulting services free of charge while maintaining minimal fees on our loan program. We at AMI hope that you can help us continue to fulfill our mission with your donation. Your funding will not only make an immediate impact, but will also continue to support the aspirations of entrepreneurs in Phoenix for years to come.</p>
    <p class="gap">Thank you again for your support!</p>
    <p class="gap">Rashi Duttagupta</p>

    <!-- INTEGRATION: Wix "donation-page" custom element (980×267) renders the donation checkout
         here on the live site; it is blank without Wix. Replace with the donation widget/embed. -->
    <div class="donation-placeholder" role="region" aria-label="Donation checkout">
      <span>Donation checkout</span>
    </div>

    <p class="tax">Donations made to AMI qualify for the 2023-2024 individual income tax credit. The maximum QCO (Qualified Charitable Organization) credit donation amount for 2023: $421 single, married filing separate or head of household; $841 married filing joint. The maximum QCO credit donation amount for 2024: $470 single, married filing separate or head of household; $938 married filing joint. Please Note: Arizona law allows QCO donations made during 2023 or donations made from January 1, 2024 through April 15, 2024 to be claimed on the 2023 Arizona income tax return. Filing for credit requires filling out Arizona Form 321, please discuss with your tax advisor about filing for tax credit.</p>
  </div>
</section>

<style>
  .mission { background: #fafafa; }
  .inner { max-width: var(--content-width); margin: 0 auto; padding: 28px 20px 560px; text-align: center; }
  .letter-title { font-family: var(--font-avenir-heavy); font-size: 28px; line-height: 1.4; color: #000; }
  hr { width: 302px; max-width: 100%; margin: 6px auto 0; border: 0; border-top: 3px solid #000; }
  .inner > p { max-width: 877px; margin: 0 auto; font-family: var(--font-avenir-light); font-size: 20px; line-height: normal; }
  hr + p { margin-top: 20px; }
  .gap { margin-top: 24px !important; }
  .donation-placeholder { width: 980px; max-width: 100%; height: 267px; margin: 24px auto 0; border: 1px solid #ececec; background: #fdfdfd; display: flex; align-items: center; justify-content: center; font-family: var(--font-avenir-light); font-size: 18px; letter-spacing: 0.08em; color: #9a9a9a; text-transform: uppercase; }
  .tax { max-width: 904px !important; margin-top: 10px !important; line-height: 1.3 !important; }
  @media (max-width: 900px) {
    .inner { padding-bottom: 120px; }
    .letter-title { font-size: 24px; }
    .inner > p { font-size: 18px; }
    .donation-placeholder { height: 220px; }
  }
</style>
