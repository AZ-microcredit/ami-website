<script>
 const media = window.matchMedia('(prefers-reduced-motion: reduce)');
 const items = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
 let frame = 0;
 function update() {
  frame = 0;
  items.forEach(item => {
   if (media.matches || window.innerWidth < 700) { item.style.setProperty('--drift','0px'); return; }
   const rect = item.parentElement!.getBoundingClientRect();
   if (rect.bottom < -150 || rect.top > innerHeight + 150) return;
   const distance = (innerHeight / 2 - rect.top - rect.height / 2) * Number(item.dataset.parallax || .08);
   item.style.setProperty('--drift',`${Math.max(-55,Math.min(55,distance))}px`);
  });
 }
 const queue = () => {if (!frame) frame=requestAnimationFrame(update)};
 window.addEventListener('scroll',queue,{passive:true});window.addEventListener('resize',queue);media.addEventListener('change',queue);update();
</script>
<style is:global>
[data-parallax]{transform:translate3d(0,var(--drift,0px),0) scale(1.12)}
@media(prefers-reduced-motion:reduce),(max-width:699px){[data-parallax]{transform:none}}
</style>
