<script>
 import { createScrollScene, reducedMotion, viewportHeight } from '../scripts/motion/engine';
 const items = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
 const caps = new WeakMap<HTMLElement, number>();
 items.forEach(item => {
  const holder = item.parentElement as HTMLElement;
  if (!holder) return;
  createScrollScene({
   root: holder,
   measure: () => {
    // Never drift past the overscan the 1.12 scale creates - no blank edges.
    caps.set(item, Math.min(55, Math.max(12, Math.floor(item.offsetHeight * 0.06))));
   },
   render: () => {
    if (reducedMotion()) { item.style.setProperty('--drift', '0px'); return; }
    const rect = holder.getBoundingClientRect();
    const vh = viewportHeight();
    const cap = caps.get(item) ?? 55;
    const distance = (vh / 2 - rect.top - rect.height / 2) * Number(item.dataset.parallax || .08);
    item.style.setProperty('--drift', `${Math.max(-cap, Math.min(cap, distance))}px`);
   },
  });
 });
</script>
<style is:global>
[data-parallax]{transform:translate3d(0,var(--drift,0px),0) scale(1.12)}
@media(prefers-reduced-motion:reduce){[data-parallax]{transform:none}}
</style>
