---
import Icon from './Icon.astro';
const chapters=[{word:'START',title:'Give your idea a starting point.',text:'Explore the foundations of a business plan, understand your customers, and decide what comes next.',href:'/business-startup-guide',link:'Open the startup guide'},{word:'BUILD',title:'Get comfortable with your numbers.',text:'Learn to work with costs, income, and a budget that helps you make decisions.',href:'/create-a-budget',link:'Explore budgeting'},{word:'GROW',title:'Keep finding your people.',text:'Build your marketing knowledge and learn how to connect with the customers your business serves.',href:'/how-to-market',link:'Explore marketing'}];
---
<section class="learning-dial" id="ideas-in-motion" aria-label="Learn, try, build, repeat">
 <div class="dial-sticky"><p class="eyebrow">Learning is a practice.</p><div class="dial-art" aria-hidden="true"><svg viewBox="0 0 500 500"><defs><path id="learning-circle" d="M250,250 m-185,0 a185,185 0 1,1 370,0 a185,185 0 1,1 -370,0"/></defs><circle cx="250" cy="250" r="233"/><circle cx="250" cy="250" r="147"/><text><textPath href="#learning-circle" textLength="1162">LEARN · TRY · BUILD · REPEAT · </textPath></text></svg><span class="dial-word">START</span></div><p class="dial-caption">One useful idea.<br/><em>Then another.</em></p></div>
 <div class="dial-chapters">{chapters.map((c,i)=><article data-dial-word={c.word}><p class="eyebrow">{c.word} / Your business education</p><h2>{c.title}</h2><p>{c.text}</p><a href={c.href}>{c.link} <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></article>)}</div>
</section>
<style>
.learning-dial{background:#faf9f2;padding:70px 5vw;display:grid;grid-template-columns:1fr 1fr;gap:9vw;align-items:start}.dial-sticky{position:sticky;top:calc(var(--header-height) + 32px)}.eyebrow{font:11px/1.5 'AMI Sans',sans-serif;text-transform:uppercase;letter-spacing:.12em}.dial-art{position:relative;max-width:520px;margin:24px auto}.dial-art svg{display:block;width:100%;overflow:visible;transform:rotate(var(--angle,0deg))}.dial-art circle{fill:none;stroke:#111;stroke-width:1}.dial-art text{font:500 42px 'AMI Sans',sans-serif;fill:#111;letter-spacing:2px}.dial-word{position:absolute;inset:0;display:grid;place-items:center;font:700 clamp(40px,5.5vw,85px)/1 'AMI Sans',sans-serif;letter-spacing:-.06em;color:#39732b}.dial-caption{font:32px/1.15 'AMI Sans',sans-serif;letter-spacing:-.03em}.dial-caption em{font-family:'AMI Serif',serif}.dial-chapters article{min-height:70vh;display:flex;flex-direction:column;justify-content:center;padding:70px 0;border-top:1px solid #bbb}.dial-chapters article:first-child{border-top:0}.dial-chapters h2{font:500 clamp(38px,4vw,62px)/1.04 'AMI Sans',sans-serif;letter-spacing:-.05em;margin:28px 0}.dial-chapters article>p:not(.eyebrow){font:19px/1.65 'AMI Serif',serif;max-width:430px}.dial-chapters a{align-self:start;margin-top:32px;padding:12px 0;border-bottom:1px solid;font:14px/1.5 'AMI Sans',sans-serif;text-decoration:none}.dial-chapters a span{margin-left:25px}
@media(max-width:900px),(prefers-reduced-motion:reduce){.learning-dial{grid-template-columns:1fr;padding:50px 22px;gap:40px}.dial-sticky{position:static}.dial-art{max-width:340px}.dial-word{font-size:55px}.dial-chapters article{min-height:0;padding:40px 0}.dial-chapters article:first-child{border-top:1px solid #bbb}.dial-art svg{transform:none}.dial-caption{text-align:center}}
</style>
<script>
 const dial=document.querySelector<HTMLElement>('.learning-dial');if(dial){const reduce=matchMedia('(prefers-reduced-motion: reduce)');const chapters=[...dial.querySelectorAll<HTMLElement>('[data-dial-word]')];const word=dial.querySelector<HTMLElement>('.dial-word')!;let frame=0;const update=()=>{frame=0;if(reduce.matches||innerWidth<=900){dial.style.setProperty('--angle','0deg');word.textContent='LEARN';return;}const rect=dial.getBoundingClientRect();dial.style.setProperty('--angle',`${Math.max(-30,Math.min(360,(innerHeight*.4-rect.top)*.13))}deg`);const active=chapters.reduce((a,b)=>Math.abs(a.getBoundingClientRect().top+a.offsetHeight/2-innerHeight/2)<Math.abs(b.getBoundingClientRect().top+b.offsetHeight/2-innerHeight/2)?a:b);word.textContent=active.dataset.dialWord!;};const queue=()=>{if(!frame)frame=requestAnimationFrame(update)};addEventListener('scroll',queue,{passive:true});addEventListener('resize',queue);reduce.addEventListener('change',queue);update();}
</script>
