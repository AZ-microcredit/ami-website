---
import { social } from '../data/nav.js';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="row">
      <p class="copyright">©2023 ARIZONA MICROCREDIT INITIATIVE</p>
      <p class="contact">
        <a href="mailto:info@azmicrocredit.org">info@azmicrocredit.org</a>&nbsp;&nbsp;|&nbsp;&nbsp; PO Box 25886, Tempe, AZ
      </p>
      <div class="social">
        <a href={social.facebook} target="_blank" rel="noopener"><img src="/media/72a44c1b3b7c450287b9f4dd21be1548.png" alt="Facebook - Grey Circle" width="34" height="34" /></a>
        <a href={social.twitter} target="_blank" rel="noopener"><img src="/media/e1a85976534f42c1a09d3bff23646ba2.png" alt="Twitter - Grey Circle" width="34" height="34" /></a>
        <a href={social.instagram} target="_blank" rel="noopener"><img src="/media/d7c95bf7ba7e424d9d590123e67ea834.png" alt="Instagram - Grey Circle" width="34" height="34" /></a>
      </div>
    </div>
    <ul class="links">
      <li><a href="/privacy-policy">Privacy Policy</a></li>
      <li><a href="/contact">Contact Us</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { background: var(--green); color: var(--white); font-family: var(--font-avenir-light); font-size: 14px; letter-spacing: 0.06em; }
  .footer-inner { max-width: var(--content-width); margin: 0 auto; padding: 28px 20px 24px; }
  .row { display: flex; align-items: center; gap: 40px; flex-wrap: wrap; }
  .copyright { white-space: nowrap; }
  .contact a { color: inherit; text-decoration: none; }
  .contact a:hover { text-decoration: underline; }
  .social { display: flex; gap: 10px; margin-left: auto; }
  .social img { width: 34px; height: 34px; opacity: .85; transition: opacity .2s; }
  .social a:hover img { opacity: 1; }
  .links { margin-top: 24px; display: flex; flex-direction: column; gap: 6px; }
  .links a { color: inherit; text-decoration: underline; }
  @media (max-width: 700px) {
    .row { flex-direction: column; align-items: flex-start; gap: 12px; }
    .social { margin-left: 0; }
  }
</style>
