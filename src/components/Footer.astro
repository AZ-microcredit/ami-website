---
import Icon from './Icon.astro';
import { social } from '../data/nav.js';
---
<footer class="site-footer">
 <div class="footer-top"><div class="footer-brand"><a href="/" aria-label="AMI home"><img src="/media/ami-official-white.png" alt="Arizona Microcredit Initiative" width="190" height="78"/></a><p>Arizona roots.<br/>A world of possibility.</p></div><div><h2>Take your next step</h2><a href="/copy-of-loans">Microloans</a><a href="/copy-2-of-consulting">Free consulting</a><a href="/copy-of-education">Business education</a></div><div><h2>Get involved</h2><a href="/about-us#meet-the-team">Our team</a><a href="/copy-of-donate">Support our mission</a><a href="/join-the-team">Join AMI</a><a href="/events">Events</a></div><div><h2>Say hello</h2><a href="mailto:info@azmicrocredit.org">info@azmicrocredit.org <Icon name="arrow-up-right" /></a><p>PO Box 25886<br/>Tempe, Arizona</p><a href={social.instagram} target="_blank" rel="noopener">Instagram <Icon name="arrow-up-right" /></a><a href={social.linkedin} target="_blank" rel="noopener">LinkedIn <Icon name="arrow-up-right" /></a></div></div>
 <div class="footer-bottom"><p>© {new Date().getFullYear()} Arizona Microcredit Initiative · A 501(c)(3) nonprofit</p><a href="/privacy-policy">Privacy policy</a><a href="/contact">Contact</a><a href="#main">Back to top <Icon name="arrow-up" /></a></div>
</footer>
<style>
.site-footer{background:#111;color:#ddd;padding:65px 4.2vw 24px;font:12px/1.6 'AMI Sans',sans-serif}.footer-top{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.25fr;gap:35px;padding-bottom:65px}.footer-brand img{width:165px;height:auto;background:transparent;padding:0}.footer-brand p{font:23px/1.3 'AMI Serif',serif;letter-spacing:-.025em;margin-top:24px}.footer-top h2{font:10px 'AMI Sans',sans-serif;text-transform:uppercase;letter-spacing:.1em;color:#999;margin:8px 0 24px}.footer-top a{display:block;text-decoration:none;margin-bottom:10px}.footer-top a:hover{color:var(--green)}.footer-top>div>p{margin-bottom:20px}.footer-bottom{display:flex;gap:25px;border-top:1px solid #444;padding-top:22px;color:#999;font-size:10px}.footer-bottom p{margin-right:auto}.footer-bottom a{text-decoration:none}@media(max-width:750px){.footer-top{grid-template-columns:1fr 1fr;gap:35px 20px;padding-bottom:35px}.site-footer{padding:45px 22px 25px}.footer-bottom{flex-wrap:wrap;gap:16px}.footer-bottom p{width:100%}}@media(max-width:380px){.footer-top{grid-template-columns:1fr}}
</style>
