---
/**
 * Wix "slider gallery" equivalent: one large image at a time with caption overlay,
 * prev/next arrows and a "1/3" counter. Used for client showcases (Loans page).
 */
interface Item { name: string; image: string; href?: string }
interface Props { items: Item[]; height?: number; title?: string }
const { items, height = 450, title } = Astro.props;
---
<section class="client-slider" style={`--h:${height}px`}>
  {title && <h2 class="spaced-title">{title}</h2>}
  <div class="frame">
    {items.map((it, i) => (
      <figure class:list={['item', { current: i === 0 }]}>
        {it.href ? <a href={it.href} target="_blank" rel="noopener"><img src={it.image} alt={it.name} loading="lazy" /></a> : <img src={it.image} alt={it.name} loading="lazy" />}
        <figcaption>{it.name}</figcaption>
      </figure>
    ))}
    <button class="arrow prev" type="button" aria-label="Previous">
      <svg viewBox="0 0 24 44" width="18" height="34"><path d="M22 2 3 22l19 20" fill="none" stroke="currentColor" stroke-width="2"/></svg>
    </button>
    <button class="arrow next" type="button" aria-label="Next">
      <svg viewBox="0 0 24 44" width="18" height="34"><path d="M2 2l19 20L2 42" fill="none" stroke="currentColor" stroke-width="2"/></svg>
    </button>
    <span class="counter"><span class="cur">1</span>/{items.length}</span>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.client-slider').forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>('.item'));
    const cur = root.querySelector<HTMLElement>('.cur');
    let i = 0;
    const show = (n: number) => {
      items[i].classList.remove('current');
      i = (n + items.length) % items.length;
      items[i].classList.add('current');
      if (cur) cur.textContent = String(i + 1);
    };
    root.querySelector('.prev')?.addEventListener('click', () => show(i - 1));
    root.querySelector('.next')?.addEventListener('click', () => show(i + 1));
  });
</script>

<style>
  .client-slider { max-width: var(--content-width); margin: 0 auto; padding: 64px 24px; }
  .client-slider .spaced-title { margin-bottom: 30px; }
  .frame { position: relative; height: var(--h); background: #222; overflow: hidden; }
  .item { visibility: hidden; position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity .5s; }
  .item.current { opacity: 1; visibility: visible; }
  .item a { display: block; height: 100%; }
  .item img { width: 100%; height: 100%; object-fit: cover; }
  .item figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 14px 20px; background: rgba(0,0,0,.55); color: #fff; font-family: var(--font-avenir-heavy); font-size: 18px; }
  .arrow { position: absolute; top: 50%; transform: translateY(-50%); background: none; border: 0; color: #fff; cursor: pointer; padding: 10px; }
  .prev { left: 10px; } .next { right: 10px; }
  .counter { position: absolute; right: 16px; top: 12px; color: #fff; font-family: var(--font-avenir-light); font-size: 13px; }
  @media (max-width: 700px) { .frame { height: 60vw; } }
</style>
