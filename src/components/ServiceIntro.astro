---
import Icon from './Icon.astro';
interface Props { label:string; title:string; text:string; image:string; alt:string; href:string; cta:string; }
const {label,title,text,image,alt,href,cta}=Astro.props;
---
<section class="service-intro"><div class="copy"><p class="kicker">{label} / Arizona Microcredit Initiative</p><h1>{title.split('|').map(line=><span>{line}</span>)}</h1><p class="description">{text}</p><a href={href}>{cta}<span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div><img src={image} alt={alt} fetchpriority="high"/></section>
<style>
.service-intro{display:grid;grid-template-columns:1.15fr 1fr;min-height:560px;background:#111;color:#fff}.copy{padding:50px 4.2vw;display:flex;flex-direction:column;align-items:start}.kicker{font:var(--text-label)/1.6 var(--font-heading);letter-spacing:.1em;text-transform:uppercase;color:#ccc}.service-intro h1{font:700 var(--text-display)/1.02 var(--font-heading);letter-spacing:-.055em;margin:50px 0 24px}.service-intro h1 span{display:block}.service-intro h1 span:last-child{color:var(--green)}.description{font:var(--text-body)/1.6 var(--font-body);max-width:460px;color:#ddd;margin-bottom:30px}.copy>a{display:inline-flex;gap:45px;align-items:center;text-decoration:none;font:var(--text-label) var(--font-heading);background:var(--green);color:#111;padding:17px 22px;margin-top:auto}.copy>a:hover{background:#78c660}.copy>a span{font-size:var(--text-body)}.service-intro>img{width:100%;height:100%;max-height:680px;object-fit:cover;filter:grayscale(1)}@media(max-width:700px){.service-intro{grid-template-columns:1fr}.copy{padding:35px 22px 42px}.service-intro h1{font-size:var(--text-display);margin-top:35px}.description{font-size:var(--text-body)}.service-intro>img{height:330px}}
</style>
