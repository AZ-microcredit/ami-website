---
interface Props { title?:string }
const {title='Good things happen when we show up.'}=Astro.props;
---
<section class="community-gallery">
 <div class="gallery-heading"><p>Inside the AMI community</p><h2>{title}</h2></div>
 <div class="gallery-images">
  <figure><img src="/media/ami-pitch-community.webp" srcset="/media/ami-pitch-community-small.webp 960w, /media/ami-pitch-community.webp 2400w" sizes="(max-width: 700px) 100vw, 58vw" width="2400" height="1800" alt="Community members listening at AMI’s December 2025 pitch competition" loading="lazy"/><figcaption>A room full of possibility.</figcaption></figure>
  <figure><img src="/media/ami-pitch-speakers.webp" srcset="/media/ami-pitch-speakers-small.webp 960w, /media/ami-pitch-speakers.webp 2400w" sizes="(max-width: 700px) 100vw, 38vw" width="2400" height="1800" alt="Speakers introducing the judges at AMI’s December 2025 pitch competition" loading="lazy"/><figcaption>December 2025 / AMI pitch competition</figcaption></figure>
 </div>
</section>
<style>
.community-gallery{padding:80px clamp(22px,4.2vw,80px);background:#f2f2f2}.gallery-heading{display:flex;gap:40px;justify-content:space-between;align-items:start;margin-bottom:40px}.gallery-heading>p{font:11px/1.7 'AMI Sans',sans-serif;text-transform:uppercase;letter-spacing:.1em;max-width:180px}.gallery-heading h2{font:500 clamp(34px,4vw,58px)/1.06 'AMI Sans',sans-serif;letter-spacing:-.05em;max-width:650px}.gallery-images{display:grid;grid-template-columns:1.45fr 1fr;gap:24px;align-items:start}figure{margin:0}figure:nth-child(2){padding-top:80px}img{width:100%;aspect-ratio:4/3;object-fit:cover;filter:grayscale(1)}figcaption{font:12px/1.6 'AMI Sans',sans-serif;padding:18px 0 0;color:#555}@media(max-width:700px){.community-gallery{padding:56px 22px}.gallery-heading{flex-direction:column;gap:24px}.gallery-images{grid-template-columns:1fr;gap:30px}figure:nth-child(2){padding:0}}
</style>
