---
/**
 * Right-hand blog sidebar (Wix classic blog widgets): Featured Posts, Recent Posts,
 * Archive, Search By Tags, Follow Us. Rendered as two blocks (.sb-featured and .sb-rest)
 * so BlogShell can place them independently on its grid (display: contents).
 *
 * mode="list" (blog / category / tag pages): featured carousel, 10 recent posts with thumbs, archive, tags.
 * mode="post" (single post): 3 featured + 3 recent as compact rows, tags, coloured follow icons.
 */
import { featured, recent, archive, tags, postUrl, tagUrl } from '../lib/blog';
import { social } from '../data/nav.js';

interface Props { mode?: 'list' | 'post' }
const { mode = 'list' } = Astro.props;
const isPost = mode === 'post';
const recentPosts = recent(isPost ? 3 : 10);
---

<aside class:list={['blog-sidebar', mode]} aria-label="Blog sidebar">
  <div class="sb-featured">
    <section class="widget featured">
      <h3>Featured Posts</h3>
      {isPost ? (
        <ul class="rows">
          {featured.map((p) => (
            <li>
              <a class="row-title" href={postUrl(p)}>{p.title}</a>
              <a class="row-thumb" href={postUrl(p)} tabindex="-1" aria-hidden="true"><img src={p.cover} alt="" loading="lazy" /></a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="carousel" data-carousel>
          {featured.map((p, i) => (
            <div class="slide" hidden={i !== 0}>
              <a class="slide-img" href={postUrl(p)}><img src={p.cover} alt={p.title} loading={i ? 'lazy' : 'eager'} /></a>
              <a class="slide-title" href={postUrl(p)}>{p.title}</a>
            </div>
          ))}
          <button class="arrow prev" type="button" aria-label="Previous Item"><svg viewBox="0 0 12 20" width="12" height="20"><path d="M10 1 2 10l8 9" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
          <button class="arrow next" type="button" aria-label="Next Item"><svg viewBox="0 0 12 20" width="12" height="20"><path d="m2 1 8 9-8 9" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
        </div>
      )}
    </section>
  </div>

  <div class="sb-rest">
    <section class="widget recent">
      <h3>Recent Posts</h3>
      <ul class="rows">
        {recentPosts.map((p) => (
          <li>
            {!isPost && <a class="row-thumb" href={postUrl(p)} tabindex="-1" aria-hidden="true"><img src={p.cover} alt="" loading="lazy" /></a>}
            <a class="row-title" href={postUrl(p)}>{p.title}</a>
            {isPost && <a class="row-thumb" href={postUrl(p)} tabindex="-1" aria-hidden="true"><img src={p.cover} alt="" loading="lazy" /></a>}
          </li>
        ))}
      </ul>
    </section>

    {!isPost && (
      <section class="widget archive">
        <h3>Archive</h3>
        <ul>
          {archive.map((a) => (
            <li><a href={`/blog/archive/${a.year}/${a.month}`}>{a.label} ({a.count})<span class="sr-only"> {a.count} {a.count === 1 ? 'post' : 'posts'}</span></a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="widget tags">
      <h3>Search By Tags</h3>
      <ul class="cloud">
        {tags.map((t) => (
          <li><a href={tagUrl(t.name)}>{t.name}<span class="sr-only"> ({t.count}) {t.count} {t.count === 1 ? 'post' : 'posts'}</span></a></li>
        ))}
      </ul>
    </section>

    <section class="widget follow">
      <h3>Follow Us</h3>
      <div class="icons">
        {isPost ? (
          <>
            <a href="https://www.instagram.com/azmicrocredit/" target="_blank" rel="noopener"><img src="/media/9f9c321c774844b793180620472aa4f1.png" alt="Instagram" width="22" height="22" /></a>
            <a href={social.linkedin} target="_blank" rel="noopener"><img src="/media/48a2a42b19814efaa824450f23e8a253.png" alt="LinkedIn" width="22" height="22" /></a>
            <a href={social.facebook} target="_blank" rel="noopener"><img src="/media/8f2083b7f516bc701941adb38381e2d6.jpg" alt="Facebook Basic Square" width="22" height="22" /></a>
          </>
        ) : (
          <>
            <a href="https://www.instagram.com/azmicrocredit/" target="_blank" rel="noopener"><img src="/media/e1aa082f7c0747168d9cf43e77046142.png" alt="Instagram - Black Circle" width="22" height="22" /></a>
            <a href="https://twitter.com/azmicrocredit" target="_blank" rel="noopener"><img src="/media/870f97661ed14a5bb2d96ecbddec0aed.png" alt="Twitter - Black Circle" width="22" height="22" /></a>
            <a href={social.facebook} target="_blank" rel="noopener"><img src="/media/4057345bcf57474b96976284050c00df.png" alt="Facebook - Black Circle" width="22" height="22" /></a>
          </>
        )}
      </div>
    </section>
  </div>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((c) => {
    const slides = [...c.querySelectorAll<HTMLElement>('.slide')];
    let i = 0;
    const show = (n: number) => { i = (n + slides.length) % slides.length; slides.forEach((s, k) => (s.hidden = k !== i)); };
    c.querySelector('.prev')?.addEventListener('click', () => show(i - 1));
    c.querySelector('.next')?.addEventListener('click', () => show(i + 1));
  });
</script>

<style>
  .blog-sidebar { display: contents; }
  .widget { margin-bottom: 40px; }
  .widget h3 {
    font-family: var(--font-avenir-heavy); font-size: 22px; line-height: 1.2; letter-spacing: -0.01em;
    padding: 12px 0 14px; border-bottom: 2px solid var(--black); margin-bottom: 12px;
  }
  .post .widget h3 { text-align: center; padding-top: 0; }
  .post .widget { margin-bottom: 30px; }

  /* Featured carousel */
  .carousel { position: relative; }
  .slide-img { display: block; }
  .slide-img img { width: 100%; height: 125px; object-fit: cover; }
  .slide-title { display: block; font-family: var(--font-avenir-heavy); font-size: 22px; line-height: 1.2; margin-top: 30px; text-decoration: none; }
  .slide-title:hover { text-decoration: underline; }
  .arrow { position: absolute; top: 44px; background: none; border: 0; padding: 4px; cursor: pointer; color: var(--black); }
  .arrow.prev { left: 22px; } .arrow.next { right: 22px; }
  .arrow:hover { opacity: .6; }

  /* Rows with thumbnail (Recent Posts, and Featured on single post) */
  .rows li { display: flex; gap: 12px; align-items: flex-start; min-height: 80px; margin-bottom: 32px; }
  .post .rows li { min-height: 0; margin-bottom: 22px; gap: 14px; padding-left: 14px; }
  .row-thumb { flex: 0 0 38px; }
  .row-thumb img { width: 38px; height: 38px; object-fit: cover; background: var(--white); }
  .post .row-thumb { flex: 0 0 48px; margin-left: auto; }
  .post .row-thumb img { width: 48px; height: 38px; object-fit: cover; background: var(--white); }
  .row-title {
    font-family: var(--font-avenir-heavy); font-size: 16px; line-height: 1.4; text-decoration: none;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .post .row-title { font-size: 17px; line-height: 1.35; }
  .row-title:hover { text-decoration: underline; }

  /* Archive */
  .archive li { font-family: var(--font-avenir-light); font-size: 16px; line-height: 1.5; }
  .archive a { text-decoration: none; }
  .archive a:hover { text-decoration: underline; }

  /* Tag cloud */
  .cloud { display: flex; flex-wrap: wrap; gap: 8px 12px; padding-top: 4px; }
  .cloud a { font-family: var(--font-avenir-light); font-size: 14px; line-height: 1.5; text-decoration: none; white-space: nowrap; }
  .cloud a:hover { text-decoration: underline; }
  .post .cloud { padding-left: 6px; }

  /* Follow Us: title and icons on one line, rule below */
  .follow { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; border-bottom: 2px solid var(--black); padding-bottom: 20px; }
  .follow h3 { border: 0; margin: 0; padding: 0; flex: 1; }
  .icons { display: flex; gap: 8px; }
  .icons img { width: 22px; height: 22px; }
  .post .follow { display: block; }
  .post .follow h3 { border-bottom: 2px solid var(--black); padding-bottom: 10px; margin-bottom: 12px; }
  .post .icons { justify-content: center; }
</style>
