.hc-pitch-copy{padding:clamp(28px,4vh,52px) 4.2vw;display:flex;flex-direction:column;justify-content:center}
.hc-green{color:var(--green)}
.hc-h{font:700 var(--text-display)/1 var(--font-heading);letter-spacing:-.055em;margin:12px 0 16px}
.hc-h span{color:var(--green)}
.hc-h em{font-family:var(--font-body);font-weight:400;font-style:normal;color:#C2A14D}
.hc-sub{font:var(--text-body)/1.55 var(--font-body);color:#c9c9c5;margin:0 0 24px;max-width:460px}
.hc-cta{background:var(--green);color:#111}
.hc-pitch-visual{position:relative;overflow:hidden;min-height:200px}
.hc-pitch-visual>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(1)}
.hc-prize{position:absolute;left:0;right:0;bottom:0;background:var(--green);color:#111;display:flex;align-items:center;gap:18px;padding:12px 22px}
.hc-prize strong{font:700 clamp(32px,3.6vw,54px)/.9 var(--font-heading);letter-spacing:-.04em}
.hc-prize>span{font:700 var(--text-label)/1 var(--font-heading);text-transform:uppercase;letter-spacing:.12em;border-left:2px solid #111;padding-left:16px}
.hc-rail{background:#fff;color:#111}
.hc-rail-label{padding:10px 18px 0;margin:0;color:#111}
.hc-logo{background:#0B0B0C;color:#fff;display:grid;grid-template-columns:1.05fr .95fr;gap:3vw;align-items:center;padding:clamp(28px,4vh,52px) 4.2vw}
.hc-gold{color:#C2A14D}
.hc-logo-prize{display:flex;align-items:center;gap:16px;margin:2px 0 24px}
.hc-logo-prize>strong{font:700 clamp(36px,4vw,58px)/.9 var(--font-heading);letter-spacing:-.04em;color:#C2A14D}
.hc-pill{border:1px solid #C2A14D;color:#C2A14D;font:700 10px/1 var(--font-heading);text-transform:uppercase;letter-spacing:.12em;padding:8px 10px}
.hc-ghost{border:1px solid #555;color:#999;cursor:default}
.hc-logo-visual{display:flex;justify-content:flex-end}
.hc-mark-card{background:#fff;margin:0;padding:20px 20px 12px;max-width:440px;width:100%}
.hc-mark-frame{border:1px solid #e2ddd0;padding:26px 18px;display:flex;align-items:center;justify-content:center}
.hc-mark-frame img{width:100%;max-width:320px;height:auto;display:block}
.hc-mark-card figcaption{font:13px/1.5 var(--font-body);color:#4A4E57;padding-top:12px}
.hc-tabs{display:flex;justify-content:center;align-items:center;gap:8px;height:48px;background:#0B0B0C}
.hc-tab{border:1px solid rgba(255,255,255,.45);background:rgba(0,0,0,.5);color:#fff;font:700 11px/1 var(--font-heading);letter-spacing:.1em;text-transform:uppercase;padding:10px 13px;cursor:pointer}
.hc-tab:hover{background:rgba(255,255,255,.15)}
.hc-tab.is-active{background:#fff;color:#111;border-color:#fff}
.hc-arrow{position:absolute;top:calc(50% - 24px);transform:translateY(-50%);z-index:6;width:42px;height:42px;border-radius:50%;border:1px solid rgba(255,255,255,.45);background:rgba(0,0,0,.5);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0}
.hc-arrow:hover{background:rgba(255,255,255,.15)}
.hc-prev{left:14px}.hc-next{right:14px}
@media(prefers-reduced-motion:reduce){.hc-panel{transition:none;transform:none}}
@media(max-width:900px){
.hc-pitch-main{grid-template-columns:1fr}
.hc-pitch-visual{min-height:190px}
.hc-logo{grid-template-columns:1fr;gap:26px;align-content:center}
.hc-logo-visual{justify-content:flex-start}
}
@media(max-width:600px){
.hc-arrow{display:none}
.hc-pitch-copy{padding:34px 22px}
.hc-logo{padding:34px 22px}
.hc-tabs{gap:6px}
.hc-tab{padding:9px 10px;font-size:10px}
}
</style>
