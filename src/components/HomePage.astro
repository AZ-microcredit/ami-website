     <p class="hcl-lede">The Integro Bank Foundation is looking for its logo, and would rather find it in Arizona than order it from a catalogue. Open to Arizona small businesses and Arizona design students, presented with Arizona Microcredit Initiative.</p>
     <div class="hcl-actions">
      <a class="hcl-button hcl-outline-button" href="/logo-comp">Read the brief</a>
     </div>
    </div>
    <div class="hcl-side">
     <div class="hcl-cobrand" aria-label="Presented by Integro Bank Foundation and Arizona Microcredit Initiative">
      <span class="hcl-brand-tile"><img src="/media/pitch-partners/integro-white.png" alt="Integro Bank Foundation" width="200" height="71"/></span>
      <span class="hcl-brand-x" aria-hidden="true">+</span>
      <span class="hcl-brand-tile"><img src="/media/ami-official-white.png" alt="Arizona Microcredit Initiative" width="180" height="58"/></span>
     </div>
     <figure class="hcl-card">
      <div class="hcl-mark-frame"><img src="/media/pitch-partners/integro.webp" alt="The current Integro Bank Foundation logo" width="1000" height="357" loading="lazy"/></div>
      <figcaption>The current mark. You are designing what comes next.</figcaption>
     </figure>
    </div>
    <div class="hcl-prize" aria-label="$1,500 first prize">
     <strong>$1,500</strong>
     <span class="hcl-prize-side">First prize</span>
    </div>
    <dl class="hcl-facts">
     <div><dt>Prize</dt><dd>$1,500<br/>One winning designer</dd></div>
     <div><dt>Who</dt><dd>AZ small businesses<br/>and design students</dd></div>
     <div><dt>Entries</dt><dd>Open Sep 21<br/>Close Oct 10</dd></div>
     <div><dt>Winner</dt><dd>Oct 24<br/>At the pitch competition</dd></div>
    </dl>
   </section>
  </div>
<div class="hc-panel" data-panel role="group" aria-roledescription="slide" aria-label="3 of 3: Welcome to AMI" aria-hidden="true">
 <section class="opening">
  <div class="opening-copy">
   <h1>Big ideas.<br/>Small beginnings.<br/><span>Let’s do it together.</span></h1>
   <p class="serif-copy">Starting a business takes courage. Finding support shouldn’t be the hard part. We’re Arizona Microcredit Initiative, a 501(c)(3) nonprofit helping entrepreneurs start and grow through accessible capital, free consulting, and business education.</p>
   <div class="opening-bottom"><a class="action primary-book" href="#book-a-call">Book a conversation <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div>
  </div>
  <div class="opening-visual">
   <img data-parallax="0.18" src="/media/ami-community.webp" alt="AMI community members at the December 2025 pitch competition" fetchpriority="high" width="1200" height="1600" />
   <div class="photo-note"><span>LOCAL PEOPLE. REAL POSSIBILITY.</span><span>Tempe, Arizona <Icon name="arrow-up-right" /></span></div>
  </div>
 </section>
  </div>
  </div>
  <button class="hc-arrow hc-prev" type="button" aria-label="Previous panel"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
  <button class="hc-arrow hc-next" type="button" aria-label="Next panel"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
 </div>
 </LandingExperience>
 <section class="proof-strip" aria-label="AMI impact">
  <div><CountUp value={100} suffix="+"/><span>Businesses Impacted</span></div>
  <div><CountUp value={75} suffix="+"/><span>Consulting Engagements</span></div>
  <div><CountUp value={300} suffix="+"/><span>Strategic Plans Delivered</span></div>
  <div><CountUp value={70000} prefix="$"/><span>Distributed in Low-Interest Microloans</span></div>
  <div><CountUp value={200} suffix="+"/><span>Education Workshops</span></div>
 </section>
 <section id="support" class="support-section section-space">
  <div class="section-heading"><div><p class="eyebrow">Three ways forward</p><h2>Wherever you are,<br/>start here.</h2></div><p class="serif-copy">An idea on paper. A business in motion.<br/>There’s a next step for you.</p></div>
  <ServicesScroll><div class="service-grid">{services.map(s=><a class="service-card" href={s.href}><div class="card-top"><span>{s.name}</span><span>{s.n}</span></div><h3>{s.title.split('\n').map(line=><span>{line}</span>)}</h3><p>{s.text}</p><div class="card-link">{s.link}<span aria-hidden="true"><Icon name="arrow-up-right" /></span></div></a>)}</div></ServicesScroll>
 </section>
 <HomeParallax />
 <HomeScrollEffects />
 <section class="client-story section-space"><div><p class="eyebrow">Real people. Real initiative.</p><h2>From a shared passion<br/>to a growing business.</h2><p class="serif-copy">Crypt Music’s founders came to AMI for help turning their DJ collective into a business. Together, we worked on pricing, cost analysis, and marketing. Their story reports growth in bookings, revenue, and their audience.</p><a class="text-link" href="/single-post/crypt-music-how-local-friends-converted-their-hobby-into-a-business-ami-success-story">Meet Crypt Music <Icon name="arrow-up-right" /></a></div><img src="/media/760f7c_1d1df47aa9d74eea9f9429c30b2d4490.png" alt="Crypt Music and the AMI team" loading="lazy"/></section>
 <section class="quote-section section-space"><p class="eyebrow">From our community</p><blockquote>“This is an outstanding resource for startups, I wish I would have found out about AMI earlier.”</blockquote><div><span>Clayton Pinkins<br/><small>Business education participant</small></span><a class="text-link" href="/client-testimonials">More client experiences <Icon name="arrow-up-right" /></a></div></section>
 <div class="partner-heading"><p class="eyebrow">Stronger, together.</p><h2>Our community partners.</h2></div>
 <MotionBanner label="Community partners" variant="partners">{partners.map(partner=><a href={partner.href} target="_blank" rel="noopener"><img src={partner.image} alt={partner.name} loading="lazy"/></a>)}</MotionBanner>
 <HomeBooking />
 <ScrollMotion />
 <section class="closing"><p class="eyebrow">Your ambition belongs here.</p><h2>Take the <span>Initiative.</span></h2><div><p>Let’s put your next chapter in motion.</p></div></section>
</Base>
<script>
const hc=document.querySelector('.hero-carousel');
if(hc){
  const panels=[...hc.querySelectorAll('[data-panel]')];
  const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cur=0,timer=null,manual=false;
  const box=hc.querySelector('.hc-panels');
  const landing=document.querySelector('.landing-experience');
  let cleanup=null;
  const setAria=()=>panels.forEach((p,k)=>p.setAttribute('aria-hidden',String(k!==cur)));
  const show=(n,instant)=>{
    const next=(n+panels.length)%panels.length;
    if(next===cur)return;
    if(cleanup)cleanup();
    const oldP=panels[cur],newP=panels[next];
    const fwd=(next===cur+1)||(cur===panels.length-1&&next===0);
    cur=next;
    if(instant||reduced||(landing&&landing.classList.contains('is-cinematic'))){
      box.style.cssText='';
      panels.forEach((p,k)=>{p.style.cssText='';p.classList.toggle('is-active',k===cur);p.classList.toggle('is-before',k<cur);});
      setAria();return;
    }
    const h0=box.offsetHeight;
    oldP.classList.remove('is-active');
    box.style.cssText='position:relative;height:'+h0+'px;overflow:hidden;transition:height .6s cubic-bezier(.2,.7,.2,1)';
    oldP.style.cssText='display:block;position:absolute;top:0;left:0;width:100%;transition:transform .6s cubic-bezier(.2,.7,.2,1),opacity .6s ease';
    newP.style.cssText='display:block;position:absolute;top:0;left:0;width:100%;transform:translateX('+(fwd?100:-100)+'%);transition:transform .6s cubic-bezier(.2,.7,.2,1)';
    const h1=newP.offsetHeight;
    setAria();
    requestAnimationFrame(()=>requestAnimationFrame(()=>{
      oldP.style.transform='translateX('+(fwd?-30:30)+'%)';oldP.style.opacity='0';
      newP.style.transform='translateX(0)';
      box.style.height=h1+'px';
    }));
    newP.classList.add('is-active');
    cleanup=()=>{
      oldP.style.cssText='';newP.style.cssText='';box.style.cssText='';
      panels.forEach((p,k)=>p.classList.toggle('is-active',k===cur));
      setAria();cleanup=null;
    };
    setTimeout(()=>{if(cleanup)cleanup();},650);
  };
  let scrolled=false;
  const stop=()=>{if(timer){clearInterval(timer);timer=null;}};
  const play=()=>{if(reduced||manual||scrolled||timer)return;timer=setInterval(()=>show(cur+1),5000);};
  const onScroll=()=>{const s=window.scrollY>50;if(s!==scrolled){scrolled=s;if(scrolled)stop();else play();}};
  window.addEventListener('scroll',onScroll,{passive:true});
  const userGo=n=>{manual=true;stop();show(n);};
  hc.querySelector('.hc-prev').addEventListener('click',()=>userGo(cur-1));
  hc.querySelector('.hc-next').addEventListener('click',()=>userGo(cur+1));
  hc.addEventListener('focusin',stop);
  hc.addEventListener('focusout',play);
  hc.addEventListener('keydown',e=>{
    if(e.key==='ArrowRight'){e.preventDefault();userGo(cur+1);}
    else if(e.key==='ArrowLeft'){e.preventDefault();userGo(cur-1);}
  });
  let tx=null;
  hc.addEventListener('touchstart',e=>{tx=e.touches[0].clientX;},{passive:true});
  hc.addEventListener('touchend',e=>{
    if(tx===null)return;
    const dx=e.changedTouches[0].clientX-tx;
    if(Math.abs(dx)>48)userGo(cur+(dx<0?1:-1));
    tx=null;
  },{passive:true});
  show(0);play();
}
</script>
