.hero-carousel{position:relative;height:100%;min-height:420px;background:#111}
.hc-panels{display:grid;height:calc(100% - 48px)}
.hc-panel{grid-area:1/1;min-width:0;visibility:hidden;opacity:0;transform:translateX(5%);transition:transform .6s cubic-bezier(.2,.7,.2,1),opacity .6s ease,visibility 0s .6s}
.hc-panel.is-before{transform:translateX(-5%)}
.hc-panel.is-active{visibility:visible;opacity:1;transform:none;transition:transform .6s cubic-bezier(.2,.7,.2,1),opacity .6s ease}
.hc-panel>.opening,.hc-panel>.hc-pitch,.hc-panel>.hc-logo{height:100%}
