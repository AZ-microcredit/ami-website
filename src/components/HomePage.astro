rip strong{font:700 var(--text-display)/1 var(--font-heading);letter-spacing:-.04em}.proof-strip span{font:var(--text-label) var(--font-heading);color:#555}.section-space{padding:100px 4.2vw}h2{font:500 var(--text-display)/1.05 var(--font-heading);letter-spacing:-.045em}.serif-copy{font:var(--text-body)/1.65 var(--font-body);color:#555;max-width:590px}.text-link{font:var(--text-label)/1.5 var(--font-heading);display:inline-flex;gap:35px;text-decoration:none;border-bottom:1px solid #999;padding-bottom:8px}.text-link:hover{color:#39732b}.support-section{background:#f2f2f2}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:48px}.section-heading .eyebrow{margin-bottom:24px}.section-heading>.serif-copy{font-size:var(--text-body)}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #bcbcbc;border-left:1px solid #bcbcbc}.service-card{padding:32px;min-height:355px;display:flex;flex-direction:column;text-decoration:none;border-bottom:1px solid #bcbcbc;border-right:1px solid #bcbcbc;transition:background .2s}.service-card:first-child{background:var(--green)}.service-card:hover{background:#e0e0e0}.service-card:first-child:hover{background:#6cc154}.card-top{display:flex;justify-content:space-between;font:var(--text-label) var(--font-heading);text-transform:uppercase;letter-spacing:.08em}.service-card h3{font:500 var(--text-heading)/1.1 var(--font-heading);letter-spacing:-.04em;margin:36px 0 20px}.service-card h3 span{display:block}.service-card>p{font:var(--text-body)/1.55 var(--font-body);max-width:390px}.card-link{margin-top:auto;padding-top:34px;display:flex;justify-content:space-between;align-items:center;font:var(--text-label) var(--font-heading)}.card-link span{font-size:var(--text-heading)}.community-section{display:grid;grid-template-columns:1fr 1fr;background:#111;color:white}.community-image{position:relative;min-height:560px}.community-image img{position:absolute;width:100%;height:100%;object-fit:cover;filter:grayscale(1)}.image-label{position:absolute;bottom:25px;left:25px;padding:12px 16px;background:#fff;color:black;font:var(--text-label) var(--font-heading)}.community-copy{padding:75px 8%}.community-copy h2{margin:42px 0 28px}.community-copy .serif-copy{color:#ccc;margin-bottom:30px}.community-copy .action{border:1px solid #777}.learning-grid{display:block}.resource-links{display:grid;grid-template-columns:repeat(3,1fr);gap:45px}.resource-links a{display:block;text-decoration:none;border-top:1px solid #ccc;padding:25px 0 30px}.resource-links a>span{font:var(--text-label) var(--font-heading);text-transform:uppercase;letter-spacing:.08em;color:#555}.resource-links h3{font:var(--text-heading)/1.2 var(--font-heading);letter-spacing:-.035em;margin:16px 0 10px}.resource-links h3 b{float:right;font-weight:400}.resource-links p{font:var(--text-body)/1.55 var(--font-body);color:#555}.resource-links a:hover h3{color:#39732b}.quote-section{background:#f2f2f2}.quote-section blockquote{font:var(--text-heading)/1.25 var(--font-body);letter-spacing:-.025em;max-width:1060px;margin:42px 0}.quote-section>div{display:flex;justify-content:space-between;gap:30px;font:var(--text-label)/1.6 var(--font-heading)}.quote-section small{color:#666}.closing{background:var(--green);padding:52px 4.2vw}.closing h2{font-size:var(--text-display);font-weight:700;letter-spacing:-.06em;margin:14px 0 18px;line-height:1}.closing h2 span{color:white}.closing>div{display:flex;align-items:center;justify-content:space-between;gap:25px}.closing>div>p{font:var(--text-body) var(--font-body)}
