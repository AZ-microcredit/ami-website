---
import Base from '../layouts/Base.astro';
import CountUp from './CountUp.astro';
const services = [
 {n:'01',title:'A little capital.\nA lot of possibility.',name:'Microloans',text:'Low-interest funding, lower credit barriers, and a holistic review that sees the person behind the business.',href:'/copy-of-loans',link:'Explore microloans'},
 {n:'02',title:'Your ambition.\nOur sleeves rolled up.',name:'Free consulting',text:'One-on-one support for your next business challenge. From your first idea to your next stage of growth.',href:'/copy-2-of-consulting',link:'Meet your support team'},
 {n:'03',title:'Build your business.\nBuild your confidence.',name:'Business education',text:'Free workshops and practical resources that turn the things you don’t know into the next steps you can take.',href:'/copy-of-education',link:'Start learning'},
];
---
<Base title="AMI | Take the initiative." description="Big ideas start small. Arizona Microcredit Initiative empowers local entrepreneurs with free consulting, business education, and low-interest microloans." mainClass="modern-home">
 <section class="opening">
  <div class="opening-copy">
   <p class="eyebrow"><span class="status-dot"></span> Arizona roots. Entrepreneurial spirit.</p>
   <h1>Big ideas.<br/>Small beginnings.<br/><span>Let’s go.</span></h1>
   <div class="opening-bottom"><p>You bring the ambition. We bring the capital, guidance, and community to help your business take its next step.</p><a class="action light" href="/copy-2-of-consulting#schedule">Book a free consultation <span aria-hidden="true">↗</span></a><a class="secondary-action" href="#support">Explore our services ↓</a><p class="booking-reassurance">Free · 30 minutes · One-on-one guidance</p></div>
  </div>
  <div class="opening-visual">
   <img src="/media/ami-community.jpg" alt="AMI community members at the December 2025 pitch competition" fetchpriority="high" width="1200" height="1600" />
   <div class="photo-note"><span>LOCAL PEOPLE. REAL POSSIBILITY.</span><span>Tempe, Arizona ↗</span></div>
   <a class="green-note" href="/about-us"><span>Small business.<br/>Lasting impact.</span><span aria-hidden="true">↗</span></a>
  </div>
 </section>
 <section class="proof-strip" aria-label="AMI impact">
  <div><CountUp value={100} suffix="+"/><span>Businesses impacted</span><small>Previously reported cumulative impact</small></div>
  <div><CountUp value={75} suffix="+"/><span>Consulting engagements</span><small>Previously reported cumulative impact</small></div>
  <div><CountUp value={300} suffix="+"/><span>Strategic plans delivered</span><small>Previously reported cumulative impact</small></div>
  <div><CountUp value={24}/><span>Education workshops</span><small>2025–2026 draft report tally*</small></div>
 </section>
 <p class="impact-source">*22 workshops in 2025 + 2 recorded in the 2026 draft. Totals await final report approval. <a href="/impact">About these figures ↗</a></p>
 <section class="mission-section section-space">
  <p class="eyebrow">The initiative starts with you</p>
  <div><h2>You don’t have to<br/>build it alone.</h2><p class="serif-copy">Starting a business takes courage. Finding support shouldn’t be the hard part. We’re Arizona Microcredit Initiative—a 501(c)(3) nonprofit helping entrepreneurs start and grow through accessible capital, free consulting, and business education.</p><a class="text-link" href="/about-us">Get to know AMI <span aria-hidden="true">↗</span></a></div>
 </section>
 <section id="support" class="support-section section-space">
  <div class="section-heading"><div><p class="eyebrow">Three ways forward</p><h2>Wherever you are,<br/>start here.</h2></div><p class="serif-copy">An idea on paper. A business in motion.<br/>There’s a next step for you.</p></div>
  <div class="service-grid">{services.map(s=><a class="service-card" href={s.href}><div class="card-top"><span>{s.name}</span><span>{s.n}</span></div><h3>{s.title.split('\n').map(line=><span>{line}</span>)}</h3><p>{s.text}</p><div class="card-link">{s.link}<span aria-hidden="true">↗</span></div></a>)}</div>
 </section>
 <section class="community-section">
  <div class="community-image"><img src="/media/760f7c_6ca28189de8c4da9bd7a8a6d3b4be85e.jpg" alt="Two AMI team members shake hands during a meeting" loading="lazy" width="1853" height="1240"/><span class="image-label">In your corner. From day one.</span></div>
  <div class="community-copy"><p class="eyebrow">People before paperwork</p><h2>A team that<br/>shows up.</h2><p class="serif-copy">Your business isn’t a template. Neither is our support. We work alongside local entrepreneurs to understand their challenges and find a path forward, together.</p><a class="action dark" href="/about-us#meet-the-team">Meet the people behind AMI <span aria-hidden="true">↗</span></a></div>
 </section>
 <section class="learning section-space"><div class="section-heading"><div><p class="eyebrow">Keep moving. Keep learning.</p><h2>Your next chapter<br/>starts with a little know-how.</h2></div><a class="text-link" href="/copy-of-education#resources">All resources <span aria-hidden="true">↗</span></a></div><div class="learning-grid"><a class="learning-photo" href="/events"><img src="/media/ami-workshop.jpg" alt="Participants attend an AMI business education workshop" loading="lazy" width="1200" height="900"/><div><p class="eyebrow">Learn together</p><h3>Business Builders Program <span aria-hidden="true">↗</span></h3><p>Practical workshops. Shared experience. A stronger start.</p></div></a><div class="resource-links"><a href="/business-startup-guide"><span>01 / Start</span><h3>Turn your idea into a plan. <b aria-hidden="true">↗</b></h3><p>Your guide to getting a small business off the ground.</p></a><a href="/create-a-budget"><span>02 / Build</span><h3>Get to know your numbers. <b aria-hidden="true">↗</b></h3><p>Make a budget that helps you move forward.</p></a><a href="/how-to-market"><span>03 / Grow</span><h3>Find your people. <b aria-hidden="true">↗</b></h3><p>Learn how to connect your business with customers.</p></a></div></div></section>
 <section class="client-story section-space"><div><p class="eyebrow">Real people. Real initiative.</p><h2>From a shared passion<br/>to a growing business.</h2><p class="serif-copy">Crypt Music’s founders came to AMI for help turning their DJ collective into a business. Together, we worked on pricing, cost analysis, and marketing. Their story reports growth in bookings, revenue, and their audience.</p><a class="text-link" href="/single-post/crypt-music-how-local-friends-converted-their-hobby-into-a-business-ami-success-story">Meet Crypt Music ↗</a></div><img src="/media/760f7c_1d1df47aa9d74eea9f9429c30b2d4490.png" alt="Crypt Music and the AMI team" loading="lazy"/></section>
 <section class="quote-section section-space"><p class="eyebrow">From our community</p><blockquote>“This is an outstanding resource for startups, I wish I would have found out about AMI earlier.”</blockquote><div><span>Clayton Pinkins<br/><small>Business education participant</small></span><a class="text-link" href="/client-testimonials">More client experiences ↗</a></div></section>
 <section class="partner-strip"><p class="eyebrow">Stronger, together.<br/>Our community partners</p><div><img src="/media/760f7c_01992304a85546a9b96fe3cd88986473.png" alt="FABRIC Tempe" loading="lazy"/><img src="/media/760f7c_3763d8cb0b95499cbe85fd64ef77c762.png" alt="Local First Arizona" loading="lazy"/><img src="/media/760f7c_4b2485edd8aa427283030d2b7ef90c53.png" alt="SEED SPOT" loading="lazy"/><img src="/media/760f7c_89aea0e9619841c0b88ff09869245437.png" alt="Arizona Small Business Association" loading="lazy"/></div></section>
 <section class="closing section-space"><p class="eyebrow">Your ambition belongs here.</p><h2>Take the<br/><span>initiative.</span></h2><div><p>Let’s put your next chapter in motion.</p><a class="action dark" href="/copy-2-of-consulting#schedule">Book a free consultation <span aria-hidden="true">↗</span></a></div></section>
</Base>
<style>
.client-story{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.client-story h2{margin:25px 0}.client-story .text-link{margin-top:25px}.client-story>img{width:100%;height:460px;object-fit:cover;filter:grayscale(1)}@media(max-width:700px){.client-story{grid-template-columns:1fr;gap:30px}.client-story>img{height:350px}}

.proof-strip :global(.count-up){font:42px/1 Helvetica,Arial,sans-serif;letter-spacing:-.04em}.proof-strip small{font:9px/1.5 Helvetica,Arial,sans-serif;color:#777}.proof-strip>div:first-child{border-left:0;padding-left:0}.impact-source{font:10px/1.6 Helvetica,Arial,sans-serif;color:#666;padding:14px 4.2vw;border-bottom:1px solid #ddd}.impact-source a{margin-left:8px;text-underline-offset:3px}@media(max-width:600px){.proof-strip :global(.count-up){font-size:34px}.proof-strip small{font-size:9px}.impact-source{padding:14px 22px}}

.secondary-action{display:inline-block;margin:20px 0 0 24px;color:#ddd;font:12px Helvetica,Arial,sans-serif;text-underline-offset:5px}.opening-bottom .booking-reassurance{font:11px/1.5 Helvetica,Arial,sans-serif;color:#aaa;margin:15px 0 0}.opening-bottom .action.light{background:var(--green);color:#111}@media(max-width:900px){.service-grid{grid-template-columns:1fr!important}.secondary-action{display:block;margin-left:0}}

.partner-strip{padding:50px 4.2vw;display:flex;align-items:center;gap:70px}.partner-strip>p{flex:0 0 220px}.partner-strip>div{display:flex;align-items:center;justify-content:space-between;gap:35px;width:100%}.partner-strip img{width:140px;height:70px;object-fit:contain;filter:grayscale(1)}@media(max-width:800px){.partner-strip{padding:40px 22px;flex-direction:column;align-items:start;gap:25px}.partner-strip>p{flex:auto}.partner-strip>div{display:grid;grid-template-columns:1fr 1fr;gap:25px}.partner-strip img{width:120px;height:60px}}

.opening{display:grid;grid-template-columns:1.15fr 1fr;background:#111;color:#fff;min-height:690px}.opening-copy{padding:52px 4.2vw 55px;display:flex;flex-direction:column}.eyebrow{font:11px Helvetica,Arial,sans-serif;text-transform:uppercase;letter-spacing:.12em;line-height:1.6}.status-dot{display:inline-block;width:7px;height:7px;background:var(--green);border-radius:50%;margin-right:10px}.opening h1{font-size:clamp(58px,5.3vw,90px);line-height:.99;letter-spacing:-.065em;margin:60px 0 42px;font-weight:700}.opening h1 span{color:var(--green)}.opening-bottom{margin-top:auto}.opening-bottom p{font:18px/1.55 Georgia,serif;max-width:390px;color:#ddd;margin-bottom:26px}.action{display:inline-flex;align-items:center;justify-content:space-between;gap:35px;text-decoration:none;padding:17px 21px;font:13px Helvetica,Arial,sans-serif;transition:background .2s,transform .2s}.action span{font-size:22px;line-height:1}.action:hover{transform:translateY(-3px)}.action.light{background:white;color:#111}.action.dark{background:#111;color:white}.opening-visual{position:relative;min-width:0;overflow:hidden}.opening-visual>img{width:100%;height:100%;object-fit:cover;object-position:45% center;filter:grayscale(1);position:absolute}.opening-visual:after{content:'';position:absolute;inset:0;background:linear-gradient(transparent 65%,#0008);pointer-events:none}.photo-note{position:absolute;bottom:22px;left:25px;right:25px;display:flex;justify-content:space-between;font:9px Helvetica,Arial,sans-serif;letter-spacing:.06em;z-index:1}.green-note{position:absolute;right:0;top:44px;background:var(--green);color:#000;display:flex;gap:38px;align-items:center;padding:24px;text-decoration:none;font:700 21px/1.1 Helvetica,Arial,sans-serif}.green-note>span:last-child{font-size:36px}.proof-strip{display:grid;grid-template-columns:1fr 1fr 1.2fr 1fr;padding:36px 4.2vw;border-bottom:1px solid #ccc;gap:25px;align-items:center}.proof-strip>p{font:20px/1.2 Georgia,serif}.proof-strip>p strong{font-weight:400;color:#555}.proof-strip>div{border-left:1px solid #ccc;padding-left:35px;display:grid;gap:9px}.proof-strip strong{font:42px/1 Helvetica,Arial,sans-serif;letter-spacing:-.04em}.proof-strip span{font:11px Helvetica,Arial,sans-serif;color:#555}.section-space{padding:100px 4.2vw}.mission-section{display:grid;grid-template-columns:1fr 2fr;gap:30px}h2{font:500 clamp(37px,4.3vw,66px)/1.05 Helvetica,Arial,sans-serif;letter-spacing:-.045em}.serif-copy{font:18px/1.65 Georgia,serif;color:#555;max-width:590px}.mission-section .serif-copy{margin:28px 0}.text-link{font:13px/1.5 Helvetica,Arial,sans-serif;display:inline-flex;gap:35px;text-decoration:none;border-bottom:1px solid #999;padding-bottom:8px}.text-link:hover{color:#39732b}.support-section{background:#f2f2f2}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:48px}.section-heading .eyebrow{margin-bottom:24px}.section-heading>.serif-copy{font-size:16px}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #bcbcbc;border-left:1px solid #bcbcbc}.service-card{padding:32px;min-height:355px;display:flex;flex-direction:column;text-decoration:none;border-bottom:1px solid #bcbcbc;border-right:1px solid #bcbcbc;transition:background .2s}.service-card:first-child{background:var(--green)}.service-card:hover{background:#e0e0e0}.service-card:first-child:hover{background:#6cc154}.card-top{display:flex;justify-content:space-between;font:11px Helvetica,Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}.service-card h3{font:500 clamp(25px,2.2vw,34px)/1.1 Helvetica,Arial,sans-serif;letter-spacing:-.04em;margin:36px 0 20px}.service-card h3 span{display:block}.service-card>p{font:16px/1.55 Georgia,serif;max-width:390px}.card-link{margin-top:auto;padding-top:34px;display:flex;justify-content:space-between;align-items:center;font:12px Helvetica,Arial,sans-serif}.card-link span{font-size:25px}.community-section{display:grid;grid-template-columns:1fr 1fr;background:#111;color:white}.community-image{position:relative;min-height:560px}.community-image img{position:absolute;width:100%;height:100%;object-fit:cover;filter:grayscale(1)}.image-label{position:absolute;bottom:25px;left:25px;padding:12px 16px;background:#fff;color:black;font:12px Helvetica,Arial,sans-serif}.community-copy{padding:75px 8%}.community-copy h2{margin:42px 0 28px}.community-copy .serif-copy{color:#ccc;margin-bottom:30px}.community-copy .action{border:1px solid #777}.learning-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:45px}.learning-photo{text-decoration:none}.learning-photo img{height:320px;width:100%;object-fit:cover;filter:grayscale(1);object-position:center 60%}.learning-photo>div{padding-top:23px}.learning-photo h3{font:26px/1.2 Helvetica,Arial,sans-serif;letter-spacing:-.03em;margin:12px 0}.learning-photo h3 span{float:right}.learning-photo p:last-child{font:16px/1.6 Georgia,serif;color:#555}.resource-links a{display:block;text-decoration:none;border-top:1px solid #ccc;padding:25px 0 30px}.resource-links a>span{font:10px Helvetica,Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em;color:#555}.resource-links h3{font:24px/1.2 Helvetica,Arial,sans-serif;letter-spacing:-.035em;margin:16px 0 10px}.resource-links h3 b{float:right;font-weight:400}.resource-links p{font:15px/1.55 Georgia,serif;color:#555}.resource-links a:hover h3{color:#39732b}.quote-section{background:#f2f2f2}.quote-section blockquote{font:clamp(26px,3.4vw,49px)/1.25 Georgia,serif;letter-spacing:-.025em;max-width:1060px;margin:42px 0}.quote-section>div{display:flex;justify-content:space-between;gap:30px;font:13px/1.6 Helvetica,Arial,sans-serif}.quote-section small{color:#666}.closing{background:var(--green)}.closing h2{font-size:clamp(80px,13vw,195px);font-weight:700;letter-spacing:-.075em;margin:28px 0 42px;line-height:.88}.closing h2 span{color:white}.closing>div{display:flex;align-items:center;justify-content:space-between;gap:25px}.closing>div>p{font:20px Georgia,serif}.closing .action{min-width:200px}
@media(min-width:1700px){.opening{min-height:800px}.opening-copy{padding-left:max(4.2vw,calc((100vw - 1600px)/2))}}
@media(max-width:900px){.opening{grid-template-columns:1fr 1fr;min-height:600px}.opening h1{font-size:60px;margin-top:55px}.opening-copy{padding:36px 25px}.opening-bottom p{font-size:16px}.green-note{font-size:17px;padding:18px;gap:20px}.photo-note{flex-direction:column;gap:8px}.proof-strip{grid-template-columns:1fr 1fr;gap:30px}.proof-strip>div{padding-left:20px}.section-space{padding:70px 25px}.mission-section{grid-template-columns:1fr;gap:30px}.section-heading{align-items:start}.community-copy{padding:55px 25px}.community-image{min-height:510px}.learning-grid{gap:25px}.learning-photo img{height:300px}}
@media(max-width:600px){.opening{grid-template-columns:1fr}.opening-copy{padding:32px 22px 42px}.opening h1{font-size:clamp(48px,12.5vw,74px);margin:42px 0 28px}.opening-visual{min-height:400px}.opening-visual>img{object-position:center 42%}.green-note{top:24px}.photo-note{flex-direction:row}.proof-strip{padding:30px 22px;gap:30px 15px}.proof-strip strong{font-size:32px}.proof-strip span{font-size:10px;line-height:1.5}.proof-strip>p{font-size:19px}.proof-strip>div{padding-left:14px}.section-space{padding:60px 22px}.section-heading{flex-direction:column;gap:25px;margin-bottom:32px}.serif-copy{font-size:17px}.service-grid,.community-section,.learning-grid{grid-template-columns:1fr}.service-card{padding:26px;min-height:340px}.service-card h3{font-size:32px}.community-image{min-height:380px}.community-copy{padding:50px 22px}.community-copy h2{margin-top:30px}.quote-section>div{flex-direction:column}.closing>div{align-items:start;flex-direction:column}.closing>div>p{font-size:18px}.closing h2{font-size:23vw}.learning-photo img{height:290px}}
</style>
