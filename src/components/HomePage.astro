---
import Base from '../layouts/Base.astro';
import ServicesScroll from './ServicesScroll.astro';
import LandingExperience from './LandingExperience.astro';
import HomeScrollEffects from './HomeScrollEffects.astro';
import HomeParallax from './HomeParallax.astro';
import HomeBooking from './HomeBooking.astro';
import ScrollMotion from './ScrollMotion.astro';
import CountUp from './CountUp.astro';
import MotionBanner from './MotionBanner.astro';
const partners = [
  { name: 'FABRIC Tempe', image: '/media/760f7c_01992304a85546a9b96fe3cd88986473.png', href: 'https://www.fabrictempe.com/' },
  { name: 'Local First Arizona', image: '/media/760f7c_3763d8cb0b95499cbe85fd64ef77c762.png', href: 'https://www.localfirstaz.com/' },
  { name: 'Seed Spot', image: '/media/760f7c_d156c5a31c9a4299a4fea382218f3e32.png', href: 'https://seedspot.org/who-we-are/' },
  { name: 'Arizona Small Business Association', image: '/media/760f7c_81db59b8eccc44ada4eb4463545a66fd.png', href: 'https://www.asba.com/default.aspx' },
  { name: 'Prestamos CDFI', image: '/media/760f7c_c623c60ec92745dc87c30dd1e5134621.png', href: 'https://prestamoscdfi.org/' },
  { name: 'State Forty Eight Foundation', image: '/media/760f7c_da29cd80329b4b1986cd6b3a081d094c.png', href: 'https://statefortyeight.com/pages/foundation' },
];
const services = [
 {n:'01',title:'A little capital.\nA lot of possibility.',name:'Microloans',text:'Low-interest funding, lower credit barriers, and a holistic review that sees the person behind the business.',href:'/copy-of-loans',link:'Explore microloans'},
 {n:'02',title:'Your ambition.\nOur sleeves rolled up.',name:'Free consulting',text:'One-on-one support for your next business challenge. From your first idea to your next stage of growth.',href:'/copy-2-of-consulting',link:'Meet your support team'},
 {n:'03',title:'Build your business.\nBuild your confidence.',name:'Business education',text:'Free workshops and practical resources that turn the things you don’t know into the next steps you can take.',href:'/copy-of-education',link:'Start learning'},
];
---
<Base title="AMI | Take the initiative." description="Big ideas start small. Arizona Microcredit Initiative empowers local entrepreneurs with free consulting, business education, and low-interest microloans." mainClass="modern-home">
 <LandingExperience>
 <section class="opening">
  <div class="opening-copy">
   <h1>Big ideas.<br/>Small beginnings.<br/><span>Let’s go.</span></h1>
   <h2>You don’t have to<br/>build it alone.</h2>
   <p class="serif-copy">Starting a business takes courage. Finding support shouldn’t be the hard part. We’re Arizona Microcredit Initiative, a 501(c)(3) nonprofit helping entrepreneurs start and grow through accessible capital, free consulting, and business education.</p>
   <div class="opening-bottom"><a class="action primary-book" href="#book-a-call">Book a conversation <span aria-hidden="true">↗</span></a><a class="explore-link" href="#support">Explore our services ↓</a></div>
  </div>
  <div class="opening-visual">
   <img data-parallax="0.18" src="/media/ami-community.webp" alt="AMI community members at the December 2025 pitch competition" fetchpriority="high" width="1200" height="1600" />
   <div class="photo-note"><span>LOCAL PEOPLE. REAL POSSIBILITY.</span><span>Tempe, Arizona ↗</span></div>
  </div>
 </section>
 </LandingExperience>
 <section class="proof-strip" aria-label="AMI impact">
  <div><CountUp value={100} suffix="+"/><span>Businesses Impacted</span></div>
  <div><CountUp value={75} suffix="+"/><span>Consulting Engagements</span></div>
  <div><CountUp value={300} suffix="+"/><span>Strategic Plans Delivered</span></div>
  <div><CountUp value={70000} prefix="$"/><span>Distributed in Low-Interest Microloans</span><small>Per AMI's April 2025 press release</small></div>
  <div><CountUp value={200} suffix="+"/><span>Education Workshops</span></div>
 </section>
 <section id="support" class="support-section section-space">
  <div class="section-heading"><div><p class="eyebrow">Three ways forward</p><h2>Wherever you are,<br/>start here.</h2></div><p class="serif-copy">An idea on paper. A business in motion.<br/>There’s a next step for you.</p></div>
  <ServicesScroll><div class="service-grid">{services.map(s=><a class="service-card" href={s.href}><div class="card-top"><span>{s.name}</span><span>{s.n}</span></div><h3>{s.title.split('\n').map(line=><span>{line}</span>)}</h3><p>{s.text}</p><div class="card-link">{s.link}<span aria-hidden="true">↗</span></div></a>)}</div></ServicesScroll>
 </section>
 <HomeParallax />
 <section class="community-section">
  <div class="community-image"><img data-parallax="0.14" src="/media/ami-pitch-community.webp" alt="Community members at AMI’s December 2025 pitch competition" loading="lazy" width="2400" height="1800"/><span class="image-label">In your corner. From day one.</span></div>
  <div class="community-copy"><p class="eyebrow">People before paperwork</p><h2>A team that<br/>shows up.</h2><p class="serif-copy">Your business isn’t a template. Neither is our support. We work alongside local entrepreneurs to understand their challenges and find a path forward, together.</p><a class="action dark" href="/about-us#meet-the-team">Meet the people behind AMI <span aria-hidden="true">↗</span></a></div>
 </section>
 <HomeScrollEffects />
 <section class="learning section-space"><div class="section-heading"><div><p class="eyebrow">Keep moving. Keep learning.</p><h2>Your next chapter<br/>starts with a little know-how.</h2></div><a class="text-link" href="/copy-of-education#resources">All resources <span aria-hidden="true">↗</span></a></div><div class="learning-grid"><div class="resource-links"><a href="/business-startup-guide"><span>01 / Start</span><h3>Turn your idea into a plan. <b aria-hidden="true">↗</b></h3><p>Your guide to getting a small business off the ground.</p></a><a href="/create-a-budget"><span>02 / Build</span><h3>Get to know your numbers. <b aria-hidden="true">↗</b></h3><p>Make a budget that helps you move forward.</p></a><a href="/how-to-market"><span>03 / Grow</span><h3>Find your people. <b aria-hidden="true">↗</b></h3><p>Learn how to connect your business with customers.</p></a></div></div></section>
 <section class="client-story section-space"><div><p class="eyebrow">Real people. Real initiative.</p><h2>From a shared passion<br/>to a growing business.</h2><p class="serif-copy">Crypt Music’s founders came to AMI for help turning their DJ collective into a business. Together, we worked on pricing, cost analysis, and marketing. Their story reports growth in bookings, revenue, and their audience.</p><a class="text-link" href="/single-post/crypt-music-how-local-friends-converted-their-hobby-into-a-business-ami-success-story">Meet Crypt Music ↗</a></div><img src="/media/760f7c_1d1df47aa9d74eea9f9429c30b2d4490.png" alt="Crypt Music and the AMI team" loading="lazy"/></section>
 <section class="quote-section section-space"><p class="eyebrow">From our community</p><blockquote>“This is an outstanding resource for startups, I wish I would have found out about AMI earlier.”</blockquote><div><span>Clayton Pinkins<br/><small>Business education participant</small></span><a class="text-link" href="/client-testimonials">More client experiences ↗</a></div></section>
 <div class="partner-heading"><p class="eyebrow">Stronger, together.</p><h2>Our community partners.</h2></div>
 <MotionBanner label="Community partners" variant="partners">{partners.map(partner=><a href={partner.href} target="_blank" rel="noopener"><img src={partner.image} alt={partner.name} loading="lazy"/></a>)}</MotionBanner>
 <HomeBooking />
 <ScrollMotion />
 <section class="closing"><p class="eyebrow">Your ambition belongs here.</p><h2>Take the <span>Initiative.</span></h2><div><p>Let’s put your next chapter in motion.</p></div></section>
</Base>
<style>
.partner-heading{padding:55px 4.2vw 28px}.partner-heading h2{font:500 clamp(28px,4vw,52px)/1.1 Helvetica,Arial,sans-serif;letter-spacing:-.04em;margin-top:15px}

.client-story{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.client-story h2{margin:25px 0}.client-story .text-link{margin-top:25px}.client-story>img{width:100%;height:460px;object-fit:cover;filter:grayscale(1)}@media(max-width:700px){.client-story{grid-template-columns:1fr;gap:30px}.client-story>img{height:350px}}

.proof-strip :global(.count-up){font:700 clamp(42px,4vw,64px)/1 Helvetica,Arial,sans-serif;letter-spacing:-.04em}.proof-strip small{font:10px/1.5 Helvetica,Arial,sans-serif;color:#777}.proof-strip>div:first-child{border-left:0;padding-left:0}@media(max-width:600px){.proof-strip :global(.count-up){font-size:44px}.proof-strip small{font-size:9px}}

.opening-bottom .action.light{background:var(--green);color:#111}@media(max-width:900px){.service-grid{grid-template-columns:1fr!important}}

.partner-strip{padding:50px 4.2vw;display:flex;align-items:center;gap:70px}.partner-strip>p{flex:0 0 220px}.partner-strip>div{display:flex;align-items:center;justify-content:space-between;gap:35px;width:100%}.partner-strip img{width:140px;height:70px;object-fit:contain;filter:grayscale(1)}@media(max-width:800px){.partner-strip{padding:40px 22px;flex-direction:column;align-items:start;gap:25px}.partner-strip>p{flex:auto}.partner-strip>div{display:grid;grid-template-columns:1fr 1fr;gap:25px}.partner-strip img{width:120px;height:60px}}

.opening{display:grid;grid-template-columns:1.15fr 1fr;background:#111;color:#fff;min-height:420px}.opening-copy{padding:56px 4.2vw 60px;display:flex;flex-direction:column}.eyebrow{font:11px Helvetica,Arial,sans-serif;text-transform:uppercase;letter-spacing:.12em;line-height:1.6}.opening h1{font-size:clamp(46px,4.4vw,72px);line-height:.99;letter-spacing:-.065em;margin:0 0 24px;font-weight:700}.opening h2{font-size:clamp(26px,2.5vw,38px);margin:0 0 12px}.opening .serif-copy{color:#ccc;font-size:16px;max-width:430px;margin:0}.opening h1 span{color:var(--green)}.opening-bottom{margin-top:auto;padding-top:32px}.action{display:inline-flex;align-items:center;justify-content:space-between;gap:35px;text-decoration:none;padding:17px 21px;font:13px Helvetica,Arial,sans-serif;transition:background .2s,transform .2s}.action span{font-size:22px;line-height:1}.action:hover{transform:translateY(-3px)}.action.compact{padding:16px 22px;font-size:13px;gap:20px;background:transparent;color:#fff;border:1px solid rgba(255,255,255,.45)}.action.compact:hover{background:rgba(255,255,255,.08)}.action.dark{background:#111;color:white}.opening-visual{position:relative;min-width:0;overflow:hidden}.opening-visual>img{width:100%;height:100%;object-fit:cover;object-position:45% center;filter:grayscale(1);position:absolute}.opening-visual:after{content:'';position:absolute;inset:0;background:linear-gradient(transparent 65%,#0008);pointer-events:none}.photo-note{position:absolute;bottom:22px;left:25px;right:25px;display:flex;justify-content:space-between;font:9px Helvetica,Arial,sans-serif;letter-spacing:.06em;z-index:1}.proof-strip{display:grid;grid-template-columns:repeat(5,1fr);padding:30px 3vw;border-bottom:1px solid #ccc;gap:14px;align-items:center}.proof-strip>p{font:20px/1.2 Georgia,serif}.proof-strip>p strong{font-weight:400;color:#555}.proof-strip>div{border-left:1px solid #ccc;padding-left:16px;display:grid;gap:7px}.proof-strip strong{font:700 clamp(56px,5vw,76px)/1 Helvetica,Arial,sans-serif;letter-spacing:-.04em}.proof-strip span{font:14px Helvetica,Arial,sans-serif;color:#555}.section-space{padding:100px 4.2vw}h2{font:500 clamp(37px,4.3vw,66px)/1.05 Helvetica,Arial,sans-serif;letter-spacing:-.045em}.serif-copy{font:18px/1.65 Georgia,serif;color:#555;max-width:590px}.text-link{font:13px/1.5 Helvetica,Arial,sans-serif;display:inline-flex;gap:35px;text-decoration:none;border-bottom:1px solid #999;padding-bottom:8px}.text-link:hover{color:#39732b}.support-section{background:#f2f2f2}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:48px}.section-heading .eyebrow{margin-bottom:24px}.section-heading>.serif-copy{font-size:16px}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #bcbcbc;border-left:1px solid #bcbcbc}.service-card{padding:32px;min-height:355px;display:flex;flex-direction:column;text-decoration:none;border-bottom:1px solid #bcbcbc;border-right:1px solid #bcbcbc;transition:background .2s}.service-card:first-child{background:var(--green)}.service-card:hover{background:#e0e0e0}.service-card:first-child:hover{background:#6cc154}.card-top{display:flex;justify-content:space-between;font:11px Helvetica,Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}.service-card h3{font:500 clamp(25px,2.2vw,34px)/1.1 Helvetica,Arial,sans-serif;letter-spacing:-.04em;margin:36px 0 20px}.service-card h3 span{display:block}.service-card>p{font:16px/1.55 Georgia,serif;max-width:390px}.card-link{margin-top:auto;padding-top:34px;display:flex;justify-content:space-between;align-items:center;font:12px Helvetica,Arial,sans-serif}.card-link span{font-size:25px}.community-section{display:grid;grid-template-columns:1fr 1fr;background:#111;color:white}.community-image{position:relative;min-height:560px}.community-image img{position:absolute;width:100%;height:100%;object-fit:cover;filter:grayscale(1)}.image-label{position:absolute;bottom:25px;left:25px;padding:12px 16px;background:#fff;color:black;font:12px Helvetica,Arial,sans-serif}.community-copy{padding:75px 8%}.community-copy h2{margin:42px 0 28px}.community-copy .serif-copy{color:#ccc;margin-bottom:30px}.community-copy .action{border:1px solid #777}.learning-grid{display:block}.resource-links{display:grid;grid-template-columns:repeat(3,1fr);gap:45px}.resource-links a{display:block;text-decoration:none;border-top:1px solid #ccc;padding:25px 0 30px}.resource-links a>span{font:10px Helvetica,Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em;color:#555}.resource-links h3{font:24px/1.2 Helvetica,Arial,sans-serif;letter-spacing:-.035em;margin:16px 0 10px}.resource-links h3 b{float:right;font-weight:400}.resource-links p{font:15px/1.55 Georgia,serif;color:#555}.resource-links a:hover h3{color:#39732b}.quote-section{background:#f2f2f2}.quote-section blockquote{font:clamp(26px,3.4vw,49px)/1.25 Georgia,serif;letter-spacing:-.025em;max-width:1060px;margin:42px 0}.quote-section>div{display:flex;justify-content:space-between;gap:30px;font:13px/1.6 Helvetica,Arial,sans-serif}.quote-section small{color:#666}.closing{background:var(--green);padding:52px 4.2vw}.closing h2{font-size:clamp(30px,7vw,88px);font-weight:700;letter-spacing:-.06em;margin:14px 0 18px;line-height:1}.closing h2 span{color:white}.closing>div{display:flex;align-items:center;justify-content:space-between;gap:25px}.closing>div>p{font:20px Georgia,serif}
@media(min-width:1700px){.opening{min-height:560px}.opening-copy{padding-left:max(4.2vw,calc((100vw - 1600px)/2))}}
@media(max-width:900px){.opening{grid-template-columns:1fr 1fr}.opening h1{font-size:52px}.opening-copy{padding:44px 25px}.photo-note{flex-direction:column;gap:8px}.proof-strip{grid-template-columns:1fr 1fr;gap:30px}.proof-strip>div{padding-left:20px}.section-space{padding:70px 25px}.section-heading{align-items:start}.community-copy{padding:55px 25px}.community-image{min-height:510px}}
@media(max-width:600px){.opening{grid-template-columns:1fr}.opening-copy{padding:40px 22px 44px}.opening h1{font-size:clamp(44px,11.5vw,68px);margin:0 0 20px}.opening-visual{min-height:400px}.opening-visual>img{object-position:center 42%}.photo-note{flex-direction:row}.proof-strip{padding:30px 22px;gap:30px 15px}.proof-strip strong{font-size:32px}.proof-strip span{font-size:12px;line-height:1.5}.proof-strip>p{font-size:19px}.proof-strip>div{padding-left:14px}.section-space{padding:60px 22px}.section-heading{flex-direction:column;gap:25px;margin-bottom:32px}.serif-copy{font-size:17px}.service-grid,.community-section{grid-template-columns:1fr}.resource-links{grid-template-columns:1fr;gap:0}.service-card{padding:26px;min-height:340px}.service-card h3{font-size:32px}.community-image{min-height:380px}.community-copy{padding:50px 22px}.community-copy h2{margin-top:30px}.quote-section>div{flex-direction:column}.closing{padding:44px 22px}.closing>div{align-items:start;flex-direction:column}.closing>div>p{font-size:18px}.closing h2{font-size:8.2vw}}

.opening-bottom{display:flex;align-items:center;gap:24px;flex-wrap:wrap}.primary-book{background:var(--green);color:#111;padding:19px 24px}.primary-book:hover{background:#79c763}.explore-link{font:13px/1.6 Helvetica,Arial,sans-serif;text-underline-offset:6px}.opening-copy{padding-top:64px;padding-bottom:64px}.opening h1{font-size:clamp(52px,5.2vw,88px)}.community-image{overflow:hidden}
.service-grid{display:block;border:0}.service-card,.service-card:first-child{display:grid;grid-template-columns:.6fr 1.3fr 1fr;gap:36px;align-items:center;background:transparent;min-height:0;border:0;border-top:1px solid #aaa;padding:38px 0;transition:background .25s}.service-card:last-child{border-bottom:1px solid #aaa}.service-card:hover,.service-card:first-child:hover{background:#e8e8e4}.card-top{flex-direction:column-reverse;gap:14px}.card-top>span:last-child{font-size:34px;color:#777;letter-spacing:-.05em}.service-card h3{font-size:clamp(28px,3vw,46px);margin:0}.service-card>p{font-size:17px}.card-link{grid-column:2/4;padding-top:0;margin-top:0;justify-content:start;gap:24px}.service-card:first-child h3{color:#111}@media(max-width:700px){.opening-copy{padding:42px 22px}.service-card,.service-card:first-child{grid-template-columns:1fr;gap:22px;padding:32px 0}.card-top{flex-direction:row;align-items:center}.card-link{grid-column:auto}.service-card h3{font-size:34px}}
</style>
