---
const topics=[
 ['Pricing strategy','Find the right price.',12,18],['Financial modeling','Know your numbers.',36,12],['Brand development','Make your mark.',64,12],['Market research','Find your opportunity.',88,18],
 ['Customer acquisition','Reach your people.',12,43],['Business planning','Put ideas into motion.',88,43],['Supplier analysis','Build better connections.',12,68],['Digital presence','Show up online.',88,68],
 ['Cash flow','Plan what comes next.',12,89],['Operations','Make the everyday work.',36,90],['Growth strategy','Choose your next move.',64,90],['Technology','Find tools that fit.',88,89]
];
---
<section class="expertise-network" id="expertise" aria-labelledby="expertise-heading">
 <div class="network-stage">
  <div class="network-center"><p class="eyebrow">Our expertise / Your next move</p><h2 id="expertise-heading">A big question?<br/><em>Bring it.</em></h2><p>Fresh eyes. Practical skills. A team ready to work through your next business challenge.</p><a href="#schedule">Let’s figure it out together <span aria-hidden="true">↗</span></a></div>
  <ul class="network-topics">{topics.map(([title,text,x,y],i)=><li class={`topic topic-${i%4}`} style={`--x:${x}%;--y:${y}%;--tilt:${i%2?4:-5}deg`} data-x={x} data-y={y} data-index={i}><span class="topic-index"><b aria-hidden="true">{['↗','✳','↔','+'][i%4]}</b></span><h3>{title}</h3><p>{text}</p></li>)}</ul>
 </div>
</section>
<section class="expertise-more"><p class="eyebrow">And the questions in between.</p><p>Competitor analysis. Market entry. Revenue models. Business restructuring. Customer retention. Business model canvases.</p><a href="#schedule">Not sure where to start? Start with a conversation. ↗</a></section>
<style>
.expertise-network{background:#111;color:#fff;position:relative}.network-stage{padding:70px 4.2vw}.network-center{max-width:650px;margin:0 auto 60px;text-align:center}.eyebrow{font:11px/1.5 Helvetica,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}.network-center h2{font:600 clamp(48px,5.8vw,86px)/.98 Helvetica,Arial,sans-serif;letter-spacing:-.06em;margin:26px 0}.network-center h2 em{font:italic 400 1.08em/1 Georgia,serif;color:var(--green)}.network-center>p:not(.eyebrow){font:18px/1.55 Georgia,serif;max-width:370px;margin:0 auto;color:#ccc}.network-center a{display:inline-block;margin-top:25px;padding:10px 0;border-bottom:1px solid #aaa;color:white;font:14px/1.4 Helvetica,Arial,sans-serif;text-decoration:none}.network-center a span{margin-left:16px}.network-topics{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;list-style:none;margin:0;padding:0}.topic{padding:20px 24px;background:#eee;color:#111;min-width:0}.topic h3{font:500 20px/1.1 Helvetica,Arial,sans-serif;letter-spacing:-.03em;margin:14px 0 7px}.topic p{font:13px/1.35 Georgia,serif;margin:0}.topic-index{font:10px/1 Helvetica,Arial,sans-serif;display:flex;align-items:center;justify-content:flex-end}.topic-index b{font-size:24px;font-weight:400}.topic-1{background:var(--green);border-radius:50% 50% 8px 8px;padding-top:23px;text-align:center}.topic-2{background:#111;color:white;border:1px solid #777;border-radius:60px}.topic-3{background:#dedbcf;border-radius:2px 28px 2px 2px}.expertise-more{padding:65px 8vw 80px;background:#eee}.expertise-more>p:nth-child(2){font:400 clamp(25px,3vw,43px)/1.35 Helvetica,Arial,sans-serif;letter-spacing:-.035em;max-width:1050px;margin:25px 0 30px}.expertise-more a{font:15px/1.6 Helvetica,Arial,sans-serif;text-underline-offset:7px}
.expertise-network.is-animated{height:260vh}.is-animated .network-stage{position:sticky;top:var(--header-height);height:calc(100vh - var(--header-height));min-height:650px;padding:0;overflow:hidden;perspective:1200px}.is-animated .network-center{position:absolute;left:50%;top:48%;width:42%;margin:0;transform:translate(-50%,-50%);z-index:2}.is-animated .network-center h2{font-size:clamp(48px,5.8vw,86px)}.is-animated .network-topics{display:contents}.is-animated .topic{position:absolute;left:var(--x);top:var(--y);width:18%;max-width:240px;min-height:115px;will-change:transform;transform:translate(-50%,-50%) rotate(var(--tilt))}.is-animated .topic h3{font-size:clamp(16px,1.5vw,23px)}.is-animated .topic p{font-size:12px}.is-animated .topic-index{font-size:9px}.is-animated .topic-index b{font-size:22px}
@media(max-width:900px){.network-topics{grid-template-columns:repeat(2,1fr)}.topic{padding:22px 18px}.topic:nth-child(odd){transform:rotate(-2deg)}.topic:nth-child(even){transform:rotate(2deg)}.network-stage{padding:60px 22px}.network-center{margin-bottom:45px}.expertise-more{padding:50px 22px}.topic h3{font-size:19px}}
@media(prefers-reduced-motion:reduce){.topic{transform:none!important}}
</style>
<script>
 const network=document.querySelector<HTMLElement>('.expertise-network');
 if(network){
  const topics=[...network.querySelectorAll<HTMLElement>('.topic')];const reduce=matchMedia('(prefers-reduced-motion: reduce)');let frame=0;
  const update=()=>{frame=0;const animated=innerWidth>=1050&&innerHeight>=780&&!reduce.matches;network.classList.toggle('is-animated',animated);if(!animated){topics.forEach(t=>t.style.removeProperty('transform'));return;}
   const r=network.getBoundingClientRect();const header=parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height'))||80;
   const progress=Math.max(0,Math.min(1,(header-r.top)/(r.height-innerHeight+header)));
   topics.forEach(t=>{const i=Number(t.dataset.index);const x=Number(t.dataset.x);const y=Number(t.dataset.y);const start=(i%4)*.055;const q=Math.max(0,Math.min(1,(progress-start)/.66));const ease=1-Math.pow(1-q,3);const distance=1-ease;const dx=(x-50)*innerWidth*.035*distance;const dy=(y-50)*innerHeight*.035*distance;const rotation=(i%2?1:-1)*(65*distance+4);t.style.transform=`translate(-50%,-50%) translate3d(${dx}px,${dy}px,${-700*distance}px) rotate(${rotation}deg) scale(${.35+.65*ease})`;});
  };
  const queue=()=>{if(!frame)frame=requestAnimationFrame(update)};addEventListener('scroll',queue,{passive:true});addEventListener('resize',queue);reduce.addEventListener('change',queue);update();
 }
</script>
