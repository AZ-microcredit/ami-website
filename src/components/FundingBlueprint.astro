---
import Icon from './Icon.astro';
---
<section class="funding-blueprint" id="put-capital-to-work" aria-labelledby="blueprint-title">
 <div class="blueprint-stage">
  <header><p class="kicker">From investment to action</p><h2 id="blueprint-title">Make your <br/>next move <br/><em>tangible.</em></h2><p>Start with what your business needs. Connect it to what you want to build.</p><a href="#schedule">Talk through your investment <Icon name="arrow-up-right" /></a></header>
  <div class="blueprint-board">
   <div class="board-grid" aria-hidden="true"></div>
   <div class="board-heading"><span>YOUR NEXT CHAPTER</span><span>IDEA <Icon name="arrow-right" /> PLAN <Icon name="arrow-right" /> ACTION</span></div>
   <div class="blueprint-drawing" aria-hidden="true"><svg viewBox="0 0 600 340" fill="none"><g class="draw-lines" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"><path pathLength="1" d="M95 280V126H505V280H95M115 72H485L505 126H95L115 72ZM125 126V280M475 126V280M160 280V178H270V280M316 178H438V244H316V178M250 225V242M316 211H438M377 178V244"/><path pathLength="1" d="M95 126V140Q120 162 146 140Q171 162 197 140Q222 162 248 140Q274 162 300 140Q326 162 352 140Q378 162 403 140Q429 162 454 140Q480 162 505 140V126M75 282H525M285 280H465"/></g><text x="300" y="108" text-anchor="middle">YOUR NEXT CHAPTER</text></svg></div>
   <div class="blueprint-notes"><article><span><Icon name="arrow-up-right" /></span><h3>The right equipment.</h3><p>Tools that help you serve your customers.</p></article><article><span>+</span><h3>Ready for demand.</h3><p>Inventory and supplies for your next stage.</p></article><article><span><Icon name="arrow-right" /></span><h3>A clear plan.</h3><p>An investment with a goal and a repayment plan.</p></article></div>
   <p class="board-footnote">Every business looks different. Let’s talk about yours.</p>
  </div>
 </div>
</section>
<style>
.funding-blueprint{background:#ecece5;color:#111}.blueprint-stage{padding:70px 5vw;display:grid;grid-template-columns:.8fr 1.4fr;align-items:center;gap:6vw;overflow:hidden}.kicker,.board-heading,.board-footnote{font:10px/1.5 'AMI Sans',sans-serif;letter-spacing:.09em;text-transform:uppercase}.blueprint-stage h2{font:500 clamp(45px,5.5vw,84px)/.97 'AMI Sans',sans-serif;letter-spacing:-.06em;margin:28px 0}.blueprint-stage h2 em{font:italic 400 1em 'AMI Serif',serif;color:#39732b}.blueprint-stage header>p:not(.kicker){font:18px/1.6 'AMI Serif',serif;max-width:320px}.blueprint-stage header>a{display:inline-block;margin-top:30px;padding-bottom:10px;border-bottom:1px solid;font:14px/1.5 'AMI Sans',sans-serif;text-decoration:none}.blueprint-board{position:relative;border:1px solid #8b9a82;background:#f7f8ef;padding:32px;isolation:isolate;transform-origin:center}.board-grid{position:absolute;inset:0;background-image:linear-gradient(#39732b0c 1px,transparent 1px),linear-gradient(90deg,#39732b0c 1px,transparent 1px);background-size:24px 24px;z-index:-1}.board-heading{display:flex;justify-content:space-between;gap:20px;color:#39732b}.blueprint-drawing{color:#39732b;margin:28px auto 20px;max-width:600px}.blueprint-drawing svg{width:100%;display:block}.blueprint-drawing text{font:13px 'AMI Sans',sans-serif;letter-spacing:3px;fill:currentColor}.blueprint-notes{display:flex;gap:22px}.blueprint-notes article{flex:1;min-width:0;border-top:1px solid #8b9a82;padding-top:20px;display:grid;grid-template-rows:32px 48px auto;align-content:start;row-gap:12px}.blueprint-notes article>span{font:27px 'AMI Sans',sans-serif;color:#39732b}.blueprint-notes h3{font:500 20px/1.1 'AMI Sans',sans-serif;letter-spacing:-.03em;margin:0}.blueprint-notes p{font:14px/1.6 'AMI Serif',serif;margin:0}.board-footnote{font-size:9px;margin-top:28px;letter-spacing:.03em;color:#52624d;border-top:1px solid #8b9a8244;padding-top:20px}.funding-blueprint.is-drawing{height:165vh}.is-drawing .blueprint-stage{position:sticky;top:var(--header-height);height:calc(100vh - var(--header-height));padding-top:40px;padding-bottom:40px}.is-drawing .draw-lines path{stroke-dasharray:1;stroke-dashoffset:calc(1 - var(--draw,1))}.is-drawing .blueprint-board{transform:perspective(1500px) rotateY(calc((1 - var(--draw,1))*-22deg)) rotate(calc((1 - var(--draw,1))*4deg))}.is-drawing .blueprint-notes article{transform:translateY(calc((1 - var(--draw,1))*80px));opacity:calc(.25 + var(--draw,1)*.75)}
@media(max-width:900px){.blueprint-stage{grid-template-columns:1fr;padding:52px 22px;gap:38px}.blueprint-stage h2 br{display:none}.blueprint-stage h2 br:after{content:' '}.blueprint-stage h2{max-width:600px}.blueprint-stage header>p:not(.kicker){max-width:500px}.blueprint-board{padding:22px}.blueprint-notes{flex-direction:column;gap:20px}.blueprint-notes article{display:grid;grid-template-columns:32px 1fr;grid-template-rows:auto auto;column-gap:12px}.blueprint-notes h3{margin:0}.blueprint-notes p{grid-column:2;margin-top:6px}.board-heading{font-size:8px}}
</style>
<script>
 const blueprint=document.querySelector<HTMLElement>('.funding-blueprint');
 if(blueprint){const reduce=matchMedia('(prefers-reduced-motion: reduce)');let frame=0;const update=()=>{frame=0;const active=innerWidth>=1050&&innerHeight>=800&&!reduce.matches;blueprint.classList.toggle('is-drawing',active);if(!active){blueprint.style.setProperty('--draw','1');return;}const r=blueprint.getBoundingClientRect();const top=parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height'))||72;const p=Math.max(0,Math.min(1,(top-r.top)/(r.height-innerHeight+top)*1.35));blueprint.style.setProperty('--draw',String(p));};const queue=()=>{if(!frame)frame=requestAnimationFrame(update)};addEventListener('scroll',queue,{passive:true});addEventListener('resize',queue);reduce.addEventListener('change',queue);update();}
</script>
