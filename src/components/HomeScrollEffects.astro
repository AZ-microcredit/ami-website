<div class="scroll-ribbon" aria-hidden="true"><div><span>Small business.</span><em>Big possibility.</em><span>Right here.</span><em>Small business.</em></div></div>
<script>
 const home=document.querySelector<HTMLElement>('.modern-home');
 if(home){
  const reduce=matchMedia('(prefers-reduced-motion: reduce)');let frame=0;
  const sections=[...home.querySelectorAll<HTMLElement>('.support-section,.community-section,.client-story,.quote-section')];
  const ribbon=home.querySelector<HTMLElement>('.scroll-ribbon');
  function update(){frame=0;const disabled=reduce.matches;const compact=innerWidth<700;
   sections.forEach(section=>{const isLanding=section.matches('.opening');const r=(isLanding?section.parentElement!:section).getBoundingClientRect();if(r.bottom < -200||r.top>innerHeight+200)return;const enter=Math.max(0,Math.min(1,(innerHeight-r.top)/(innerHeight*.8)));const pass=Math.max(0,Math.min(1,isLanding?(72-r.top)/Math.max(1,r.height-innerHeight+72):-r.top/Math.max(1,r.height)));const centered=Math.max(-1,Math.min(1,(innerHeight/2-r.top-r.height/2)/innerHeight));section.style.setProperty('--enter',disabled?'1':String(enter));section.style.setProperty('--pass',disabled?'0':String(pass));section.style.setProperty('--depth',disabled?'0':String(centered*(compact?.35:1)));});
   if(ribbon){const r=ribbon.getBoundingClientRect();ribbon.style.setProperty('--ribbon',disabled?'0px':`${(innerHeight-r.top)*-.18}px`)}
  }
  const queue=()=>{if(!frame)frame=requestAnimationFrame(update)};addEventListener('scroll',queue,{passive:true});addEventListener('resize',queue);reduce.addEventListener('change',queue);home.classList.add('scroll-effects');update();
 }
</script>
<style is:global>
.modern-home{overflow:clip}.scroll-ribbon{overflow:hidden;background:var(--green);padding:30px 0}.scroll-ribbon>div{display:flex;gap:55px;white-space:nowrap;width:max-content;transform:translate3d(var(--ribbon,0px),0,0);font:500 clamp(38px,6vw,86px)/1.1 Helvetica,Arial,sans-serif;letter-spacing:-.05em}.scroll-ribbon em{font-family:Georgia,serif;font-weight:400;color:white}
.scroll-effects .opening{--pass:0;--depth:0}.scroll-effects .opening h1{transform:translate3d(0,calc(var(--pass)*85px),0);opacity:calc(1 - var(--pass)*.45)}.scroll-effects .opening h2,.scroll-effects .opening .serif-copy{transform:translate3d(0,calc(var(--pass)*35px),0)}.scroll-effects .opening-visual{clip-path:inset(calc(var(--pass)*5%) calc(var(--pass)*3%) 0 0)}
.scroll-effects .support-section{--enter:1;--depth:0}.scroll-effects .support-section .section-heading h2{transform:translate3d(calc((1 - var(--enter))*-65px),0,0)}.scroll-effects .service-card{position:relative}.scroll-effects .service-card:nth-child(2){transform:translate3d(calc(var(--depth)*35px),0,0)}.scroll-effects .service-card:nth-child(3){transform:translate3d(calc(var(--depth)*-35px),0,0)}
.scroll-effects .community-section{--depth:0}.scroll-effects .community-copy{transform:translate3d(0,calc(var(--depth)*-65px),0)}.scroll-effects .community-image .image-label{transform:translate3d(calc(var(--depth)*85px),calc(var(--depth)*-30px),0)}
.scroll-effects .client-story{--depth:0;--enter:1}.scroll-effects .client-story>img{transform:translate3d(0,calc(var(--depth)*-100px),0) rotate(calc(var(--depth)*-4deg));clip-path:inset(calc((1 - var(--enter))*12%) 0 0 0)}.scroll-effects .client-story>div{transform:translate3d(0,calc(var(--depth)*40px),0)}
.scroll-effects .quote-section{--enter:1;--depth:0;position:relative;isolation:isolate;overflow:hidden}.scroll-effects .quote-section:before{content:'“';position:absolute;right:3%;top:-25%;font:600 clamp(300px,45vw,650px)/1 Georgia,serif;color:#ddd;z-index:-1;transform:translate3d(0,calc(var(--depth)*130px),0)}.scroll-effects .quote-section blockquote{transform:translate3d(0,calc((1 - var(--enter))*65px),0);opacity:calc(.35 + var(--enter)*.65)}
@media(max-width:699px){.scroll-effects .opening h1,.scroll-effects .opening h2,.scroll-effects .opening .serif-copy{transform:none;opacity:1}.scroll-effects .opening-visual{clip-path:none}.scroll-effects .service-card:nth-child(2),.scroll-effects .service-card:nth-child(3){transform:none}.scroll-ribbon{padding:24px 0}.scroll-ribbon>div{gap:30px}.scroll-effects .client-story>img{transform:translate3d(0,calc(var(--depth)*-45px),0)} }
@media(prefers-reduced-motion:reduce){.scroll-effects .opening h1,.scroll-effects .opening h2,.scroll-effects .opening .serif-copy,.scroll-effects .support-section .section-heading h2,.scroll-effects .service-card,.scroll-effects .community-copy,.scroll-effects .community-image .image-label,.scroll-effects .client-story>img,.scroll-effects .client-story>div,.scroll-effects .quote-section:before,.scroll-effects .quote-section blockquote,.scroll-ribbon>div{transform:none!important;opacity:1!important;clip-path:none!important}.scroll-effects .opening-visual{clip-path:none}}

</style>
