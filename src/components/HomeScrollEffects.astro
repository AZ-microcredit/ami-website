---
import MotionBanner from './MotionBanner.astro';
---
<MotionBanner label="Small business, big possibility"><span>Small business.</span><em>Big possibility.</em><span>Right here.</span></MotionBanner>
<script>
 import { createScrollScene, reducedMotion, viewportHeight } from '../scripts/motion/engine';
 const home=document.querySelector<HTMLElement>('.modern-home');
 if(home){
  const sections=[...home.querySelectorAll<HTMLElement>('.support-section,.client-story,.quote-section')];
  let depthScale=1;
  createScrollScene({
   root:home,
   margin:240,
   measure:()=>{
    // Continuous compression instead of a binary compact switch: drift scales
    // with the room the layout actually has, never a fixed width gate.
    depthScale=Math.max(0.3,Math.min(1,(window.innerWidth-520)/700));
   },
   render:()=>{
    const vh=viewportHeight();const disabled=reducedMotion();
    sections.forEach(section=>{
     const r=section.getBoundingClientRect();if(r.bottom<-200||r.top>vh+200)return;
     const enter=Math.max(0,Math.min(1,(vh-r.top)/(vh*.8)));
     const pass=Math.max(0,Math.min(1,-r.top/Math.max(1,r.height)));
     const centered=Math.max(-1,Math.min(1,(vh/2-r.top-r.height/2)/vh));
     section.style.setProperty('--enter',disabled?'1':String(enter));
     section.style.setProperty('--pass',disabled?'0':String(pass));
     section.style.setProperty('--depth',disabled?'0':String(centered*depthScale));
    });
   },
  });
  home.classList.add('scroll-effects');
 }
</script>
<style is:global>
.modern-home{overflow:clip}
.scroll-effects .support-section{--enter:1;--depth:0}.scroll-effects .support-section .section-heading h2{transform:translate3d(calc((1 - var(--enter))*-65px),0,0)}.scroll-effects .service-card{position:relative}.scroll-effects .service-card:nth-child(2){transform:translate3d(calc(var(--depth)*35px),0,0)}.scroll-effects .service-card:nth-child(3){transform:translate3d(calc(var(--depth)*-35px),0,0)}
.scroll-effects .client-story{--depth:0;--enter:1}.scroll-effects .client-story>img{transform:translate3d(0,calc(var(--depth)*-100px),0) rotate(calc(var(--depth)*-4deg));clip-path:inset(calc((1 - var(--enter))*12%) 0 0 0)}.scroll-effects .client-story>div{transform:translate3d(0,calc(var(--depth)*40px),0)}
.scroll-effects .quote-section{--enter:1;--depth:0;position:relative;isolation:isolate;overflow:hidden}.scroll-effects .quote-section:before{content:'“';position:absolute;right:3%;top:-25%;font:600 clamp(300px,45vw,650px)/1 'AMI Serif',serif;color:#ddd;z-index:-1;transform:translate3d(0,calc(var(--depth)*130px),0)}.scroll-effects .quote-section blockquote{transform:translate3d(0,calc((1 - var(--enter))*65px),0);opacity:calc(.35 + var(--enter)*.65)}
@media(max-width:699px){.scroll-effects .client-story>img{transform:translate3d(0,calc(var(--depth)*-45px),0)}}
@media(prefers-reduced-motion:reduce){.scroll-effects .support-section .section-heading h2,.scroll-effects .service-card,.scroll-effects .client-story>img,.scroll-effects .client-story>div,.scroll-effects .quote-section:before,.scroll-effects .quote-section blockquote{transform:none!important;opacity:1!important;clip-path:none!important}}
</style>
